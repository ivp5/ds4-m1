// llms HPF5 (make_hpf5_source.py): the OR dequant in every Q4 GEMM body
// dense_llms2t_b_over_dense_llms2s_over_dense_llms2r_mvb_q4l_rbf_dual_k_h2_off32k_fold.metal -- generated by make_fold_source.py from the bias fold (24 decode lines, 7 accumulations, 6 nxs seeds)
// DS4 Metal matvec kernels used by generation.

// ---- llms Q4S8 v3 (make_q4s8e_source.py): Q4L group scales as one byte, an E4M3-style code decoded by bits -- sign | 4 exponent bits | 3 mantissa bits, value = as_type<half>(((k & 0x80) << 8) | ((k & 0x7F) << 7)) * 4 (exact: a power-of-two scale); no table ----
static inline half llms_q4s_dec(uchar k) { return as_type<half>((ushort)(((ushort)(k & 0x80u) << 8) | ((ushort)(k & 0x7Fu) << 7))) * 4.0h; }
struct llms_q4s { device const uchar * p; half operator[](int i) const { return llms_q4s_dec(p[i]); } };

