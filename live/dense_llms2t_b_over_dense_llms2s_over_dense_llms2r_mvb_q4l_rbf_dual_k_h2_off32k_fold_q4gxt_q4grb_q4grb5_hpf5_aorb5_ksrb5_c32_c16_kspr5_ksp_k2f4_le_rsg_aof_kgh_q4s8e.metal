// ---- llms Q4GS_KSA (gs): the GROUPED, STRIDED GEMM (kernel_llms_q4g64s: o_a as 8 groups of 4096 -> 1024, o_b as one 8192 ->
// 5120) as an atomic one-dispatch K-split with the token tile bounded by C (NT = ceil(C / 8)): grid (R / 64 tiles, S splits, groups); split s
// sums 32-blocks [nb s / S, nb (s + 1) / S); partials part[((g S + s) C + c) R + r] (coherent(device): the 15:1x fix); the last split of each
// (group, tile) to arrive reduces into dst[c ds + g R + r] with the original's bf16 rounding. Same Q4L row layout as q4g64s.
struct llms_q4gs_ks_args { int K; int R; int C; int rb; int S; int xs; int xg; int ds; ulong wg; };
template<int NT>
static inline void llms_q4gs_ksa_impl(constant llms_q4gs_ks_args & a, device const char * src0, device const float * x0, device float * dst0,
        device coherent(device) float * part, device atomic_uint * cnt, threadgroup float * sh, uint3 tg, ushort tid, ushort sg) {
    const int K = a.K, nb = K / 32, r0 = (int)tg.x * 64, C = a.C, S = a.S, s = (int)tg.y, g = (int)tg.z; const ulong rowb = (ulong)K / 2 + (ulong)nb * 1;
    device const char * src = src0 + (ulong)g * a.wg; device const float * x = x0 + (ulong)g * (ulong)a.xg; device float * dst = dst0 + (ulong)g * (ulong)a.R;
    const int b0 = (int)((long)nb * s / S), b1 = (int)((long)nb * (s + 1) / S);
    threadgroup float * Ws = sh;            // [64 rows][32 k]
    threadgroup float * Xs = sh + 64 * 32;  // [NT * 8 tokens][32 k]
    simdgroup_float8x8 acc[NT];
    for (int t = 0; t < NT; t++) acc[t] = simdgroup_float8x8(0.f);
    const int wr = tid >> 2, wl = tid & 3;
    device const char * rp = src + (ulong)min(r0 + wr, a.R - 1) * rowb;
    device const uint * wq = (device const uint *)rp; const llms_q4s ws = llms_q4s{(device const uchar *)(rp + K / 2)};
    for (int b = b0; b < b1; b++) {
        { const uint w = wq[b * 4 + wl]; const float sc = (float)ws[b];
          threadgroup float * o = Ws + wr * 32 + wl * 8;
          for (int j = 0; j < 4; j++) { o[2 * j] = ((float)(int)((w >> (8 * j)) & 15u) - 8.f) * sc; o[2 * j + 1] = ((float)(int)((w >> (8 * j + 4)) & 15u) - 8.f) * sc; } }
        for (int i = tid; i < 32 * NT * 8; i += 256) { const int c = i >> 5, k = i & 31; Xs[c * 32 + k] = c < C ? x[(ulong)c * (ulong)a.xs + b * 32 + k] : 0.f; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (int kk = 0; kk < 4; kk++) {
            simdgroup_float8x8 Am; simdgroup_load(Am, Ws + sg * 8 * 32 + kk * 8, 32);
            for (int t = 0; t < NT; t++) { simdgroup_float8x8 Bm; simdgroup_load(Bm, Xs + t * 8 * 32 + kk * 8, 32, ulong2(0, 0), true); simdgroup_multiply_accumulate(acc[t], Am, Bm, acc[t]); }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    for (int t = 0; t < NT; t++) simdgroup_store(acc[t], sh + (t * 8) * 64 + sg * 8, 64, ulong2(0, 0), true);   // sh[token][row]
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (S == 1) {   // no split: the token-bounded tile writes dst directly (no partials, no counter)
        for (int i = tid; i < NT * 8 * 64; i += 256) {
            const int c = i >> 6, r = i & 63;
            if (c < C && r0 + r < a.R) { float v = sh[c * 64 + r];
                if (a.rb & 1) { uint bits = as_type<uint>(v); if ((bits & 0x7f800000u) != 0x7f800000u) bits += 0x7fffu + ((bits >> 16u) & 1u); v = as_type<float>(bits & 0xffff0000u); }
                dst[(ulong)c * (ulong)a.ds + r0 + r] = v; }
        }
        return;
    }
    for (int i = tid; i < NT * 8 * 64; i += 256) {
        const int c = i >> 6, r = i & 63;
        if (c < C && r0 + r < a.R) part[(((ulong)g * S + s) * C + c) * a.R + r0 + r] = sh[c * 64 + r];
    }
    threadgroup_barrier(mem_flags::mem_device);
    threadgroup uint * last = (threadgroup uint *)(sh + 64 * 64);
    const uint ntiles = ((uint)a.R + 63u) / 64u;
    if (tid == 0) { atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
                    const uint prev = atomic_fetch_add_explicit(cnt + (ulong)g * ntiles + tg.x, 1u, memory_order_relaxed); *last = prev == (uint)(S - 1);
                    if (*last) atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device); }
    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
    if (!*last) return;
    if (tid == 0) atomic_store_explicit(cnt + (ulong)g * ntiles + tg.x, 0u, memory_order_relaxed);
    for (int i = tid; i < NT * 8 * 64; i += 256) {
        const int c = i >> 6, r = i & 63;
        if (c < C && r0 + r < a.R) {
            float v = 0.f; for (int q = 0; q < S - ((a.rb >> 1) & 1); q++) v += part[(((ulong)g * S + q) * C + c) * a.R + r0 + r];   /* rb bit 1: the CANARY */
            if (a.rb & 1) { uint bits = as_type<uint>(v); if ((bits & 0x7f800000u) != 0x7f800000u) bits += 0x7fffu + ((bits >> 16u) & 1u); v = as_type<float>(bits & 0xffff0000u); }
            dst[(ulong)c * (ulong)a.ds + r0 + r] = v;
        }
    }
}
#define LLMS_Q4GS_KSA(NT) \
kernel void kernel_llms_q4g64s_ksa_nt##NT(constant llms_q4gs_ks_args & a [[buffer(0)]], device const char * src0 [[buffer(1)]], device const float * x0 [[buffer(2)]], \
        device float * dst0 [[buffer(3)]], device coherent(device) float * part [[buffer(4)]], device atomic_uint * cnt [[buffer(5)]], threadgroup float * sh [[threadgroup(0)]], \
        uint3 tg [[threadgroup_position_in_grid]], ushort tid [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) { \
    llms_q4gs_ksa_impl<NT>(a, src0, x0, dst0, part, cnt, sh, tg, tid, sg); }
