            for (int t = 0; t < 8; t++) { simdgroup_half8x8 Bm; simdgroup_load(Bm, xt + (ulong)(b * 32 + kk * 8) * 64 + t * 8, 64); simdgroup_multiply_accumulate(acc[t], Am, Bm, acc[t]); }
        }
