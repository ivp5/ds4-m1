/* llms EXT_SGM, 16 tokens (make_dense_t4.py 15:0x): the 32-k form with TWO activation tiles per weight tile -- the output head runs
 * once per 16-token step at n_tok = 16 (9 ms at 72 GB/s through the ext kernel); here each 8 x 32 weight tile is dequantized once
 * and multiplied into two 8 x 8 C tiles (tokens 0-7 and 8-15). K split over the simdgroups; partials summed in a fixed order. */
template<short NSG>
void kernel_llms_mul_mv_q8_sgm32_16_impl(constant ds4_metal_args_mul_mv_ext & args, device const char * src0, device const char * src1, device char * dst,
                                         threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const int nb = args.ne00 / 32;
    const int r0 = tgpig.x * 8;
    threadgroup float * As = (threadgroup float *)shmem + sgitg * 256;                     // [row 8][k 32]
    threadgroup float * Bs = (threadgroup float *)shmem + NSG * 256 + sgitg * 512;         // [k 32][tok 16]
    threadgroup float * Cs = (threadgroup float *)shmem + 3 * NSG * 256;                   // [sg][2][row 8][tok 8]
    simdgroup_float8x8 C0 = make_filled_simdgroup_matrix<float, 8>(0.f), C1 = make_filled_simdgroup_matrix<float, 8>(0.f);
    const short lr = tiisg / 4, lq = tiisg % 4;
    const int rr = (r0 + lr < args.ne01) ? (r0 + lr) : (args.ne01 - 1);
    device const char * xrow = src0 + (uint64_t)rr * args.nb01;
    device const float4 * ya = (device const float4 *)(src1 + (uint64_t)lr * args.nb11) + lq * 2;          // token lr
    device const float4 * yb = (device const float4 *)(src1 + (uint64_t)(lr + 8) * args.nb11) + lq * 2;    // token lr + 8
    threadgroup float4 * as4 = (threadgroup float4 *)(As + lr * 32 + lq * 8);
    threadgroup float * bs = Bs + (lq * 8) * 16 + lr;
    for (int ib = sgitg; ib < nb; ib += NSG) {
        device const char * b = xrow + (uint64_t)ib * 34u;
        const float d = (float)*(device const half *)b;
        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * 8);
        const packed_char4 q0 = q4[0], q1 = q4[1];
        as4[0] = float4(q0) * d; as4[1] = float4(q1) * d;
        const float4 x0 = ya[ib * 8], x1 = ya[ib * 8 + 1], z0 = yb[ib * 8], z1 = yb[ib * 8 + 1];
        bs[0] = x0.x; bs[16] = x0.y; bs[32] = x0.z; bs[48] = x0.w; bs[64] = x1.x; bs[80] = x1.y; bs[96] = x1.z; bs[112] = x1.w;
        bs[8] = z0.x; bs[24] = z0.y; bs[40] = z0.z; bs[56] = z0.w; bs[72] = z1.x; bs[88] = z1.y; bs[104] = z1.z; bs[120] = z1.w;
        simdgroup_barrier(mem_flags::mem_threadgroup);
        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
            simdgroup_float8x8 A, B0, B1;
            simdgroup_load(A, As + kt * 8, 32);
            simdgroup_load(B0, Bs + kt * 128, 16);
            simdgroup_load(B1, Bs + kt * 128 + 8, 16);
            simdgroup_multiply_accumulate(C0, A, B0, C0);
            simdgroup_multiply_accumulate(C1, A, B1, C1);
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    simdgroup_store(C0, Cs + sgitg * 128, 8); simdgroup_store(C1, Cs + sgitg * 128 + 64, 8);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0) {
        for (short e = tiisg; e < 128; e += 32) {
            float acc = Cs[e];
            for (short s = 1; s < NSG; s++) acc += Cs[s * 128 + e];
            const short half_ = e / 64, row = (e % 64) / 8, tok = (e % 64) % 8 + half_ * 8;
            if (r0 + row < args.ne01 && tok < args.ne11) ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = acc;
        }
    }
}
