/* llms EXT_MT (make_dense_t4.py, 2026-10-09 12:0x): the dense Q8_0 matvec for NTOK tokens on the attn-out mt8 template (NR0 weight rows
 * per threadgroup; each lane eight weights of a block, NSG*8 blocks per iteration, simd_sum + shmem reduction per row). The ext kernel at
 * 8 tokens moves these bytes at 57 GB/s; the same template moves attn_out at 164 GB/s. The summation order is not the ext kernel's:
 * NLL-gated, never in EXACT_ENV. Grid: x = rows / NR0, y = tokens / NTOK; threadgroup 32 x NSG; shmem NTOK*NR0*32 floats. */
template<short NR0, short NTOK>
void kernel_llms_mul_mv_q8_mt_impl(
        constant ds4_metal_args_mul_mv_ext & args,
        device const char * src0,
        device const char * src1,
        device       char * dst,
        threadgroup  char * shmem,
        uint3  tgpig,
        ushort tiisg,
        ushort sgitg) {
    const short NSG = FC_mul_mv_nsg;
    constexpr short NW = N_SIMDWIDTH;
    constexpr short NQ = 8;
    const int nb = args.ne00/QK8_0;
    const int r0 = tgpig.x*NR0;
    const int t0 = tgpig.y*NTOK;
    device const block_q8_0 * ax[NR0];
    FOR_UNROLL (short row = 0; row < NR0; ++row) {
        const int rr = (r0 + row < args.ne01) ? (r0 + row) : (args.ne01 - 1);
        ax[row] = (device const block_q8_0 *)(src0 + (uint64_t)rr*args.nb01);
    }
    float sumf[NTOK][NR0];
    FOR_UNROLL (short t = 0; t < NTOK; ++t) { FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[t][row] = 0.f; }
    const short ix = tiisg/(NW/NQ);
    const short il = tiisg%(NW/NQ);
    const int ib0 = sgitg*NQ + ix;
    device const float * yb[NTOK];
    FOR_UNROLL (short t = 0; t < NTOK; ++t) {
        const int tt = (t0 + t < args.ne11) ? (t0 + t) : (args.ne11 - 1);
        yb[t] = (device const float *)(src1 + (uint64_t)tt*args.nb11) + ib0*QK8_0 + il*NQ;
    }
    for (int ib = ib0; ib < nb; ib += NSG*NQ) {
        float yl[NTOK][NQ];
        FOR_UNROLL (short t = 0; t < NTOK; ++t) { FOR_UNROLL (short i = 0; i < NQ; ++i) yl[t][i] = yb[t][i]; }
        FOR_UNROLL (short row = 0; row < NR0; row++) {
            device const int8_t * qs = ax[row][ib].qs + il*NQ;
            const float d = ax[row][ib].d;
            float w[NQ];
            FOR_UNROLL (short i = 0; i < NQ; ++i) w[i] = qs[i];
            FOR_UNROLL (short t = 0; t < NTOK; ++t) {
                float sumq = 0.f;
                FOR_UNROLL (short i = 0; i < NQ; ++i) sumq += w[i] * yl[t][i];
                sumf[t][row] += sumq*d;
            }
        }
        FOR_UNROLL (short t = 0; t < NTOK; ++t) yb[t] += NSG*NQ*QK8_0;
    }
    FOR_UNROLL (short t = 0; t < NTOK; ++t) {
        if (t0 + t < args.ne11) {
            device float * dst_f32 = (device float *) dst + (uint64_t)(t0 + t)*args.ne0;
            helper_mv_reduce_and_write<NR0>(dst_f32, sumf[t], r0, args.ne01, tiisg, sgitg, shmem + (uint)t*NR0*NW*sizeof(float));
        }
    }
}
