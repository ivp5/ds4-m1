// ---- llms Q4L_RSG: row-per-simdgroup k-row matvecs on half x ----
template<short NR0, short KC, short S>
static inline void llms_q4l_mv_rsg_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                        uint3 tgpig, ushort tiisg, ushort sgitg) {
    const int K = args.ne00, N = args.ne01, nb = K / 32;
    const int r0 = ((int)tgpig.x * S + (int)sgitg) * NR0;
    device const uint * wq[NR0]; llms_q4s ws[NR0];
    FOR_UNROLL (short row = 0; row < NR0; ++row) {
        const int r = min(r0 + row, N - 1);
        device const char * rp = src0 + (ulong)r * args.nb01;
        wq[row] = (device const uint *) rp; ws[row] = llms_q4s{(device const uchar *) (rp + K / 2)};
    }
