template<short NR0, short KC, short S>
static inline void llms_q4l_mv_rsgf_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                        uint3 tgpig, ushort tiisg, ushort sgitg) {
    const int K = args.ne00, N = args.ne01, nb = K / 32;
