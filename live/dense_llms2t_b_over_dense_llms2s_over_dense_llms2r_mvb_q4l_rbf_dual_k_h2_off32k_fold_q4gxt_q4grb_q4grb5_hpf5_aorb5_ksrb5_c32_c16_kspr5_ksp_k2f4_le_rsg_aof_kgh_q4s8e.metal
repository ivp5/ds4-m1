// ---- llms Q4G_PF (benched as q4g64pf in gq_bench.py): kernel_llms_q4g64 / kernel_llms_q4g64s with a
// REGISTER PREFETCH of the next K block -- each thread loads block b+1's weight word, scale and 8 token values into registers before block b's
// MMAs and writes them to the tiles after the next barrier. The live arithmetic, tiles, MMA order and output staging (bit-identical). ----
static inline void llms_q4pf_body(const int K, const int R, const int C, const int rb, device const char * src, device const float * x, const ulong xs,
                                  device float * dst, const ulong ds, threadgroup float * sh, const int r0, const ushort tid, const ushort sg) {
    const int nb = K / 32; const ulong rowb = (ulong)K / 2 + (ulong)nb * 1;
    threadgroup float * Ws = sh;            // [64 rows][32 k]
    threadgroup float * Xs = sh + 64 * 32;  // [32 k][64 tokens]
    simdgroup_float8x8 acc[8];
    for (int t = 0; t < 8; t++) acc[t] = simdgroup_float8x8(0.f);
    const int wr = tid >> 2, wl = tid & 3;
    device const char * rp = src + (ulong)min(r0 + wr, R - 1) * rowb;
    device const uint * wq = (device const uint *)rp; const llms_q4s ws = llms_q4s{(device const uchar *)(rp + K / 2)};
    uint wn = wq[wl]; float scn = (float)ws[0]; float xn[8];
    for (int j = 0; j < 8; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * xs + k] : 0.f; }
    for (int b = 0; b < nb; b++) {
        { threadgroup float * o = Ws + wr * 32 + wl * 8;
          for (int j = 0; j < 4; j++) { o[2 * j] = ((float)(int)((wn >> (8 * j)) & 15u) - 8.f) * scn; o[2 * j + 1] = ((float)(int)((wn >> (8 * j + 4)) & 15u) - 8.f) * scn; } }
        for (int j = 0; j < 8; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; Xs[k * 64 + c] = xn[j]; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (b + 1 < nb) { wn = wq[(b + 1) * 4 + wl]; scn = (float)ws[b + 1];
                          for (int j = 0; j < 8; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * xs + (b + 1) * 32 + k] : 0.f; } }
        for (int kk = 0; kk < 4; kk++) {
            simdgroup_float8x8 Am; simdgroup_load(Am, Ws + sg * 8 * 32 + kk * 8, 32);
            for (int t = 0; t < 8; t++) { simdgroup_float8x8 Bm; simdgroup_load(Bm, Xs + kk * 8 * 64 + t * 8, 64); simdgroup_multiply_accumulate(acc[t], Am, Bm, acc[t]); }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    for (int t = 0; t < 8; t++) simdgroup_store(acc[t], sh + (t * 8) * 64 + sg * 8, 64, ulong2(0, 0), true);   // sh[token][row]
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (int i = tid; i < 64 * 64; i += 256) {
        const int c = i >> 6, r = i & 63;
        if (c < C && r0 + r < R) {
            float v = sh[c * 64 + r];
            if (rb) { uint bits = as_type<uint>(v); if ((bits & 0x7f800000u) != 0x7f800000u) bits += 0x7fffu + ((bits >> 16u) & 1u); v = as_type<float>(bits & 0xffff0000u); }
            dst[(ulong)c * ds + r0 + r] = v;
        }
    }
}
kernel void kernel_llms_q4g64pf(constant llms_q4g_args & a [[buffer(0)]], device const char * src0 [[buffer(1)]], device const float * x [[buffer(2)]],
        device float * dst [[buffer(3)]], threadgroup float * sh [[threadgroup(0)]], uint tgx [[threadgroup_position_in_grid]],
        ushort tid [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
    llms_q4pf_body(a.K, a.R, a.C, a.rb, src0, x, (ulong)a.K, dst, (ulong)a.R, sh, (int)tgx * 64, tid, sg);
}
kernel void kernel_llms_q4g64spf(constant llms_q4gs_args & a [[buffer(0)]], device const char * src0 [[buffer(1)]], device const float * x0 [[buffer(2)]],
        device float * dst0 [[buffer(3)]], threadgroup float * sh [[threadgroup(0)]], uint3 tgp [[threadgroup_position_in_grid]],
        ushort tid [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
    const int g = (int)tgp.z;
    llms_q4pf_body(a.K, a.R, a.C, a.rb, src0 + (ulong)g * a.wg, x0 + (ulong)g * (ulong)a.xg, (ulong)a.xs, dst0 + (ulong)g * (ulong)a.R, (ulong)a.ds, sh, (int)tgp.x * 64, tid, sg);
}

// ---- llms Q4G_PF2 (make_kspf.py): the K-split GEMMs' register-prefetch twins, generated from the live impls ----
template<int NT>
static inline void llms_q4g64_ksdpf_impl(constant llms_q4g_ks_args & a, device const char * src0, device const float * x, device float * dst, threadgroup float * sh, uint2 tg, ushort tid, ushort sg) {   // S = 1, DIRECT: no partials, no reduce pass; the rb rounding here
    const int K = a.K, nb = K / 32, r0 = (int)tg.x * 64, C = a.C, S = a.S, s = (int)tg.y; const ulong rowb = (ulong)K / 2 + (ulong)nb * 1;
    const int b0 = (int)((long)nb * s / S), b1 = (int)((long)nb * (s + 1) / S);
    threadgroup float * Ws = sh;            // [64 rows][32 k]
    threadgroup float * Xs = sh + 64 * 32;  // [64 tokens][32 k]
    simdgroup_float8x8 acc[NT];
    for (int t = 0; t < NT; t++) acc[t] = simdgroup_float8x8(0.f);
    const int wr = tid >> 2, wl = tid & 3;
    device const char * rp = src0 + (ulong)min(r0 + wr, a.R - 1) * rowb;
    device const uint * wq = (device const uint *)rp; const llms_q4s ws = llms_q4s{(device const uchar *)(rp + K / 2)};
    uint wn = 0u; float scn = 0.f; float xn[NT];   /* llms Q4G_PF: block b+1 prefetched into registers before block b's MMAs */
    if (b0 < b1) { wn = wq[b0 * 4 + wl]; scn = (float)ws[b0]; for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * K + b0 * 32 + k] : 0.f; } }
    for (int b = b0; b < b1; b++) {
        { threadgroup float * o = Ws + wr * 32 + wl * 8;
          for (int j = 0; j < 4; j++) { o[2 * j] = ((float)(int)((wn >> (8 * j)) & 15u) - 8.f) * scn; o[2 * j + 1] = ((float)(int)((wn >> (8 * j + 4)) & 15u) - 8.f) * scn; } }
        for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; Xs[c * 32 + k] = xn[j]; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (b + 1 < b1) { wn = wq[(b + 1) * 4 + wl]; scn = (float)ws[b + 1]; for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * K + (b + 1) * 32 + k] : 0.f; } }
        for (int kk = 0; kk < 4; kk++) {
            simdgroup_float8x8 Am; simdgroup_load(Am, Ws + sg * 8 * 32 + kk * 8, 32);
            for (int t = 0; t < NT; t++) { simdgroup_float8x8 Bm; simdgroup_load(Bm, Xs + t * 8 * 32 + kk * 8, 32, ulong2(0, 0), true); simdgroup_multiply_accumulate(acc[t], Am, Bm, acc[t]); }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    for (int t = 0; t < NT; t++) simdgroup_store(acc[t], sh + (t * 8) * 64 + sg * 8, 64, ulong2(0, 0), true);   // sh[token][row]
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (int i = tid; i < NT * 8 * 64; i += 256) {
        const int c = i >> 6, r = i & 63;
        if (c < C && r0 + r < a.R) { float v = sh[c * 64 + r]; if (a.rb) { uint bits = as_type<uint>(v); if ((bits & 0x7f800000u) != 0x7f800000u) bits += 0x7fffu + ((bits >> 16u) & 1u); v = as_type<float>(bits & 0xffff0000u); } dst[(ulong)c * a.R + r0 + r] = v; }
    }
}
template<int NT>
static inline void llms_q4g64_ksapf_impl(constant llms_q4g_ks_args & a, device const char * src0, device const float * x, device float * dst, device coherent(device) float * part, device atomic_uint * cnt, threadgroup float * sh, uint2 tg, ushort tid, ushort sg) {   // ONE dispatch: the last-arriving split threadgroup of a tile sums the partials (no reduce pass, no encoder barrier)
    const int K = a.K, nb = K / 32, r0 = (int)tg.x * 64, C = a.C, S = a.S, s = (int)tg.y; const ulong rowb = (ulong)K / 2 + (ulong)nb * 1;
    const int b0 = (int)((long)nb * s / S), b1 = (int)((long)nb * (s + 1) / S);
    threadgroup float * Ws = sh;            // [64 rows][32 k]
    threadgroup float * Xs = sh + 64 * 32;  // [64 tokens][32 k]
    simdgroup_float8x8 acc[NT];
    for (int t = 0; t < NT; t++) acc[t] = simdgroup_float8x8(0.f);
    const int wr = tid >> 2, wl = tid & 3;
    device const char * rp = src0 + (ulong)min(r0 + wr, a.R - 1) * rowb;
    device const uint * wq = (device const uint *)rp; const llms_q4s ws = llms_q4s{(device const uchar *)(rp + K / 2)};
    uint wn = 0u; float scn = 0.f; float xn[NT];   /* llms Q4G_PF: block b+1 prefetched into registers before block b's MMAs */
    if (b0 < b1) { wn = wq[b0 * 4 + wl]; scn = (float)ws[b0]; for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * K + b0 * 32 + k] : 0.f; } }
    for (int b = b0; b < b1; b++) {
        { threadgroup float * o = Ws + wr * 32 + wl * 8;
          for (int j = 0; j < 4; j++) { o[2 * j] = ((float)(int)((wn >> (8 * j)) & 15u) - 8.f) * scn; o[2 * j + 1] = ((float)(int)((wn >> (8 * j + 4)) & 15u) - 8.f) * scn; } }
        for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; Xs[c * 32 + k] = xn[j]; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (b + 1 < b1) { wn = wq[(b + 1) * 4 + wl]; scn = (float)ws[b + 1]; for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * K + (b + 1) * 32 + k] : 0.f; } }
        for (int kk = 0; kk < 4; kk++) {
            simdgroup_float8x8 Am; simdgroup_load(Am, Ws + sg * 8 * 32 + kk * 8, 32);
            for (int t = 0; t < NT; t++) { simdgroup_float8x8 Bm; simdgroup_load(Bm, Xs + t * 8 * 32 + kk * 8, 32, ulong2(0, 0), true); simdgroup_multiply_accumulate(acc[t], Am, Bm, acc[t]); }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    for (int t = 0; t < NT; t++) simdgroup_store(acc[t], sh + (t * 8) * 64 + sg * 8, 64, ulong2(0, 0), true);   // sh[token][row]
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (int i = tid; i < NT * 8 * 64; i += 256) {
        const int c = i >> 6, r = i & 63;
        if (c < C && r0 + r < a.R) part[((ulong)s * C + c) * a.R + r0 + r] = sh[c * 64 + r];
    }
    threadgroup_barrier(mem_flags::mem_device);   // this threadgroup's partial is visible device-wide before the arrival is counted
    threadgroup uint * last = (threadgroup uint *)(sh + 64 * 64);
    if (tid == 0) { atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);   //
                    const uint prev = atomic_fetch_add_explicit(cnt + tg.x, 1u, memory_order_relaxed); *last = prev == (uint)(S - 1);
                    if (*last) atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device); }   // acquire every split's partial after the winning RMW
    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
    if (!*last) return;
    if (tid == 0) atomic_store_explicit(cnt + tg.x, 0u, memory_order_relaxed);   // the counter is reusable without a fill
    for (int i = tid; i < NT * 8 * 64; i += 256) {
        const int c = i >> 6, r = i & 63;
        if (c < C && r0 + r < a.R) {
            float v = 0.f; for (int q = 0; q < S - ((a.rb >> 1) & 1); q++) v += part[((ulong)q * C + c) * a.R + r0 + r];   /* rb bit 1: the CANARY */
            if (a.rb & 1) { uint bits = as_type<uint>(v); if ((bits & 0x7f800000u) != 0x7f800000u) bits += 0x7fffu + ((bits >> 16u) & 1u); v = as_type<float>(bits & 0xffff0000u); }
            dst[(ulong)c * a.R + r0 + r] = v;
        }
    }
}
