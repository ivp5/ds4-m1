        wq[row] = (device const uint *) rp; ws[row] = llms_q4s{(device const uchar *) (rp + K / 2)};
    }
    float sumf[KC][NR0];
    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
    const short ix = tiisg / 4, il = tiisg % 4;
    for (int ib = ix; ib < nb; ib += 8) {
        float4 ya[KC], yb[KC];
        FOR_UNROLL (short c = 0; c < KC; ++c) {
            device const half * y = (device const half *) src1 + (ulong)c * (ulong)K;   /* x as half: the f32->f16 copy's row stride = ne00 halves (apply_hx.py) */
            ya[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8)));
            yb[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8 + 4)));
        }
        float nxs[KC]; FOR_UNROLL (short c = 0; c < KC; ++c) nxs[c] = -1032.0f * (((ya[c].x + ya[c].y) + (ya[c].z + ya[c].w)) + ((yb[c].x + yb[c].y) + (yb[c].z + yb[c].w)));
        FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const uint w = wq[row][ib * 4 + il];
            const float sc = (float) ws[row][ib];
            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u);
            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u);
            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u);
            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u);
            FOR_UNROLL (short c = 0; c < KC; ++c) {
                const float4 a = ya[c], b = yb[c];
                const float d8 = fma((float)h3.y, b.w, fma((float)h2.y, b.z, fma((float)h1.y, b.y, fma((float)h0.y, b.x,
                                 fma((float)h3.x, a.w, fma((float)h2.x, a.z, fma((float)h1.x, a.y, fma((float)h0.x, a.x, nxs[c]))))))));
                sumf[c][row] = fma(d8, sc, sumf[c][row]);
