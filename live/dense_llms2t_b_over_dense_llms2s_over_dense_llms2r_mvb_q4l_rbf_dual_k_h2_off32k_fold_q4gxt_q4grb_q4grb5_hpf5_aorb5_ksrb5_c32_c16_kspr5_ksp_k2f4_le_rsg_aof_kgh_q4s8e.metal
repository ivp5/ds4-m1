// ---- llms Q4G_XT (make_q4gxt_source.py, 2026-10-22): the activations converted to half ONCE per GEMM pass into a K-major
// copy xt[k][64 tokens] (the same (half) conversion the hpf bodies applied per threadgroup), the B tiles loaded straight from it. Same A / B
// tile values in the same (block, kk) order as kernel_llms_q4g64hpf / kernel_llms_q4g64_ksahpf_nt8: bit-identical (gemm_bench). ----
kernel void kernel_llms_x2ht(device const float * x [[buffer(2)]], device half * xt [[buffer(7)]], constant uint2 & kc [[buffer(8)]],
                             uint tg [[threadgroup_position_in_grid]], ushort tid [[thread_index_in_threadgroup]]) {
    threadgroup half t[32 * 72];   // [k][token], padded
    const uint k0 = tg * 32u;
    for (uint j = 0; j < 8u; j++) { const uint i = tid + 256u * j, c = i >> 5, k = i & 31u;
        t[k * 72u + c] = (c < kc.y && k0 + k < kc.x) ? (half)x[(ulong)c * kc.x + k0 + k] : (half)0.0f; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    const uint k = tid >> 3, c8 = (tid & 7u) * 8u;
    if (k0 + k < kc.x) {
        half4 a = half4(t[k * 72u + c8], t[k * 72u + c8 + 1], t[k * 72u + c8 + 2], t[k * 72u + c8 + 3]);
        half4 b = half4(t[k * 72u + c8 + 4], t[k * 72u + c8 + 5], t[k * 72u + c8 + 6], t[k * 72u + c8 + 7]);
        device half4 * o = (device half4 *)(xt + (ulong)(k0 + k) * 64u + c8); o[0] = a; o[1] = b;
    }
}
kernel void kernel_llms_q4g64hpf_xt(constant llms_q4g_args & a [[buffer(0)]], device const char * src0 [[buffer(1)]], device float * dst [[buffer(3)]],
        device const half * xt [[buffer(7)]], threadgroup float * sh [[threadgroup(0)]], uint tgx [[threadgroup_position_in_grid]],
        ushort tid [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
