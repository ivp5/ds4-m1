// ---- llms Q4L_KGX (apply_kgx.py): the grouped attention output_a on half heads, half2 products (kg_bench 13:08) ----
template<short NR0, short KC, bool RB>
static inline void llms_q4l_mv_kgxh_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const short NSG = FC_mul_mv_nsg & 0xFF; const bool LEAN = (FC_mul_mv_nsg & 0x100) != 0;   /* llms Q4L_LEAN2: the flag rides the NSG constant */
    const int K = args.ne00, nb = K / 32, gz = (int)tgpig.z;
    const int r0 = tgpig.x * NR0;
    device const char * wg = src0 + (ulong)gz * args.nb02;
    device const uint * wq[NR0]; llms_q4s ws[NR0];
    FOR_UNROLL (short row = 0; row < NR0; ++row) {
        const int r = min(r0 + row, args.ne01 - 1);
        device const char * rp = wg + (ulong)r * args.nb01;
        wq[row] = (device const uint *) rp; ws[row] = llms_q4s{(device const uchar *) (rp + K / 2)};
    }
    float sumf[KC][NR0];
    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
    const short ix = tiisg / 4, il = tiisg % 4;
    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
        float4 ya[KC], yb[KC];
        FOR_UNROLL (short c = 0; c < KC; ++c) {
            device const half * y = (device const half *) (src1 + (ulong)gz * args.nb11 + (ulong)c * args.nb12);   /* llms KGX: x as half [row][group][K] */
            ya[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8)));
            yb[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8 + 4)));
        }
        float nxs[KC]; FOR_UNROLL (short c = 0; c < KC; ++c) nxs[c] = -1032.0f * (((ya[c].x + ya[c].y) + (ya[c].z + ya[c].w)) + ((yb[c].x + yb[c].y) + (yb[c].z + yb[c].w)));   /* llms FOLD: once per word, all rows */
        FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const uint w = wq[row][ib * 4 + il];
            const float sc = (float) ws[row][ib];
            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            FOR_UNROLL (short c = 0; c < KC; ++c) {
                const float4 a = ya[c], b = yb[c];
                const float d8 = fma((float)h3.y, b.w, fma((float)h2.y, b.z, fma((float)h1.y, b.y, fma((float)h0.y, b.x,
                                 fma((float)h3.x, a.w, fma((float)h2.x, a.z, fma((float)h1.x, a.y, fma((float)h0.x, a.x, nxs[c]))))))));   /* llms FOLD: (1024 + q) x in fp32, one chain seeded with -1032 x */
                sumf[c][row] = fma(d8, sc, sumf[c][row]);
            }
        }
    }
#ifndef LLMS_Q4L_LEAN2_OFF
    if (LEAN && NSG == 2) {   /* llms Q4L_LEAN2 (apply_lean2.py): the exact lean two-simdgroup epilogue */
        threadgroup float * part = (threadgroup float *) shmem;
        FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const float v = simd_sum(sumf[c][row]);
            if (sgitg == 1 && tiisg == 0) part[c * NR0 + row] = v;
            sumf[c][row] = v;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (sgitg == 0 && tiisg == 0) FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
            if (r0 + row >= args.ne01) continue;
            float tot = (sumf[c][row] + part[c * NR0 + row]) + 0.0f;
            if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
            ((device float *) (dst + (ulong)c * args.nb13) + (ulong)gz * args.ne01)[r0 + row] = tot;
        }
        return;
    }
#endif
    FOR_UNROLL (short c = 0; c < KC; ++c) {
        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
        device float * dc = (device float *) (dst + (ulong)c * args.nb13) + (ulong)gz * args.ne01;
        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
    }
}
