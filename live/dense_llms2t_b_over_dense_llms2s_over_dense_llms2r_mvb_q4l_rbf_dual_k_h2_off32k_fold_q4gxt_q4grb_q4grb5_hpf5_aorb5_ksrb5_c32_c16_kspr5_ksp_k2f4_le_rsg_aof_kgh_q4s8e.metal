        device char * da [[buffer(3)]], constant ds4_metal_args_mul_mv & ab [[buffer(4)]], device const char * wb [[buffer(5)]], device char * db [[buffer(6)]], \
        constant llms_k2s_args & p [[buffer(7)]], device const float * mix [[buffer(8)]], device const float * scale [[buffer(9)]], device const float * base [[buffer(10)]], \
        device float * split [[buffer(11)]], threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], \
