// ---- llms Q4L_HX (apply_hx.py): the f32 -> f16 copy of the two-row x (cv = {floats4 per row, float4 row stride, rows}) ----
kernel void kernel_llms_f32_to_f16_rows(device const float4 * src [[buffer(0)]], device half4 * dst [[buffer(1)]], constant uint * cv [[buffer(2)]], uint gid [[thread_position_in_grid]]) {
    const uint n4 = cv[0], rs4 = cv[1], rows = cv[2];
    if (gid >= n4 * rows) return;
    const uint r = gid / n4, i = gid - r * n4;
    dst[r * n4 + i] = half4(clamp(src[r * rs4 + i], -65504.0f, 65504.0f));   /* the engine's PREHALF conversion clamps the same way (kernel_llms_f32_to_half_clamp) */
}
// ---- llms F16_K2 (make_f16k.py, 2026-10-18 03:5x): the two-row k-family for F16 / BF16 weights. The engine's generic
// kernel_mul_mv_{f16,bf16}_f32_4 runs one threadgroup per (row block, token), so two-row verifies read the weights TWICE; this kernel
// walks each weight row once for KC token rows (the q4l k-family's loop with half4 / bfloat4 weight loads), unrounded float output. ----
template<typename W4, short NR0, short KC>
static inline void llms_f16_mv_k_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const short NSG = FC_mul_mv_nsg;
    const int K = args.ne00, nb = K / 32;
    const int r0 = tgpig.x * NR0;
    device const W4 * wr[NR0];
    FOR_UNROLL (short row = 0; row < NR0; ++row) {
        const int r = min(r0 + row, args.ne01 - 1);
        wr[row] = (device const W4 *) (src0 + (ulong)r * args.nb01);
    }
    float sumf[KC][NR0];
    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
    const short ix = tiisg / 4, il = tiisg % 4;
    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
        float4 ya[KC], yb[KC];
        FOR_UNROLL (short c = 0; c < KC; ++c) {
            device const float * y = (device const float *) (src1 + (ulong)c * args.nb11);
            ya[c] = *((device const float4 *) (y + ib * 32 + il * 8));
            yb[c] = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
        }
        FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const float4 wa = float4(wr[row][ib * 8 + il * 2]), wb = float4(wr[row][ib * 8 + il * 2 + 1]);
            FOR_UNROLL (short c = 0; c < KC; ++c) sumf[c][row] += dot(wa, ya[c]) + dot(wb, yb[c]);
        }
    }
    FOR_UNROLL (short c = 0; c < KC; ++c) {
        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
        device float * dc = (device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u);
        helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
    }
}
