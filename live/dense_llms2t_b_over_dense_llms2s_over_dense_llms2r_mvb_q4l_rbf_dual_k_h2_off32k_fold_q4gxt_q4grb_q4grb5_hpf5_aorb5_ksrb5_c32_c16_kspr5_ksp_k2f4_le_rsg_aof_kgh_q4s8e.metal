// ---- llms ACT_STATS (apply_act_stats.py): acc[j] += x[j]^2 (measurement only) ----
kernel void kernel_llms_act_sq_acc(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                   uint i [[thread_position_in_grid]]) {
    (void)src0;
    if ((int)i < args.ne00) { const float v = ((device const float *) src1)[i]; ((device float *) dst)[i] += v * v; }
}


// ---- llms Q4L_DUAL (apply_q4l_dual.py): two one-token q4l matvecs on one input in one dispatch, + an HC split ----
#ifdef DS4_METAL_HC_STABLE
static inline float4 llms_d2_sigmoid(float4 z)  { return 0.5f * tanh(0.5f * z) + 0.5f; }
static inline float4 llms_d2_twice_sigmoid(float4 z) { return 1.0f + tanh(0.5f * z); }
#else
static inline float4 llms_d2_sigmoid(float4 z)  { return 1.0f / (1.0f + exp(-z)); }
static inline float4 llms_d2_twice_sigmoid(float4 z) { return 2.0f / (1.0f + exp(-z)); }
#endif
struct llms_q4l2_args { uint ga, gb, sk, canary; int iters; float eps; };
[[host_name("kernel_llms_q4l_mv_b2")]]
kernel void kernel_llms_q4l_mv_b2(constant ds4_metal_args_mul_mv & aa [[buffer(0)]], device const char * wa [[buffer(1)]], device const char * src1 [[buffer(2)]],
        device char * da [[buffer(3)]], constant ds4_metal_args_mul_mv & ab [[buffer(4)]], device const char * wb [[buffer(5)]], device char * db [[buffer(6)]],
        constant llms_q4l2_args & p [[buffer(7)]], device const float * mix [[buffer(8)]], device const float * scale [[buffer(9)]],
        device const float * base [[buffer(10)]], device float * out [[buffer(11)]],
        threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]],
        ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
    if (tgpig.x < p.ga) { llms_q4l_mv_impl<4, true>(aa, wa, src1, da, shmem, tgpig, tiisg, sgitg); return; }
    if (tgpig.x < p.ga + p.gb) { llms_q4l_mv_impl<4, true>(ab, wb, src1, db, shmem, uint3(tgpig.x - p.ga, tgpig.y, tgpig.z), tiisg, sgitg); return; }
    if (!p.sk || sgitg != 0 || tiisg != 0) return;
    /* kernel_dsv4_hc_split_sinkhorn, HC = 4, one row */
    const float epsv = p.eps, pre_scale = scale[0], post_scale = scale[1], comb_scale = scale[2];
    const float4 pre_z = *((device const float4 *) mix) * pre_scale + *((device const float4 *) base);
    *((device float4 *) out) = llms_d2_sigmoid(pre_z) + epsv;
    const float4 post_z = *((device const float4 *) (mix + 4)) * post_scale + *((device const float4 *) (base + 4));
    *((device float4 *) (out + 4)) = llms_d2_twice_sigmoid(post_z);
    float4 r0 = *((device const float4 *) (mix +  8)) * comb_scale + *((device const float4 *) (base +  8));
    float4 r1 = *((device const float4 *) (mix + 12)) * comb_scale + *((device const float4 *) (base + 12));
    float4 r2 = *((device const float4 *) (mix + 16)) * comb_scale + *((device const float4 *) (base + 16));
    float4 r3 = *((device const float4 *) (mix + 20)) * comb_scale + *((device const float4 *) (base + 20));
    const float m0 = max(max(r0.x, r0.y), max(r0.z, r0.w));
    const float m1 = max(max(r1.x, r1.y), max(r1.z, r1.w));
    const float m2 = max(max(r2.x, r2.y), max(r2.z, r2.w));
    const float m3 = max(max(r3.x, r3.y), max(r3.z, r3.w));
    r0 = exp(r0 - m0);
    r1 = exp(r1 - m1);
    r2 = exp(r2 - m2);
    r3 = exp(r3 - m3);
    r0 = r0 * (1.0f / (r0.x + r0.y + r0.z + r0.w)) + epsv;
    r1 = r1 * (1.0f / (r1.x + r1.y + r1.z + r1.w)) + epsv;
    r2 = r2 * (1.0f / (r2.x + r2.y + r2.z + r2.w)) + epsv;
    r3 = r3 * (1.0f / (r3.x + r3.y + r3.z + r3.w)) + epsv;
    float4 col_inv = 1.0f / (r0 + r1 + r2 + r3 + epsv);
    r0 *= col_inv;
    r1 *= col_inv;
    r2 *= col_inv;
    r3 *= col_inv;
    const int iters = p.canary ? p.iters / 2 : p.iters;
    for (int iter = 1; iter < iters; ++iter) {
        r0 *= 1.0f / (r0.x + r0.y + r0.z + r0.w + epsv);
        r1 *= 1.0f / (r1.x + r1.y + r1.z + r1.w + epsv);
        r2 *= 1.0f / (r2.x + r2.y + r2.z + r2.w + epsv);
        r3 *= 1.0f / (r3.x + r3.y + r3.z + r3.w + epsv);
        col_inv = 1.0f / (r0 + r1 + r2 + r3 + epsv);
        r0 *= col_inv;
        r1 *= col_inv;
        r2 *= col_inv;
        r3 *= col_inv;
    }
    *((device float4 *) (out +  8)) = r0;
    *((device float4 *) (out + 12)) = r1;
    *((device float4 *) (out + 16)) = r2;
    *((device float4 *) (out + 20)) = r3;
}


// ---- llms Q4L_K : the q4l matvec for K activation columns in one pass over the weights -- each lane dequantizes a
// weight word once (llms_q4l_dot8's exact expression per column) and accumulates every column; NR0 rows per threadgroup; per column the
// same lane order, the same block stride and the same reduction / bf16 store as kernel_llms_q4l_mv_b: bit-identical column by column. ----
template<short NR0, short KC, bool RB>
static inline void llms_q4l_mv_k_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const short NSG = FC_mul_mv_nsg;
    const int K = args.ne00, nb = K / 32;
    const int r0 = tgpig.x * NR0;
    device const uint * wq[NR0]; llms_q4s ws[NR0];
    FOR_UNROLL (short row = 0; row < NR0; ++row) {
        const int r = min(r0 + row, args.ne01 - 1);
        device const char * rp = src0 + (ulong)r * args.nb01;
        wq[row] = (device const uint *) rp; ws[row] = llms_q4s{(device const uchar *) (rp + K / 2)};
    }
    float sumf[KC][NR0];
    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
    const short ix = tiisg / 4, il = tiisg % 4;
    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
        float4 ya[KC], yb[KC];
        FOR_UNROLL (short c = 0; c < KC; ++c) {
            device const float * y = (device const float *) (src1 + (ulong)c * args.nb11);
            ya[c] = *((device const float4 *) (y + ib * 32 + il * 8));
            yb[c] = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
        }
        float nxs[KC]; FOR_UNROLL (short c = 0; c < KC; ++c) nxs[c] = -1032.0f * (((ya[c].x + ya[c].y) + (ya[c].z + ya[c].w)) + ((yb[c].x + yb[c].y) + (yb[c].z + yb[c].w)));   /* llms FOLD: once per word, all rows */
        FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const uint w = wq[row][ib * 4 + il];
            const float sc = (float) ws[row][ib];
            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
#if LLMS_Q4L_HALF2   /* apply_half2.py: the products in half2 (kh_bench 02:41), a compile-time switch from LLMS_DS4_Q4L_HALF2 */
            FOR_UNROLL (short c = 0; c < KC; ++c) {
                const float4 a = ya[c], b = yb[c];
                const float d8 = fma((float)h3.y, b.w, fma((float)h2.y, b.z, fma((float)h1.y, b.y, fma((float)h0.y, b.x,
                                 fma((float)h3.x, a.w, fma((float)h2.x, a.z, fma((float)h1.x, a.y, fma((float)h0.x, a.x, nxs[c]))))))));   /* llms FOLD: (1024 + q) x in fp32, one chain seeded with -1032 x */
                sumf[c][row] = fma(d8, sc, sumf[c][row]);
            }
#else
            FOR_UNROLL (short c = 0; c < KC; ++c) {
                const float4 a = ya[c], b = yb[c];
                const float d8 = fma((float)h3.y, b.w, fma((float)h2.y, b.z, fma((float)h1.y, b.y, fma((float)h0.y, b.x,
                                 fma((float)h3.x, a.w, fma((float)h2.x, a.z, fma((float)h1.x, a.y, fma((float)h0.x, a.x, nxs[c]))))))));   /* llms FOLD: (1024 + q) x in fp32, one chain seeded with -1032 x */
                sumf[c][row] = fma(d8, sc, sumf[c][row]);
            }
#endif
        }
    }
#ifndef LLMS_Q4L_CE3
#define LLMS_Q4L_CE3 0
#endif
#ifndef LLMS_Q4L_HALF2
#define LLMS_Q4L_HALF2 0
#endif
#if LLMS_Q4L_CE   /* adopt_ce.py:, a compile-time switch from LLMS_DS4_Q4L_CE */
    // Native-tested BF16 domain; other specializations retain their reducer. adopt_ce3.py: the three-row NR8 and four-row NR4 siblings under LLMS_Q4L_CE3 .
    if (NSG == 2 && RB && ((NR0 == 4 && KC == 2) || (LLMS_Q4L_CE3 && ((NR0 == 4 && KC == 4) || (NR0 == 8 && KC == 3))))) {
        threadgroup float *partial = (threadgroup float *)shmem;
        device float *dst_f = (device float *)dst;
        FOR_UNROLL (short c = 0; c < KC; ++c) {
            if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
            FOR_UNROLL (short row = 0; row < NR0; ++row) {
                float v = simd_sum(sumf[c][row]);
                if (tiisg == 0) partial[row * NSG + sgitg] = v;
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
            if (sgitg == 0) FOR_UNROLL (short row = 0; row < NR0; ++row) {
                float v = tiisg < NSG ? partial[row * NSG + tiisg] : 0.f;
                float tot = simd_sum(v);
                if (tiisg == 0 && r0 + row < args.ne01) {
                    if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
                    dst_f[(ulong)c * (ulong)args.ne01 + (ulong)(r0 + row)] = tot;
                }
            }
        }
        return;
    }
#endif
    FOR_UNROLL (short c = 0; c < KC; ++c) {
        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
        device float * dc = (device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u);
        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
    }
}
// ---- llms Q4L_HX (apply_hx.py): the two-row kernels on HALF x with the half2 products (kx_bench 02:56) ----
template<short NR0, short KC, bool RB>
static inline void llms_q4l_mv_kxh_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const short NSG = FC_mul_mv_nsg & 0xFF; const bool LEAN = (FC_mul_mv_nsg & 0x100) != 0;   /* llms Q4L_LEAN2: the flag rides the NSG constant */
    const int K = args.ne00, nb = K / 32;
    const int r0 = tgpig.x * NR0;
    device const uint * wq[NR0]; llms_q4s ws[NR0];
    FOR_UNROLL (short row = 0; row < NR0; ++row) {
        const int r = min(r0 + row, args.ne01 - 1);
        device const char * rp = src0 + (ulong)r * args.nb01;
        wq[row] = (device const uint *) rp; ws[row] = llms_q4s{(device const uchar *) (rp + K / 2)};
    }
    float sumf[KC][NR0];
    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
    const short ix = tiisg / 4, il = tiisg % 4;
    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
        float4 ya[KC], yb[KC];
        FOR_UNROLL (short c = 0; c < KC; ++c) {
            device const half * y = (device const half *) src1 + (ulong)c * (ulong)args.ne00;   /* x as half: the f32->f16 copy's row stride = ne00 halves (apply_hx.py) */
            ya[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8)));
            yb[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8 + 4)));
        }
        float nxs[KC]; FOR_UNROLL (short c = 0; c < KC; ++c) nxs[c] = -1032.0f * (((ya[c].x + ya[c].y) + (ya[c].z + ya[c].w)) + ((yb[c].x + yb[c].y) + (yb[c].z + yb[c].w)));   /* llms FOLD: once per word, all rows */
        FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const uint w = wq[row][ib * 4 + il];
            const float sc = (float) ws[row][ib];
            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u);   /* llms FOLD: 1024 + q, the bias leaves through nxs */
            FOR_UNROLL (short c = 0; c < KC; ++c) {
                const float4 a = ya[c], b = yb[c];
                const float d8 = fma((float)h3.y, b.w, fma((float)h2.y, b.z, fma((float)h1.y, b.y, fma((float)h0.y, b.x,
                                 fma((float)h3.x, a.w, fma((float)h2.x, a.z, fma((float)h1.x, a.y, fma((float)h0.x, a.x, nxs[c]))))))));   /* llms FOLD: (1024 + q) x in fp32, one chain seeded with -1032 x */
                sumf[c][row] = fma(d8, sc, sumf[c][row]);
            }
        }
    }
#ifndef LLMS_Q4L_LEAN2_OFF
    if (LEAN && NSG == 2) {   /* llms Q4L_LEAN2 (apply_lean2.py): the exact lean two-simdgroup epilogue */
        threadgroup float * part = (threadgroup float *) shmem;
        FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
            const float v = simd_sum(sumf[c][row]);
            if (sgitg == 1 && tiisg == 0) part[c * NR0 + row] = v;
            sumf[c][row] = v;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (sgitg == 0 && tiisg == 0) FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
            if (r0 + row >= args.ne01) continue;
            float tot = (sumf[c][row] + part[c * NR0 + row]) + 0.0f;
            if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
            ((device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u))[r0 + row] = tot;
        }
        return;
    }
#endif
    FOR_UNROLL (short c = 0; c < KC; ++c) {
        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
        device float * dc = (device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u);
        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
    }
}
