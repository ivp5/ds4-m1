// ---- llms Q4G K-split kernels (q4g_ks.metal: the record's, partials coherent(device)) ----
// q4g_ks.metal (2026-10-17 18:3x): kernel_llms_q4g64 split along K -- S threadgroups per 64-row tile, each walking nb / S blocks of 32,
// partials to part[(s * C + c) * R + r] (buffer 4), summed by kernel_llms_q4g64_ksr with the rb rounding. The X tile is staged as [token][k]
// (conflict-free stores, loaded transposed); everything else is kernel_llms_q4g64's arithmetic. S = 1 is the layout change alone.
struct llms_q4g_ks_args { int K; int R; int C; int rb; int S; };
kernel void kernel_llms_q4g64_ks(constant llms_q4g_ks_args & a [[buffer(0)]], device const char * src0 [[buffer(1)]], device const float * x [[buffer(2)]],
        device coherent(device) float * part [[buffer(4)]], threadgroup float * sh [[threadgroup(0)]], uint2 tg [[threadgroup_position_in_grid]],
        ushort tid [[thread_index_in_threadgroup]], ushort sg [[simdgroup_index_in_threadgroup]]) {
    const int K = a.K, nb = K / 32, r0 = (int)tg.x * 64, C = a.C, S = a.S, s = (int)tg.y; const ulong rowb = (ulong)K / 2 + (ulong)nb * 1;
    const int b0 = (int)((long)nb * s / S), b1 = (int)((long)nb * (s + 1) / S);
    threadgroup float * Ws = sh;            // [64 rows][32 k]
    threadgroup float * Xs = sh + 64 * 32;  // [64 tokens][32 k]
    simdgroup_float8x8 acc[8];
    for (int t = 0; t < 8; t++) acc[t] = simdgroup_float8x8(0.f);
    const int wr = tid >> 2, wl = tid & 3;
    device const char * rp = src0 + (ulong)min(r0 + wr, a.R - 1) * rowb;
    device const uint * wq = (device const uint *)rp; const llms_q4s ws = llms_q4s{(device const uchar *)(rp + K / 2)};
    for (int b = b0; b < b1; b++) {
        { const uint w = wq[b * 4 + wl]; const float sc = (float)ws[b];
          threadgroup float * o = Ws + wr * 32 + wl * 8;
          for (int j = 0; j < 4; j++) { o[2 * j] = ((float)(int)((w >> (8 * j)) & 15u) - 8.f) * sc; o[2 * j + 1] = ((float)(int)((w >> (8 * j + 4)) & 15u) - 8.f) * sc; } }
        for (int i = tid; i < 32 * 64; i += 256) { const int c = i >> 5, k = i & 31; Xs[c * 32 + k] = c < C ? x[(ulong)c * K + b * 32 + k] : 0.f; }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (int kk = 0; kk < 4; kk++) {
