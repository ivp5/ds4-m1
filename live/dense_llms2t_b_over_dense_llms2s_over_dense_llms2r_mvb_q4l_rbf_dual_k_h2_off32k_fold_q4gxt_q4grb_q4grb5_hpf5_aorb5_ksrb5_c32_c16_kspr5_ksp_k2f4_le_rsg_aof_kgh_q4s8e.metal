/* llms EXT_SGMF (make_dense_t4.py 15:2x): the 8-token F16 / F32 matvecs on fp32 simdgroup-matrix tiles. The exact-rows t4 kernels
 * move engram_kv (F16 6,144 x 25,600, 314 MB, four calls per 16-token step) at 56 GB/s and the F32 router (5,120 x 384, 80 calls)
 * at 54 GB/s; here each 8 x 32 weight tile loads straight into the A tile (no dequant), the activations stage once per block, four
 * 8x8x8 multiply-accumulates per block, the K-split partials summed in a fixed order. Not the exact-rows order: NLL-gated. */
template<typename TW, typename TW4, short NSG>
void kernel_llms_mul_mv_sgmf_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                  threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const int nb = args.ne00 / 32;
    const int r0 = tgpig.x * 8;
    threadgroup float * As = (threadgroup float *)shmem + sgitg * 256;               // [row 8][k 32]
    threadgroup float * Bs = (threadgroup float *)shmem + NSG * 256 + sgitg * 256;   // [k 32][tok 8]
    threadgroup float * Cs = (threadgroup float *)shmem + 2 * NSG * 256;             // [sg][row 8][tok 8]
    simdgroup_float8x8 C = make_filled_simdgroup_matrix<float, 8>(0.f);
    const short lr = tiisg / 4, lq = tiisg % 4;
    const int rr = (r0 + lr < args.ne01) ? (r0 + lr) : (args.ne01 - 1);
    device const TW4 * xrow = (device const TW4 *)(src0 + (uint64_t)rr * args.nb01) + lq * 2;   // row rr, quad lq: two 4-vectors per block
    device const float4 * yt = (device const float4 *)(src1 + (uint64_t)lr * args.nb11) + lq * 2;   // token lr, quad lq
    threadgroup float4 * as4 = (threadgroup float4 *)(As + lr * 32 + lq * 8);
    threadgroup float * bs = Bs + (lq * 8) * 8 + lr;
    for (int ib = sgitg; ib < nb; ib += NSG) {
        const TW4 w0 = xrow[ib * 8], w1 = xrow[ib * 8 + 1];
        as4[0] = float4(w0); as4[1] = float4(w1);
        const float4 x0 = yt[ib * 8], x1 = yt[ib * 8 + 1];
        bs[0] = x0.x; bs[8] = x0.y; bs[16] = x0.z; bs[24] = x0.w; bs[32] = x1.x; bs[40] = x1.y; bs[48] = x1.z; bs[56] = x1.w;
        simdgroup_barrier(mem_flags::mem_threadgroup);
        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
            simdgroup_float8x8 A, B;
            simdgroup_load(A, As + kt * 8, 32);
            simdgroup_load(B, Bs + kt * 64, 8);
            simdgroup_multiply_accumulate(C, A, B, C);
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    simdgroup_store(C, Cs + sgitg * 64, 8);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0) {
        for (short e = tiisg; e < 64; e += 32) {
            float acc = Cs[e];
            for (short s = 1; s < NSG; s++) acc += Cs[s * 64 + e];
            const short row = e / 8, tok = e % 8;
            if (r0 + row < args.ne01) ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = acc;
        }
    }
}
#define LLMS_SGMF(NAME, TW, TW4, NSG) \
kernel void NAME(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst, \
                 threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { \
    kernel_llms_mul_mv_sgmf_impl<TW, TW4, NSG>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
LLMS_SGMF(kernel_llms_mul_mv_f16_f32_sgmf8k_s4, half, half4, 4)
LLMS_SGMF(kernel_llms_mul_mv_f16_f32_sgmf8k_s8, half, half4, 8)
LLMS_SGMF(kernel_llms_mul_mv_f32_f32_sgmf8k_s4, float, float4, 4)
LLMS_SGMF(kernel_llms_mul_mv_f32_f32_sgmf8k_s8, float, float4, 8)

/* llms EXT_SGMH (make_dense_t4.py 17:1x; bench v8 of throughput/ds41_kbench_dq_kernels.metal): the 8-token dense Q8_0 matvec on HALF
 * simdgroup-matrix tiles, NRT x 8 weight rows per simdgroup sharing one activation tile, the blocks split over the NSG simdgroups
 * of a threadgroup, partial C tiles summed in a fixed order. The tile kernels are bound by the bytes through the core's load/store
 * port (4 KB per 8 rows x 32 k x 8 tokens in the float form); half tiles and shared activation tiles move 1.2-1.5 KB. Numerics:
 * w = q x d rounded to half, x clamped and rounded to half (the stock engine's prefill class), float accumulation: NLL-gated.
 * Grouped form (n_groups > 1, grid z): attn_output_a's 8 groups x [rank x group_dim]. n_tok must be 8. */
struct llms_sgmh_args { int K; int rows; int n_tok; int n_groups; ulong row_bytes; ulong group_bytes; ulong x_tok_stride; ulong x_group_stride; ulong dst_tok_stride; ulong dst_group_stride; };
template<short NSG, short NRT>
void kernel_llms_mul_mv_q8_sgmh_impl(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst,
                                     threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    constexpr short NR = NRT * 8;            // rows per threadgroup
    constexpr short LPR = 32 / NR;           // lanes per row
    constexpr short WPL = NR;                // weights per lane per block
    constexpr uint a_bytes = NR * 32 * 2, per_sg = a_bytes + 512;
    const int nb = args.K / 32;
    const int r0 = tgpig.x * NR;
    const uint g = tgpig.z;
    threadgroup char * As = shmem + sgitg * per_sg;                          // [NR][32] half
    threadgroup half * Bs = (threadgroup half *)(As + a_bytes);              // [32][8] half
    threadgroup float * Cs = (threadgroup float *)(shmem + NSG * per_sg);    // [sg][NR][8] float
    simdgroup_float8x8 C[NRT];
    FOR_UNROLL (short t = 0; t < NRT; t++) C[t] = make_filled_simdgroup_matrix<float, 8>(0.f);
    const short lr = tiisg / LPR, lq = tiisg % LPR;
    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
    device const char * xrow = src0 + (uint64_t)g * args.group_bytes + (uint64_t)rr * args.row_bytes;
    const short bt = tiisg / 4, bq = tiisg % 4;
    device const float4 * yt = (device const float4 *)(src1 + (uint64_t)g * args.x_group_stride + (uint64_t)bt * args.x_tok_stride) + bq * 2;
    threadgroup half4 * a4 = (threadgroup half4 *)(As + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
    threadgroup half * bs = Bs + (bq * 8) * 8 + bt;
    for (int ib = sgitg; ib < nb; ib += NSG) {
        device const char * b = xrow + (uint64_t)ib * 34u;
        const float d = (float)*(device const half *)b;
        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
        FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; a4[j] = half4(float4(q) * d); }
        const half4 x0 = half4(clamp(yt[ib * 8], -65504.0f, 65504.0f)), x1 = half4(clamp(yt[ib * 8 + 1], -65504.0f, 65504.0f));
        bs[0] = x0.x; bs[8] = x0.y; bs[16] = x0.z; bs[24] = x0.w; bs[32] = x1.x; bs[40] = x1.y; bs[48] = x1.z; bs[56] = x1.w;
        simdgroup_barrier(mem_flags::mem_threadgroup);
        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
            simdgroup_half8x8 B; simdgroup_load(B, Bs + kt * 64, 8);
            FOR_UNROLL (short t = 0; t < NRT; t++) { simdgroup_half8x8 A; simdgroup_load(A, (threadgroup half *)As + t * 8 * 32 + kt * 8, 32); simdgroup_multiply_accumulate(C[t], A, B, C[t]); }
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    FOR_UNROLL (short t = 0; t < NRT; t++) simdgroup_store(C[t], Cs + sgitg * (NR * 8) + t * 64, 8);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0) {
        for (short e = tiisg; e < NR * 8; e += 32) {
            float acc = Cs[e];
            for (short s = 1; s < NSG; s++) acc += Cs[s * (NR * 8) + e];
            const short row = e / 8, tok = e % 8;
            if (r0 + row < args.rows) ((device float *)(dst + (uint64_t)tok * args.dst_tok_stride + (uint64_t)g * args.dst_group_stride))[r0 + row] = acc;
        }
    }
}
#define LLMS_SGMH(NAME, NSG, NRT) \
kernel void NAME(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst, \
                 threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { \
    kernel_llms_mul_mv_q8_sgmh_impl<NSG, NRT>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
LLMS_SGMH(kernel_llms_mul_mv_q8_0_f32_sgmh_k8r2, 8, 2)
LLMS_SGMH(kernel_llms_mul_mv_q8_0_f32_sgmh_k8r4, 8, 4)
LLMS_SGMH(kernel_llms_mul_mv_q8_0_f32_sgmh_k4r4, 4, 4)
LLMS_SGMH(kernel_llms_mul_mv_q8_0_f32_sgmh_k2r4, 2, 4)

/* llms EXT_SGMF direct (17:1x): small F32 matrices (the router, 384 x 5,120) with BOTH tiles straight from device memory -- the * weight tile row-major with the row stride, the activation tile column-major from x[tok][k] (colmajor_probe.m). * No staging at all; K split over 8 simdgroups. 22 us for the router's shape against the staged tile kernel's 65. */
kernel void kernel_llms_mul_mv_f32_f32_direct_k8(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                 threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
    constexpr short NSG = 8;
    const int K = args.ne00;
    const int r0 = tgpig.x * 8;
    if (r0 + 8 > args.ne01) return;
    const ulong ws = args.nb01 / 4, xs = args.nb11 / 4;
    device const float * W = (device const float *)src0 + (uint64_t)r0 * ws;
    device const float * X = (device const float *)src1;
    threadgroup float * Cs = (threadgroup float *)shmem;
    simdgroup_float8x8 C = make_filled_simdgroup_matrix<float, 8>(0.f);
    for (int k = sgitg * 32; k < K; k += NSG * 32) {
        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
            simdgroup_float8x8 A, B;
            simdgroup_load(A, W + k + kt * 8, ws);
            simdgroup_load(B, X + k + kt * 8, xs, ulong2(0, 0), true);
            simdgroup_multiply_accumulate(C, A, B, C);
        }
    }
    simdgroup_store(C, Cs + sgitg * 64, 8);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0) {
        for (short e = tiisg; e < 64; e += 32) {
            float acc = Cs[e];
            for (short s = 1; s < NSG; s++) acc += Cs[s * 64 + e];
            const short row = e / 8, tok = e % 8;
            ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = acc;
        }
    }
}

/* llms ROUTE_DROP (make_dense_t4.py 17:4x): a FIDELITY DIAL, measurement only -- per token the smallest of the six route weights set
 * to zero (mode 1), or zeroed with the other five renormalized to the original sum (mode 2 = what top-5 routing would weigh). The
 * dropped expert is still loaded and computed (its mid is multiplied by zero): this prices the NLL of top-5, not its speed. */
kernel void kernel_llms_route_drop_min(device float * w [[buffer(0)]], constant uint & n_tok [[buffer(1)]], constant uint & mode [[buffer(2)]],
                                       uint gid [[thread_position_in_grid]]) {
    if (gid >= n_tok) return;
    device float * t = w + gid * 6u;
    if (mode >= 3000u) {   /* llms ROUTE_DROP threshold (apply_ds4_fidelity_dials.py): weights under tau x sum zeroed (never the largest), the rest renormalized */
        const float tau = (float)(mode - 3000u) * 1e-3f;
        uint jx = 0; float s6 = 0.0f;
        for (uint j = 0; j < 6; j++) { s6 += t[j]; if (t[j] > t[jx]) jx = j; }
        float kept = 0.0f;
        for (uint j = 0; j < 6; j++) if (j == jx || t[j] >= tau * s6) kept += t[j];
        const float rr = kept > 0.0f ? s6 / kept : 1.0f;
        for (uint j = 0; j < 6; j++) t[j] = (j == jx || t[j] >= tau * s6) ? t[j] * rr : 0.0f;
        return;
    }
    if (mode == 4u) {   /* llms ROUTE_DROP top-4 (apply_ds4_route_top4.py): the two smallest zeroed, the other four renormalized */
        uint j1 = 0; for (uint j = 1; j < 6; j++) if (t[j] < t[j1]) j1 = j;
        uint j2 = j1 == 0u ? 1u : 0u; for (uint j = 0; j < 6; j++) if (j != j1 && t[j] < t[j2]) j2 = j;
        float s6 = 0.0f; for (uint j = 0; j < 6; j++) s6 += t[j];
        const float kept = s6 - t[j1] - t[j2];
        const float rr = kept > 0.0f ? s6 / kept : 1.0f;
        for (uint j = 0; j < 6; j++) t[j] = (j == j1 || j == j2) ? 0.0f : t[j] * rr;
        return;
    }
    uint jm = 0; float wm = t[0], sum = t[0];
    for (uint j = 1; j < 6; j++) { sum += t[j]; if (t[j] < wm) { wm = t[j]; jm = j; } }
    const float r = (mode == 2u && sum > wm) ? sum / (sum - wm) : 1.0f;
    for (uint j = 0; j < 6; j++) t[j] = (j == jm) ? 0.0f : t[j] * r;
}

/* llms EXT_SGMH16 (make_dense_sgmh16.py): the half-tile kernel at sixteen tokens -- two activation tiles per staged weight tile */
template<short NSG, short NRT>
void kernel_llms_mul_mv_q8_sgmh16_impl(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst,
                                       threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    constexpr short NR = NRT * 8;
    constexpr short LPR = 32 / NR;
    constexpr short WPL = NR;
    constexpr uint a_bytes = NR * 32 * 2, b_bytes = 32 * 16 * 2, per_sg = a_bytes + b_bytes;
    const int nb = args.K / 32;
    const int r0 = tgpig.x * NR;
    const uint g = tgpig.z;
    threadgroup char * As = shmem + sgitg * per_sg;                          // [NR][32] half
    threadgroup half * Bs = (threadgroup half *)(As + a_bytes);              // [32 k][16 tok] half
    threadgroup float * Cs = (threadgroup float *)(shmem + NSG * per_sg);    // [sg][NR][16] float
    simdgroup_float8x8 C0[NRT], C1[NRT];
    FOR_UNROLL (short t = 0; t < NRT; t++) { C0[t] = make_filled_simdgroup_matrix<float, 8>(0.f); C1[t] = make_filled_simdgroup_matrix<float, 8>(0.f); }
    const short lr = tiisg / LPR, lq = tiisg % LPR;
    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
    device const char * xrow = src0 + (uint64_t)g * args.group_bytes + (uint64_t)rr * args.row_bytes;
    const short bt = tiisg / 4, bq = tiisg % 4;
    device const float4 * yt0 = (device const float4 *)(src1 + (uint64_t)g * args.x_group_stride + (uint64_t)bt * args.x_tok_stride) + bq * 2;
    device const float4 * yt1 = (device const float4 *)(src1 + (uint64_t)g * args.x_group_stride + (uint64_t)(bt + 8) * args.x_tok_stride) + bq * 2;
    threadgroup half4 * a4 = (threadgroup half4 *)(As + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
    threadgroup half * bs = Bs + (bq * 8) * 16 + bt;
    for (int ib = sgitg; ib < nb; ib += NSG) {
        device const char * b = xrow + (uint64_t)ib * 34u;
        const float d = (float)*(device const half *)b;
        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
        FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; a4[j] = half4(float4(q) * d); }
        const half4 x0 = half4(clamp(yt0[ib * 8], -65504.0f, 65504.0f)), x1 = half4(clamp(yt0[ib * 8 + 1], -65504.0f, 65504.0f));
        const half4 y0 = half4(clamp(yt1[ib * 8], -65504.0f, 65504.0f)), y1 = half4(clamp(yt1[ib * 8 + 1], -65504.0f, 65504.0f));
        bs[0] = x0.x; bs[16] = x0.y; bs[32] = x0.z; bs[48] = x0.w; bs[64] = x1.x; bs[80] = x1.y; bs[96] = x1.z; bs[112] = x1.w;
        bs[8] = y0.x; bs[24] = y0.y; bs[40] = y0.z; bs[56] = y0.w; bs[72] = y1.x; bs[88] = y1.y; bs[104] = y1.z; bs[120] = y1.w;
        simdgroup_barrier(mem_flags::mem_threadgroup);
        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
            simdgroup_half8x8 B0, B1;
            simdgroup_load(B0, Bs + kt * 128, 16);
            simdgroup_load(B1, Bs + kt * 128 + 8, 16);
            FOR_UNROLL (short t = 0; t < NRT; t++) {
                simdgroup_half8x8 A; simdgroup_load(A, (threadgroup half *)As + t * 8 * 32 + kt * 8, 32);
                simdgroup_multiply_accumulate(C0[t], A, B0, C0[t]);
                simdgroup_multiply_accumulate(C1[t], A, B1, C1[t]);
            }
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    FOR_UNROLL (short t = 0; t < NRT; t++) {
        simdgroup_store(C0[t], Cs + sgitg * (NR * 16) + t * 128, 16);
        simdgroup_store(C1[t], Cs + sgitg * (NR * 16) + t * 128 + 8, 16);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0) {
        for (short e = tiisg; e < NR * 16; e += 32) {
            float acc = Cs[e];
            for (short s = 1; s < NSG; s++) acc += Cs[s * (NR * 16) + e];
            const short row = e / 16, tok = e % 16;
            if (r0 + row < args.rows) ((device float *)(dst + (uint64_t)tok * args.dst_tok_stride + (uint64_t)g * args.dst_group_stride))[r0 + row] = acc;
        }
    }
}
#define LLMS_SGMH16(NAME, NSG, NRT) \
kernel void NAME(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst, \
                 threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { \
    kernel_llms_mul_mv_q8_sgmh16_impl<NSG, NRT>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
LLMS_SGMH16(kernel_llms_mul_mv_q8_0_f32_sgmh16_k8r2, 8, 2)
LLMS_SGMH16(kernel_llms_mul_mv_q8_0_f32_sgmh16_k4r2, 4, 2)
LLMS_SGMH16(kernel_llms_mul_mv_q8_0_f32_sgmh16_k4r4, 4, 4)
