/* llms SGMF32 (make_dense_t32a.py): the 8-row F16 / F32 tiles with FOUR token tiles (32 tokens) per staged weight tile; partials aliased */
template<typename TW, typename TW4, short NSG>
void kernel_llms_mul_mv_sgmf32_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
                                    threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    const int nb = args.ne00 / 32;
    const int r0 = tgpig.x * 8;
    threadgroup float * As = (threadgroup float *)shmem + sgitg * 256;                // [row 8][k 32]
    threadgroup float * Bs = (threadgroup float *)shmem + NSG * 256 + sgitg * 1024;   // [k 32][tok 32]
    threadgroup float * Cs = (threadgroup float *)shmem;                              // [sg][row 8][tok 32], aliased after the loop
    simdgroup_float8x8 C0 = make_filled_simdgroup_matrix<float, 8>(0.f), C1 = C0, C2 = C0, C3 = C0;
    const short lr = tiisg / 4, lq = tiisg % 4;
    const int rr = (r0 + lr < args.ne01) ? (r0 + lr) : (args.ne01 - 1);
    device const TW4 * xrow = (device const TW4 *)(src0 + (uint64_t)rr * args.nb01) + lq * 2;
    device const float4 * y0 = (device const float4 *)(src1 + (uint64_t)lr * args.nb11) + lq * 2;
    device const float4 * y1 = (device const float4 *)(src1 + (uint64_t)(lr + 8) * args.nb11) + lq * 2;
    device const float4 * y2 = (device const float4 *)(src1 + (uint64_t)(lr + 16) * args.nb11) + lq * 2;
    device const float4 * y3 = (device const float4 *)(src1 + (uint64_t)(lr + 24) * args.nb11) + lq * 2;
    threadgroup float4 * as4 = (threadgroup float4 *)(As + lr * 32 + lq * 8);
    threadgroup float * bs = Bs + (lq * 8) * 32 + lr;
    for (int ib = sgitg; ib < nb; ib += NSG) {
        const TW4 w0 = xrow[ib * 8], w1 = xrow[ib * 8 + 1];
        as4[0] = float4(w0); as4[1] = float4(w1);
        const float4 a0 = y0[ib * 8], a1 = y0[ib * 8 + 1], b0 = y1[ib * 8], b1 = y1[ib * 8 + 1], c0 = y2[ib * 8], c1 = y2[ib * 8 + 1], d0 = y3[ib * 8], d1 = y3[ib * 8 + 1];
        bs[0] = a0.x; bs[32] = a0.y; bs[64] = a0.z; bs[96] = a0.w; bs[128] = a1.x; bs[160] = a1.y; bs[192] = a1.z; bs[224] = a1.w;
        bs[8] = b0.x; bs[40] = b0.y; bs[72] = b0.z; bs[104] = b0.w; bs[136] = b1.x; bs[168] = b1.y; bs[200] = b1.z; bs[232] = b1.w;
        bs[16] = c0.x; bs[48] = c0.y; bs[80] = c0.z; bs[112] = c0.w; bs[144] = c1.x; bs[176] = c1.y; bs[208] = c1.z; bs[240] = c1.w;
        bs[24] = d0.x; bs[56] = d0.y; bs[88] = d0.z; bs[120] = d0.w; bs[152] = d1.x; bs[184] = d1.y; bs[216] = d1.z; bs[248] = d1.w;
        simdgroup_barrier(mem_flags::mem_threadgroup);
        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
            simdgroup_float8x8 A, B0, B1, B2, B3;
            simdgroup_load(A, As + kt * 8, 32);
            simdgroup_load(B0, Bs + kt * 256, 32); simdgroup_load(B1, Bs + kt * 256 + 8, 32);
            simdgroup_load(B2, Bs + kt * 256 + 16, 32); simdgroup_load(B3, Bs + kt * 256 + 24, 32);
            simdgroup_multiply_accumulate(C0, A, B0, C0); simdgroup_multiply_accumulate(C1, A, B1, C1);
            simdgroup_multiply_accumulate(C2, A, B2, C2); simdgroup_multiply_accumulate(C3, A, B3, C3);
        }
        simdgroup_barrier(mem_flags::mem_threadgroup);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);   /* the partials reuse the tiles */
    simdgroup_store(C0, Cs + sgitg * 256, 32); simdgroup_store(C1, Cs + sgitg * 256 + 8, 32);
    simdgroup_store(C2, Cs + sgitg * 256 + 16, 32); simdgroup_store(C3, Cs + sgitg * 256 + 24, 32);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0) {
        for (short e = tiisg; e < 256; e += 32) {
            float acc = Cs[e];
            for (short s = 1; s < NSG; s++) acc += Cs[s * 256 + e];
            const short row = e / 32, tok = e % 32;
            if (r0 + row < args.ne01) ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = acc;
        }
    }
}
