            simdgroup_load(A, As + (8 * sgitg) * 32 + kt * 8, 32);
            simdgroup_load(B, Bs + kt * 64, 8);
            simdgroup_multiply_accumulate(C, A, B, C);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    simdgroup_store(C, Cs + sgitg * 64, 8);
    simdgroup_barrier(mem_flags::mem_threadgroup);
    for (short e = tiisg; e < 64; e += 32) {
        const short row = e / 8, tok = e % 8;
        const int orow = first_row + 8 * sgitg + row;
        if (orow < args.ne0 && en[tok] != 0xFFFFFFFFu) ((device float *)(parts + ((uint64_t)tgpig.z * 8u + (uint64_t)tok) * (uint64_t)args.ne0 * sizeof(float)))[orow] = Cs[sgitg * 64 + e];
    }
}

/* llms BS6C (make_moe_bs6c.py): routed gate/up on the plain 2-bit G32/4 side file, bit-serial over activation planes. */
#define LLMS_BS6C_ROWB 1520u
kernel void kernel_llms_bs6c_xplanes(device const float * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
                                     constant uint4 & p [[buffer(3)]], uint2 gid [[thread_position_in_grid]]) {
    /* p.x = tokens, p.y = token stride in floats, p.z = planes (NPL); one thread per (sub-block gid.x < 160, token gid.y) */
    if (gid.x >= 160u || gid.y >= p.x) return;
    device const float * xr = src1 + (uint64_t)gid.y * p.y + 32u * gid.x;
    float v[32]; float a = 0.f;
    for (int i = 0; i < 32; i++) { v[i] = xr[i]; a = max(a, fabs(v[i])); }
    const float qmax = float((1u << (p.z - 1u)) - 1u);
    const float sc = a > 0.f ? a / qmax : 1.f;
    uint pl[8] = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}; int sum = 0;
    const uint msk = (1u << p.z) - 1u;
    if (p.z == 5u) {   /* llms UNROLL: production's NPL as a compile-time 5 -- pl[b] fixed registers, no select chains */
        FOR_UNROLL (int i = 0; i < 32; i++) {
            const int q = (int)rint(v[i] / sc); sum += q;
            const uint u = (uint)q & 31u;
            FOR_UNROLL (uint b = 0; b < 5u; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
        }
    } else
    for (int i = 0; i < 32; i++) {
        const int q = (int)rint(v[i] / sc); sum += q;
        const uint u = (uint)q & msk;
        for (uint b = 0; b < p.z; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
    }
    device uint * o = XP + ((uint64_t)gid.y * 160u + gid.x) * 8u;
    for (int b = 0; b < 8; b++) o[b] = pl[b];
    XS[(uint64_t)gid.y * 160u + gid.x] = float2(sc, sc * (float)sum);
}
template <int K, typename ET, int NPL, bool CANARY>
static inline void llms_bs6c_impl(constant ds4_metal_args_mul_mv_id & args, constant ds4_metal_dsv4_moe_swiglu_weight_args & act,
        device const uint64_t * gate_addrs, device const uint64_t * up_addrs, device char * dst_gate, device char * dst_up, device char * dst_mid,
        device const char * ids, device const char * weights, device const ET * entries, device const uint * XP, device const float2 * XS,
        threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
    constexpr int V = 2 * K, NSGV = 5, RTG = 32;
    const ET en = entries[tgpig.z];
    uint pn[K]; int nrow = K;
    const uint4 e4 = llms_cf_en(en);
    if (K == 4) { nrow = e4.w != 0xFFFFFFFFu ? 4 : 3; pn[0] = e4.x; pn[1 % K] = e4.y; pn[2 % K] = e4.z; pn[K - 1] = nrow == 4 ? e4.w : e4.x; }
    else if (K == 2) { nrow = e4.y != 0xFFFFFFFFu ? 2 : 1; pn[0] = e4.x; pn[K - 1] = nrow == 2 ? e4.y : e4.x; }
    else { nrow = 1; pn[0] = e4.x; }
    const bool full = nrow == K;
    int iid1[K], idx[K];
    for (int k = 0; k < K; ++k) { iid1[k] = (int)(pn[k] / (uint)args.nei0); idx[k] = (int)(pn[k] % (uint)args.nei0); }
    const int32_t i02 = ((device const int32_t *)(ids + iid1[0] * args.nbi1))[idx[0]];
    if (i02 < 0 || i02 >= args.ne02 || i02 >= 384) return;
    const uint64_t gate_addr = gate_addrs[(uint)i02], up_addr = up_addrs[(uint)i02];
    if (gate_addr == 0 || up_addr == 0) return;
    threadgroup float * part = (threadgroup float *)shmem;   // [RTG][V][NSGV]
    const ushort tid = sgitg * 32 + tiisg, nthr = 32 * NSGV;   // the lane's sub-block of 32 inputs, 0..159
    uint B[K][NPL]; float sx[K], sm[K];
    for (int t = 0; t < K; t++) {
        device const uint * xp = XP + ((uint64_t)iid1[t] * 160u + tid) * 8u;
        for (int p = 0; p < NPL; p++) B[t][p] = xp[p];
        const float2 s2 = XS[(uint64_t)iid1[t] * 160u + tid]; sx[t] = s2.x; sm[t] = s2.y;
    }
    const int r0 = tgpig.x * RTG;
    device const uchar * gb = reinterpret_cast<device const uchar *>(gate_addr) + (uint64_t)r0 * LLMS_BS6C_ROWB;
    device const uchar * ub = reinterpret_cast<device const uchar *>(up_addr) + (uint64_t)r0 * LLMS_BS6C_ROWB;
    for (int r = 0; r < RTG; r++) {
        device const uchar * gr = gb + (uint64_t)r * LLMS_BS6C_ROWB;
        device const uchar * ur = ub + (uint64_t)r * LLMS_BS6C_ROWB;
        uint2 qg = *(device const uint2 *)(gr + 8u * tid), qu = *(device const uint2 *)(ur + 8u * tid);
        if (CANARY) { qg = qg.yx; qu = qu.yx; }
        const uint cg = gr[1280u + tid], cu = ur[1280u + tid];
        const float2 Dg = float2(*(device const half2 *)(gr + 1440u + 4u * (tid >> 3))), Du = float2(*(device const half2 *)(ur + 1440u + 4u * (tid >> 3)));
        const float gsx = Dg.x * float(cg & 15u), gsm = -Dg.y * float(cg >> 4), usx = Du.x * float(cu & 15u), usm = -Du.y * float(cu >> 4);
        float v[V];
        for (int t = 0; t < K; t++) {
            int ag = -(int)(2u * popcount(qg.y & B[t][NPL - 1]) + popcount(qg.x & B[t][NPL - 1]));
            int au = -(int)(2u * popcount(qu.y & B[t][NPL - 1]) + popcount(qu.x & B[t][NPL - 1]));
            for (int p = NPL - 2; p >= 0; p--) {
                ag = 2 * ag + (int)(2u * popcount(qg.y & B[t][p]) + popcount(qg.x & B[t][p]));
                au = 2 * au + (int)(2u * popcount(qu.y & B[t][p]) + popcount(qu.x & B[t][p]));
            }
            v[t] = gsx * float(ag) * sx[t] + gsm * sm[t];
            v[K + t] = usx * float(au) * sx[t] + usm * sm[t];
        }
        ushort off = 16;
        for (int h = V / 2; h >= 1; h /= 2, off >>= 1) {
            const bool up = (tiisg & off) != 0;
            for (int i = 0; i < h; i++) { const float send = up ? v[i] : v[i + h], keep = up ? v[i + h] : v[i]; v[i] = keep + simd_shuffle_xor(send, off); }
        }
        for (; off >= 1; off >>= 1) v[0] += simd_shuffle_xor(v[0], off);
        constexpr int LV = V == 2 ? 1 : V == 4 ? 2 : 3;
        if ((tiisg & ((1 << (5 - LV)) - 1)) == 0) part[(r * V + (tiisg >> (5 - LV))) * NSGV + sgitg] = v[0];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    const float c = act.clamp_value;
    for (int e = tid; e < RTG * K; e += nthr) {
        const int r = e / K, t = e % K;
        if (t == K - 1 && !full) continue;
        float g = 0.f, u = 0.f;
        for (int q = 0; q < NSGV; q++) { g += part[(r * V + t) * NSGV + q]; u += part[(r * V + K + t) * NSGV + q]; }
        const uint out_row = (uint)(r0 + r);
        ((device float *)(dst_gate + (idx[t] * args.ne0 + iid1[t] * args.ne1 * args.ne0) * sizeof(float)))[out_row] = g;
        ((device float *)(dst_up   + (idx[t] * args.ne0 + iid1[t] * args.ne1 * args.ne0) * sizeof(float)))[out_row] = u;
        const uint64_t pair_row = (uint64_t)iid1[t] * (uint64_t)args.nei0 + (uint64_t)idx[t];
        device float * mid_f32 = (device float *)(dst_mid + pair_row * act.mid_row_stride);
        const float route_weight = ((device const float *)(weights + pair_row * act.weight_stride))[0];
        if (c > 1.0e-6f) { g = min(g, c); u = clamp(u, -c, c); }
        const float silu = g / (1.0f + exp(-g));
        mid_f32[out_row] = silu * u * route_weight;
    }
}
