/* llms DOWN_COL (make_moe_col.py): the routed down projection (Q2_K, six experts summed per token) in column runs of 32 rows */
#define LLMS_COL_YLOAD(J) \
    const float4 y##J##0 = *(device const packed_float4 *)(yp + 32 * J + 0), y##J##1 = *(device const packed_float4 *)(yp + 32 * J + 4), \
                 y##J##2 = *(device const packed_float4 *)(yp + 32 * J + 8), y##J##3 = *(device const packed_float4 *)(yp + 32 * J + 12); \
    const float4 ys##J = y##J##0 + y##J##1 + y##J##2 + y##J##3; const float sy##J = ys##J.x + ys##J.y + ys##J.z + ys##J.w;
#define LLMS_COL_SUB(J, KJ) { \
    const uint4 m = mk << (uint)(2 * J); \
    const float4 a4 = y##J##0 * float4(uint4(q.x) & m) + y##J##1 * float4(uint4(q.y) & m) + y##J##2 * float4(uint4(q.z) & m) + y##J##3 * float4(uint4(q.w) & m); \
    const uint scb = (scw[J >> 1] >> (sh + 16u * (J & 1))) & 0xFFu; \
    accd += (float)(scb & 0xFu) * (dot(a4, ksc) * KJ); \
    accm += (float)(scb >> 4) * sy##J; }
