/* llms DEDUP (make_moe_dedup.py): two (row, slot) pairs of the same expert in one threadgroup, one decode, two dot products */
template<int nr0>
void kernel_mul_mv_iq2_xxs_pair_h_pre2_impl(
        ds4_metal_args_mul_mv args,
        device const char * src0_gate,
        device const char * src0_up,
        device const half * yhA_base,
        device const half * yhB_base,      /* nullptr-like: equal to yhA_base when there is no second row (its sums are discarded) */
        device       char * dst_gateA, device char * dst_upA,
        device       char * dst_gateB, device char * dst_upB,
        const bool two,
        threadgroup  char * shmem,
        uint3  tgpig,
        ushort tiisg,
        ushort sgitg) {
    const short NSG = FC_mul_mv_nsg;
    const int nb = args.ne00/QK_K;
    const int r0 = tgpig.x;
    const int first_row = (r0 * NSG + sgitg) * nr0;
    const uint64_t offset0 = first_row*args.nb01;
    device const block_iq2_xxs * xg = (device const block_iq2_xxs *) (src0_gate + offset0);
    device const block_iq2_xxs * xu = (device const block_iq2_xxs *) (src0_up   + offset0);

    threadgroup half4   * sgrid = (threadgroup half4 *)shmem;
    threadgroup ushort4 * smask = (threadgroup ushort4 *)(sgrid + 512);
    const ushort tid = sgitg * 32 + tiisg;
    const ushort nthr = 32 * NSG;
    for (ushort gi = tid; gi < 256; gi += nthr) {
        const ulong gv = ds4_metal_iq2xxs_grid[gi];
        half4 lo, hi;
        for (short j = 0; j < 4; ++j) { lo[j] = (half)((gv >> (8 * j)) & 0xFF); hi[j] = (half)((gv >> (8 * (j + 4))) & 0xFF); }
        sgrid[2 * gi] = lo; sgrid[2 * gi + 1] = hi;
    }
    for (ushort si = tid; si < 128; si += nthr) {
        const uchar sb = ds4_metal_ksigns_iq2xs[si];
        ushort4 lo, hi;
        for (short j = 0; j < 4; ++j) { lo[j] = ((sb >> j) & 1) ? 0x8000 : 0; hi[j] = ((sb >> (j + 4)) & 1) ? 0x8000 : 0; }
        smask[2 * si] = lo; smask[2 * si + 1] = hi;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    float sumgA[nr0]={0.f}, sumuA[nr0]={0.f}, sumgB[nr0]={0.f}, sumuB[nr0]={0.f};
    const int nb32 = nb * (QK_K / 32);
    const int ix = tiisg;
    device const half4 * yA4 = (device const half4 *)(yhA_base + 32 * ix);
    device const half4 * yB4 = (device const half4 *)(yhB_base + 32 * ix);
    const int rstride = args.nb01/2;

    for (int ib32 = ix; ib32 < nb32; ib32 += 32) {
        half4 yA[8], yB[8];
        for (short i = 0; i < 8; ++i) yA[i] = yA4[i];
        if (two) { for (short i = 0; i < 8; ++i) yB[i] = yB4[i]; }
        const int ibl = ib32 / (QK_K / 32);
        const int ib  = ib32 % (QK_K / 32);
        device const uint16_t * qg = (xg + ibl)->qs + 4 * ib;
        device const uint16_t * qu = (xu + ibl)->qs + 4 * ib;
        device const half * dhg = &(xg + ibl)->d;
        device const half * dhu = &(xu + ibl)->d;
        for (short row = 0; row < nr0; row++) {
            const uint32_t a0g = qg[0] | (qg[1] << 16), a1g = qg[2] | (qg[3] << 16);
            const uint32_t a0u = qu[0] | (qu[1] << 16), a1u = qu[2] | (qu[3] << 16);
            const float dg = (float)dhg[0] * (0.5f + (a1g >> 28));
            const float du = (float)dhu[0] * (0.5f + (a1u >> 28));
            float sgA = 0, suA = 0, sgB = 0, suB = 0;
            for (short l = 0; l < 4; ++l) {
                const uint gidg = (a0g >> (8 * l)) & 0xFF, gidu = (a0u >> (8 * l)) & 0xFF;
                const uint sidg = (a1g >> (7 * l)) & 127,  sidu = (a1u >> (7 * l)) & 127;
                half4 g0, g1, u0, u1;
                if (LLMS_W16) {   /* llms IQ2_W16 (make_moe_w16b.py): one 16-byte load per grid point and per sign mask; the same bits as the four 8-byte loads */
                    const bool llms_keep = !(LLMS_W16 == 2 && l == 3);   /* 2 = canary: the last group's signs not applied */
                    const uint4 llms_gg = ((threadgroup const uint4 *)sgrid)[gidg] ^ (llms_keep ? ((threadgroup const uint4 *)smask)[sidg] : uint4(0u));
                    const uint4 llms_gu = ((threadgroup const uint4 *)sgrid)[gidu] ^ (llms_keep ? ((threadgroup const uint4 *)smask)[sidu] : uint4(0u));
                    g0 = as_type<half4>(llms_gg.xy); g1 = as_type<half4>(llms_gg.zw); u0 = as_type<half4>(llms_gu.xy); u1 = as_type<half4>(llms_gu.zw);
                } else {
                    g0 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidg])     ^ smask[2 * sidg]);
                    g1 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidg + 1]) ^ smask[2 * sidg + 1]);
                    u0 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidu])     ^ smask[2 * sidu]);
                    u1 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidu + 1]) ^ smask[2 * sidu + 1]);
                }
                sgA += (float)(dot(yA[2 * l], g0) + dot(yA[2 * l + 1], g1));
                suA += (float)(dot(yA[2 * l], u0) + dot(yA[2 * l + 1], u1));
                if (two) {
                    sgB += (float)(dot(yB[2 * l], g0) + dot(yB[2 * l + 1], g1));
                    suB += (float)(dot(yB[2 * l], u0) + dot(yB[2 * l + 1], u1));
                }
            }
            sumgA[row] += dg * sgA; sumuA[row] += du * suA;
            if (two) { sumgB[row] += dg * sgB; sumuB[row] += du * suB; }
            dhg += rstride; dhu += rstride; qg += rstride; qu += rstride;
        }
        yA4 += 8 * 32; yB4 += 8 * 32;
    }
    device float * gA = (device float *) dst_gateA; device float * uA = (device float *) dst_upA;
    device float * gB = (device float *) dst_gateB; device float * uB = (device float *) dst_upB;
    for (int row = 0; row < nr0 && first_row + row < args.ne0; ++row) {
        const float sga = simd_sum(sumgA[row]), sua = simd_sum(sumuA[row]);
        float sgb = 0.f, sub = 0.f;
        if (two) { sgb = simd_sum(sumgB[row]); sub = simd_sum(sumuB[row]); }
        if (tiisg == 0) {
            gA[first_row + row] = sga * 0.25f; uA[first_row + row] = sua * 0.25f;
            if (two) { gB[first_row + row] = sgb * 0.25f; uB[first_row + row] = sub * 0.25f; }
        }
    }
}

kernel void kernel_mul_mv_addr_iq2_xxs_pair_swiglu_dedup_h_f32(
        constant ds4_metal_args_mul_mv_id & args,
        constant ds4_metal_dsv4_moe_swiglu_weight_args & act,
        device const uint64_t * gate_addrs,
        device const uint64_t * up_addrs,
        device const char * src1,
        device       char * dst_gate,
        device       char * dst_up,
        device       char * dst_mid,
        device const char * ids,
        device const char * weights,
        device const uint2 * entries [[buffer(10)]],
        device const half * src1h [[buffer(11)]],
        threadgroup  char * shmem [[threadgroup(0)]],
        uint3  tgpig[[threadgroup_position_in_grid]],
        ushort tiisg[[thread_index_in_simdgroup]],
        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
    const uint2 en = entries[tgpig.z];
    const bool two_real = en.y != 0xFFFFFFFFu;
    const bool two = LLMS_DD2C == 1 ? true : LLMS_DD2C == 2 ? false : two_real;   /* llms DD2C: compile time when the constant is set */
    const int iid1A = (int)(en.x / (uint)args.nei0), idxA = (int)(en.x % (uint)args.nei0);
    const int iid1B = two_real ? (int)(en.y / (uint)args.nei0) : iid1A, idxB = two_real ? (int)(en.y % (uint)args.nei0) : idxA;
    tgpig.z = 0;
    const int32_t i02 = ((device const int32_t *)(ids + iid1A * args.nbi1))[idxA];
    if (i02 < 0 || i02 >= args.ne02 || i02 >= 384) return;
    const uint64_t gate_addr = gate_addrs[(uint)i02], up_addr = up_addrs[(uint)i02];
    if (gate_addr == 0 || up_addr == 0) return;
    device const half *yhA = src1h + ((idxA % args.ne11) * args.nb11 + (uint64_t)iid1A * args.nb12) / sizeof(float);
    device const half *yhB = src1h + ((idxB % args.ne11) * args.nb11 + (uint64_t)iid1B * args.nb12) / sizeof(float);
    device char *dgA = dst_gate + (idxA * args.ne0 + iid1A * args.ne1 * args.ne0) * sizeof(float);
    device char *duA = dst_up   + (idxA * args.ne0 + iid1A * args.ne1 * args.ne0) * sizeof(float);
    device char *dgB = dst_gate + (idxB * args.ne0 + iid1B * args.ne1 * args.ne0) * sizeof(float);
    device char *duB = dst_up   + (idxB * args.ne0 + iid1B * args.ne1 * args.ne0) * sizeof(float);
    ds4_metal_args_mul_mv args0 = {
        args.ne00, args.ne01, 1,
        args.nb00, args.nb01, args.nb02, args.nb02,
        args.ne10, 1, 1,
        args.nb10, args.nb11, args.nb12, args.nb12,
        args.ne0, 1, args.nr0, 1, 1,
    };
    kernel_mul_mv_iq2_xxs_pair_h_pre2_impl<N_R0_IQ2_XXS>(args0,
        reinterpret_cast<device const char *>(gate_addr), reinterpret_cast<device const char *>(up_addr),
        yhA, yhB, dgA, duA, dgB, duB, two, shmem, tgpig, tiisg, sgitg);

    /* the same SwiGLU epilogue as the pair kernel, once per row of the entry */
    const short NSG = FC_mul_mv_nsg;
    const int first_row = (tgpig.x * NSG + sgitg) * N_R0_IQ2_XXS;
    const float c = act.clamp_value;
    for (int which = 0; which < (two ? 2 : 1); ++which) {
        const int iid1 = which ? iid1B : iid1A, idx = which ? idxB : idxA;
        device float *gate_f32 = (device float *)(dst_gate + (idx * args.ne0 + iid1 * args.ne1 * args.ne0) * sizeof(float));
        device float *up_f32 = (device float *)(dst_up + (idx * args.ne0 + iid1 * args.ne1 * args.ne0) * sizeof(float));
        const uint64_t pair_row = (uint64_t)iid1 * (uint64_t)args.nei0 + (uint64_t)idx;
        device float *mid_f32 = (device float *)(dst_mid + pair_row * act.mid_row_stride);
        device const float *route_w = (device const float *)(weights + pair_row * act.weight_stride);
        const float route_weight = route_w[0];
        if (tiisg == 0) {
            for (int row = 0; row < N_R0_IQ2_XXS && first_row + row < args.ne0; ++row) {
                const uint out_row = first_row + row;
                float g = gate_f32[out_row];
                float u = up_f32[out_row];
                if (c > 1.0e-6f) {
                    g = min(g, c);
                    u = clamp(u, -c, c);
                }
                const float silu = g / (1.0f + exp(-g));
                mid_f32[out_row] = silu * u * route_weight;
            }
        }
    }
}

/* llms DEDUP4 (make_moe_q4.py): three or four (row, slot) pairs of the same expert in one threadgroup, one decode */
template<int nr0>
void kernel_mul_mv_iq2_xxs_pair_h_pre4_impl(
        ds4_metal_args_mul_mv args,
        device const char * src0_gate,
        device const char * src0_up,
        device const half * yhA_base, device const half * yhB_base, device const half * yhC_base, device const half * yhD_base,
        device       char * dst_gateA, device char * dst_upA,
        device       char * dst_gateB, device char * dst_upB,
        device       char * dst_gateC, device char * dst_upC,
        device       char * dst_gateD, device char * dst_upD,
        const bool four,
        threadgroup  char * shmem,
        uint3  tgpig,
        ushort tiisg,
        ushort sgitg) {
    const short NSG = FC_mul_mv_nsg;
    const int nb = args.ne00/QK_K;
    const int r0 = tgpig.x;
    const int first_row = (r0 * NSG + sgitg) * nr0;
    const uint64_t offset0 = first_row*args.nb01;
    device const block_iq2_xxs * xg = (device const block_iq2_xxs *) (src0_gate + offset0);
    device const block_iq2_xxs * xu = (device const block_iq2_xxs *) (src0_up   + offset0);

    threadgroup half4   * sgrid = (threadgroup half4 *)shmem;
    threadgroup ushort4 * smask = (threadgroup ushort4 *)(sgrid + 512);
    const ushort tid = sgitg * 32 + tiisg;
    const ushort nthr = 32 * NSG;
    for (ushort gi = tid; gi < 256; gi += nthr) {
        const ulong gv = ds4_metal_iq2xxs_grid[gi];
        half4 lo, hi;
        for (short j = 0; j < 4; ++j) { lo[j] = (half)((gv >> (8 * j)) & 0xFF); hi[j] = (half)((gv >> (8 * (j + 4))) & 0xFF); }
        sgrid[2 * gi] = lo; sgrid[2 * gi + 1] = hi;
    }
    for (ushort si = tid; si < 128; si += nthr) {
        const uchar sb = ds4_metal_ksigns_iq2xs[si];
        ushort4 lo, hi;
        for (short j = 0; j < 4; ++j) { lo[j] = ((sb >> j) & 1) ? 0x8000 : 0; hi[j] = ((sb >> (j + 4)) & 1) ? 0x8000 : 0; }
        smask[2 * si] = lo; smask[2 * si + 1] = hi;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    float sumgA[nr0]={0.f}, sumuA[nr0]={0.f}, sumgB[nr0]={0.f}, sumuB[nr0]={0.f};
    float sumgC[nr0]={0.f}, sumuC[nr0]={0.f}, sumgD[nr0]={0.f}, sumuD[nr0]={0.f};
    const int nb32 = nb * (QK_K / 32);
    const int ix = tiisg;
    device const half4 * yA4 = (device const half4 *)(yhA_base + 32 * ix);
    device const half4 * yB4 = (device const half4 *)(yhB_base + 32 * ix);
    device const half4 * yC4 = (device const half4 *)(yhC_base + 32 * ix);
    device const half4 * yD4 = (device const half4 *)(yhD_base + 32 * ix);
    const int rstride = args.nb01/2;

    for (int ib32 = ix; ib32 < nb32; ib32 += 32) {
        half4 yA[8], yB[8], yC[8], yD[8];
        for (short i = 0; i < 8; ++i) yA[i] = yA4[i];
        for (short i = 0; i < 8; ++i) yB[i] = yB4[i];
        for (short i = 0; i < 8; ++i) yC[i] = yC4[i];
        if (four) { for (short i = 0; i < 8; ++i) yD[i] = yD4[i]; }
        const int ibl = ib32 / (QK_K / 32);
        const int ib  = ib32 % (QK_K / 32);
        device const uint16_t * qg = (xg + ibl)->qs + 4 * ib;
        device const uint16_t * qu = (xu + ibl)->qs + 4 * ib;
        device const half * dhg = &(xg + ibl)->d;
        device const half * dhu = &(xu + ibl)->d;
        for (short row = 0; row < nr0; row++) {
            const uint32_t a0g = qg[0] | (qg[1] << 16), a1g = qg[2] | (qg[3] << 16);
            const uint32_t a0u = qu[0] | (qu[1] << 16), a1u = qu[2] | (qu[3] << 16);
            const float dg = (float)dhg[0] * (0.5f + (a1g >> 28));
            const float du = (float)dhu[0] * (0.5f + (a1u >> 28));
            float sgA = 0, suA = 0, sgB = 0, suB = 0, sgC = 0, suC = 0, sgD = 0, suD = 0;
            for (short l = 0; l < 4; ++l) {
                const uint gidg = (a0g >> (8 * l)) & 0xFF, gidu = (a0u >> (8 * l)) & 0xFF;
                const uint sidg = (a1g >> (7 * l)) & 127,  sidu = (a1u >> (7 * l)) & 127;
                half4 g0, g1, u0, u1;
                if (LLMS_W16) {   /* llms IQ2_W16 (make_moe_w16b.py): one 16-byte load per grid point and per sign mask; the same bits as the four 8-byte loads */
                    const bool llms_keep = !(LLMS_W16 == 2 && l == 3);   /* 2 = canary: the last group's signs not applied */
                    const uint4 llms_gg = ((threadgroup const uint4 *)sgrid)[gidg] ^ (llms_keep ? ((threadgroup const uint4 *)smask)[sidg] : uint4(0u));
                    const uint4 llms_gu = ((threadgroup const uint4 *)sgrid)[gidu] ^ (llms_keep ? ((threadgroup const uint4 *)smask)[sidu] : uint4(0u));
                    g0 = as_type<half4>(llms_gg.xy); g1 = as_type<half4>(llms_gg.zw); u0 = as_type<half4>(llms_gu.xy); u1 = as_type<half4>(llms_gu.zw);
                } else {
                    g0 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidg])     ^ smask[2 * sidg]);
                    g1 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidg + 1]) ^ smask[2 * sidg + 1]);
                    u0 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidu])     ^ smask[2 * sidu]);
                    u1 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidu + 1]) ^ smask[2 * sidu + 1]);
                }
                sgA += (float)(dot(yA[2 * l], g0) + dot(yA[2 * l + 1], g1));
                suA += (float)(dot(yA[2 * l], u0) + dot(yA[2 * l + 1], u1));
                sgB += (float)(dot(yB[2 * l], g0) + dot(yB[2 * l + 1], g1));
                suB += (float)(dot(yB[2 * l], u0) + dot(yB[2 * l + 1], u1));
                sgC += (float)(dot(yC[2 * l], g0) + dot(yC[2 * l + 1], g1));
                suC += (float)(dot(yC[2 * l], u0) + dot(yC[2 * l + 1], u1));
                if (four) {
                    sgD += (float)(dot(yD[2 * l], g0) + dot(yD[2 * l + 1], g1));
                    suD += (float)(dot(yD[2 * l], u0) + dot(yD[2 * l + 1], u1));
                }
            }
            sumgA[row] += dg * sgA; sumuA[row] += du * suA;
            sumgB[row] += dg * sgB; sumuB[row] += du * suB;
            sumgC[row] += dg * sgC; sumuC[row] += du * suC;
            if (four) { sumgD[row] += dg * sgD; sumuD[row] += du * suD; }
            dhg += rstride; dhu += rstride; qg += rstride; qu += rstride;
        }
        yA4 += 8 * 32; yB4 += 8 * 32; yC4 += 8 * 32; yD4 += 8 * 32;
    }
    device float * gA = (device float *) dst_gateA; device float * uA = (device float *) dst_upA;
    device float * gB = (device float *) dst_gateB; device float * uB = (device float *) dst_upB;
    device float * gC = (device float *) dst_gateC; device float * uC = (device float *) dst_upC;
    device float * gD = (device float *) dst_gateD; device float * uD = (device float *) dst_upD;
    for (int row = 0; row < nr0 && first_row + row < args.ne0; ++row) {
        const float sga = simd_sum(sumgA[row]), sua = simd_sum(sumuA[row]);
        const float sgb = simd_sum(sumgB[row]), sub = simd_sum(sumuB[row]);
        const float sgc = simd_sum(sumgC[row]), suc = simd_sum(sumuC[row]);
        float sgd = 0.f, sud = 0.f;
        if (four) { sgd = simd_sum(sumgD[row]); sud = simd_sum(sumuD[row]); }
        if (tiisg == 0) {
            gA[first_row + row] = sga * 0.25f; uA[first_row + row] = sua * 0.25f;
            gB[first_row + row] = sgb * 0.25f; uB[first_row + row] = sub * 0.25f;
            gC[first_row + row] = sgc * 0.25f; uC[first_row + row] = suc * 0.25f;
            if (four) { gD[first_row + row] = sgd * 0.25f; uD[first_row + row] = sud * 0.25f; }
        }
    }
}

kernel void kernel_mul_mv_addr_iq2_xxs_pair_swiglu_dedup4_h_f32(
        constant ds4_metal_args_mul_mv_id & args,
        constant ds4_metal_dsv4_moe_swiglu_weight_args & act,
        device const uint64_t * gate_addrs,
        device const uint64_t * up_addrs,
        device const char * src1,
        device       char * dst_gate,
        device       char * dst_up,
        device       char * dst_mid,
        device const char * ids,
        device const char * weights,
        device const uint4 * entries [[buffer(10)]],
        device const half * src1h [[buffer(11)]],
        threadgroup  char * shmem [[threadgroup(0)]],
        uint3  tgpig[[threadgroup_position_in_grid]],
        ushort tiisg[[thread_index_in_simdgroup]],
        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
    const uint4 en = entries[tgpig.z];
    const bool four = en.w != 0xFFFFFFFFu;
    const uint pn[4] = { en.x, en.y, en.z, four ? en.w : en.x };
    int iid1[4], idx[4];
    for (int k = 0; k < 4; ++k) { iid1[k] = (int)(pn[k] / (uint)args.nei0); idx[k] = (int)(pn[k] % (uint)args.nei0); }
    tgpig.z = 0;
    const int32_t i02 = ((device const int32_t *)(ids + iid1[0] * args.nbi1))[idx[0]];
    if (i02 < 0 || i02 >= args.ne02 || i02 >= 384) return;
    const uint64_t gate_addr = gate_addrs[(uint)i02], up_addr = up_addrs[(uint)i02];
    if (gate_addr == 0 || up_addr == 0) return;
    device const half *yh[4];
    device char *dg[4], *du[4];
    for (int k = 0; k < 4; ++k) {
        yh[k] = src1h + ((idx[k] % args.ne11) * args.nb11 + (uint64_t)iid1[k] * args.nb12) / sizeof(float);
        dg[k] = dst_gate + (idx[k] * args.ne0 + iid1[k] * args.ne1 * args.ne0) * sizeof(float);
        du[k] = dst_up   + (idx[k] * args.ne0 + iid1[k] * args.ne1 * args.ne0) * sizeof(float);
    }
    ds4_metal_args_mul_mv args0 = {
        args.ne00, args.ne01, 1,
        args.nb00, args.nb01, args.nb02, args.nb02,
        args.ne10, 1, 1,
        args.nb10, args.nb11, args.nb12, args.nb12,
        args.ne0, 1, args.nr0, 1, 1,
    };
    kernel_mul_mv_iq2_xxs_pair_h_pre4_impl<N_R0_IQ2_XXS>(args0,
        reinterpret_cast<device const char *>(gate_addr), reinterpret_cast<device const char *>(up_addr),
        yh[0], yh[1], yh[2], yh[3], dg[0], du[0], dg[1], du[1], dg[2], du[2], dg[3], du[3], four, shmem, tgpig, tiisg, sgitg);

    /* the same SwiGLU epilogue as the pair kernel, once per row of the entry */
    const short NSG = FC_mul_mv_nsg;
    const int first_row = (tgpig.x * NSG + sgitg) * N_R0_IQ2_XXS;
    const float c = act.clamp_value;
    for (int which = 0; which < (four ? 4 : 3); ++which) {
        device float *gate_f32 = (device float *)dg[which];
        device float *up_f32 = (device float *)du[which];
        const uint64_t pair_row = (uint64_t)iid1[which] * (uint64_t)args.nei0 + (uint64_t)idx[which];
        device float *mid_f32 = (device float *)(dst_mid + pair_row * act.mid_row_stride);
        device const float *route_w = (device const float *)(weights + pair_row * act.weight_stride);
        const float route_weight = route_w[0];
        if (tiisg == 0) {
            for (int row = 0; row < N_R0_IQ2_XXS && first_row + row < args.ne0; ++row) {
                const uint out_row = first_row + row;
                float g = gate_f32[out_row];
                float u = up_f32[out_row];
                if (c > 1.0e-6f) {
                    g = min(g, c);
                    u = clamp(u, -c, c);
                }
                const float silu = g / (1.0f + exp(-g));
                mid_f32[out_row] = silu * u * route_weight;
            }
        }
    }
}
