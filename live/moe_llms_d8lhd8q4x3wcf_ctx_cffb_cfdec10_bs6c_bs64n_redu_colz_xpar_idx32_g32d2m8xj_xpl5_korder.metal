}

/* ---- llms G32D (make_moe_g32d.py): B1 -- the bit-serial routed down on the G32 side file's column-major planes ---- */
/* ---- llms G32D_XJ (make_moe_g32d2m8xj.py): the planes kernel + the decode job builder in one dispatch ---- */
struct llms_xj_args { uint np, nei0; ulong nbi1; uint ne02, ne01; };
kernel void kernel_llms_g32d_xplanes_jobs2(device const char * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
                                     constant uint4 & p [[buffer(3)]], device const char * ids [[buffer(4)]], device int * jobs [[buffer(5)]],
                                     device uint * disp [[buffer(6)]], constant llms_xj_args & xa [[buffer(7)]], uint2 gid [[thread_position_in_grid]]) {
    /* p.x = pairs (tokens x 6), p.y = the slot stride nb11 (bytes), p.z = NPL, p.w = the token stride nb12 (bytes); one thread per (group < 72, pair) */
    if (gid.y == p.x) {   /* llms G32D_XJ: the job row -- thread 0 groups the call's <= 12 pairs by expert (first-seen order), jobs of <= 8 */
        if (gid.x != 0u) return;
        int je[12]; uint jk[12]; uint nj = 0u;
        for (uint q = 0u; q < xa.np && q < 12u; q++) {
            const uint tok = q / xa.nei0, slot = q - tok * xa.nei0;
            const int e = ((device const int32_t *)(ids + (ulong)tok * xa.nbi1))[slot];
            if (e < 0 || (uint)e >= xa.ne02 || e >= 384) continue;
            uint j = 0u; for (; j < nj; j++) if (je[j] == e && jk[j] < 8u) break;
            if (j == nj) { je[nj] = e; jk[nj] = 0u; jobs[nj * 10u] = e; nj++; }
            jobs[j * 10u + 2u + jk[j]] = (int)q; jk[j]++;
        }
        for (uint j = 0u; j < nj; j++) jobs[j * 10u + 1u] = (int)jk[j];
        disp[0] = (xa.ne01 + 127u) / 128u; disp[1] = nj; disp[2] = 1u;
        return;
    }
    if (gid.x >= 72u || gid.y >= p.x) return;
    const uint tok = gid.y / 6u, slot = gid.y - 6u * tok;
    device const float * xr = (device const float *)(src1 + (ulong)tok * p.w + (ulong)slot * p.y) + 32u * gid.x;
    float v[32]; float a = 0.f;
    for (int i = 0; i < 32; i++) { v[i] = xr[i]; a = max(a, fabs(v[i])); }
    const float qmax = float((1u << (p.z - 1u)) - 1u);
    const float sc = a > 0.f ? a / qmax : 1.f;
    uint pl[8] = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}; int sum = 0;
    const uint msk = (1u << p.z) - 1u;
    if (p.z == 5u) {   /* llms UNROLL: production's NPL as a compile-time 5 -- pl[b] fixed registers, no select chains */
        FOR_UNROLL (int i = 0; i < 32; i++) {
            const int q = (int)rint(v[i] / sc); sum += q;
            const uint u = (uint)q & 31u;
            FOR_UNROLL (uint b = 0; b < 5u; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
        }
    } else
    for (int i = 0; i < 32; i++) {
        const int q = (int)rint(v[i] / sc); sum += q;
        const uint u = (uint)q & msk;
        for (uint b = 0; b < p.z; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
    }
    device uint * o = XP + ((ulong)gid.y * 72u + gid.x) * 8u;
    for (int b = 0; b < 8; b++) o[b] = pl[b];
    XS[(ulong)gid.y * 72u + gid.x] = float2(sc, sc * (float)sum);
}
// ---- llms G32D_XJ4 (apply_xj4.py): the folded job builder for three- and four-token calls (<= 24 pairs; the twin's arrays) ----
kernel void kernel_llms_g32d_xplanes_jobs4(device const char * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
                                     constant uint4 & p [[buffer(3)]], device const char * ids [[buffer(4)]], device int * jobs [[buffer(5)]],
                                     device uint * disp [[buffer(6)]], constant llms_xj_args & xa [[buffer(7)]], uint2 gid [[thread_position_in_grid]]) {
    /* p.x = pairs (tokens x 6), p.y = the slot stride nb11 (bytes), p.z = NPL, p.w = the token stride nb12 (bytes); one thread per (group < 72, pair) */
    if (gid.y == p.x) {   /* llms G32D_XJ: the job row -- thread 0 groups the call's <= 24 pairs by expert (first-seen order), jobs of <= 8 */
        if (gid.x != 0u) return;
        int je[24]; uint jk[24]; uint nj = 0u;
        for (uint q = 0u; q < xa.np && q < 24u; q++) {
            const uint tok = q / xa.nei0, slot = q - tok * xa.nei0;
            const int e = ((device const int32_t *)(ids + (ulong)tok * xa.nbi1))[slot];
            if (e < 0 || (uint)e >= xa.ne02 || e >= 384) continue;
            uint j = 0u; for (; j < nj; j++) if (je[j] == e && jk[j] < 8u) break;
            if (j == nj) { je[nj] = e; jk[nj] = 0u; jobs[nj * 10u] = e; nj++; }
            jobs[j * 10u + 2u + jk[j]] = (int)q; jk[j]++;
        }
        for (uint j = 0u; j < nj; j++) jobs[j * 10u + 1u] = (int)jk[j];
        disp[0] = (xa.ne01 + 127u) / 128u; disp[1] = nj; disp[2] = 1u;
        return;
    }
    if (gid.x >= 72u || gid.y >= p.x) return;
    const uint tok = gid.y / 6u, slot = gid.y - 6u * tok;
    device const float * xr = (device const float *)(src1 + (ulong)tok * p.w + (ulong)slot * p.y) + 32u * gid.x;
    float v[32]; float a = 0.f;
    for (int i = 0; i < 32; i++) { v[i] = xr[i]; a = max(a, fabs(v[i])); }
    const float qmax = float((1u << (p.z - 1u)) - 1u);
    const float sc = a > 0.f ? a / qmax : 1.f;
    uint pl[8] = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}; int sum = 0;
    const uint msk = (1u << p.z) - 1u;
    if (p.z == 5u) {   /* llms UNROLL: production's NPL as a compile-time 5 -- pl[b] fixed registers, no select chains */
        FOR_UNROLL (int i = 0; i < 32; i++) {
            const int q = (int)rint(v[i] / sc); sum += q;
            const uint u = (uint)q & 31u;
            FOR_UNROLL (uint b = 0; b < 5u; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
        }
    } else
    for (int i = 0; i < 32; i++) {
        const int q = (int)rint(v[i] / sc); sum += q;
        const uint u = (uint)q & msk;
        for (uint b = 0; b < p.z; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
    }
    device uint * o = XP + ((ulong)gid.y * 72u + gid.x) * 8u;
    for (int b = 0; b < 8; b++) o[b] = pl[b];
    XS[(ulong)gid.y * 72u + gid.x] = float2(sc, sc * (float)sum);
}

kernel void kernel_llms_g32d_xplanes(device const char * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
                                     constant uint4 & p [[buffer(3)]], uint2 gid [[thread_position_in_grid]]) {
    /* p.x = pairs (tokens x 6), p.y = the slot stride nb11 (bytes), p.z = NPL, p.w = the token stride nb12 (bytes); one thread per (group < 72, pair) */
    if (gid.x >= 72u || gid.y >= p.x) return;
    const uint tok = gid.y / 6u, slot = gid.y - 6u * tok;
    device const float * xr = (device const float *)(src1 + (ulong)tok * p.w + (ulong)slot * p.y) + 32u * gid.x;
    float v[32]; float a = 0.f;
    for (int i = 0; i < 32; i++) { v[i] = xr[i]; a = max(a, fabs(v[i])); }
    const float qmax = float((1u << (p.z - 1u)) - 1u);
    const float sc = a > 0.f ? a / qmax : 1.f;
    uint pl[8] = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}; int sum = 0;
    const uint msk = (1u << p.z) - 1u;
    if (p.z == 5u) {   /* llms UNROLL: production's NPL as a compile-time 5 -- pl[b] fixed registers, no select chains */
        FOR_UNROLL (int i = 0; i < 32; i++) {
            const int q = (int)rint(v[i] / sc); sum += q;
            const uint u = (uint)q & 31u;
            FOR_UNROLL (uint b = 0; b < 5u; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
        }
    } else
    for (int i = 0; i < 32; i++) {
        const int q = (int)rint(v[i] / sc); sum += q;
        const uint u = (uint)q & msk;
        for (uint b = 0; b < p.z; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
    }
    device uint * o = XP + ((ulong)gid.y * 72u + gid.x) * 8u;
    for (int b = 0; b < 8; b++) o[b] = pl[b];
    XS[(ulong)gid.y * 72u + gid.x] = float2(sc, sc * (float)sum);
}
template <int NPL, bool CANARY>
static inline void llms_g32d_down1_impl(constant ds4_metal_args_mul_mv_id & args, device const uint64_t * addrs, device const uint * XP, device const float2 * XS,
        device float * partial, device const char * ids, threadgroup uint * sxp, threadgroup float2 * sxs, uint3 tg, ushort lane, ushort sg, ushort3 ntg) {
    const uint token = tg.y, slot = tg.z, pair = token * (uint)args.nei0 + slot;
    const uint tid = (uint)sg * 32u + (uint)lane, nthr = (uint)ntg.y * 32u;
    for (uint i = tid; i < 72u * (uint)NPL; i += nthr) { const uint g = i / (uint)NPL, b = i - g * (uint)NPL; sxp[i] = XP[((ulong)pair * 72u + g) * 8u + b]; }
    for (uint i = tid; i < 72u; i += nthr) sxs[i] = XS[(ulong)pair * 72u + i];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    const int32_t expert = ((device const int32_t *)(ids + (ulong)token * args.nbi1))[slot];
    if (expert < 0 || expert >= args.ne02 || expert >= 384) return;
    const uint64_t addr = addrs[(uint)expert];
    if (addr == 0) return;
    const uint R = (uint)args.ne01;
    const uint row = (tg.x * (uint)ntg.y + (uint)sg) * 32u + (uint)lane;
    if (row >= R) return;
    device const char * base = reinterpret_cast<device const char *>(addr);
    device const uint2 * Q = (device const uint2 *)base + row;
    device const uchar * S = (device const uchar *)(base + (ulong)72u * R * 8u) + row;
    device const half2 * DD = (device const half2 *)(base + (ulong)72u * R * 9u) + row;
    float y = 0.f;
    for (uint b9 = 0; b9 < 9u; b9++) {
        const float2 dd = float2(DD[b9 * R]);
        for (uint gg = 0; gg < 8u; gg++) {
            const uint g = b9 * 8u + gg;
            uint2 w = Q[g * R];
            if (CANARY) w = w.yx;   /* the canary: the two code planes swapped -- the output must change */
            const uint s = S[g * R];
            const float dsc = dd.x * float(s & 15u), dmn = dd.y * float(s >> 4);
            threadgroup const uint * x = sxp + g * (uint)NPL;
            int A = -(int)(2u * popcount(w.y & x[NPL - 1]) + popcount(w.x & x[NPL - 1]));
            for (int p = NPL - 2; p >= 0; p--) A = 2 * A + (int)(2u * popcount(w.y & x[p]) + popcount(w.x & x[p]));
            const float2 s2 = sxs[g];
            y += dsc * float(A) * s2.x - dmn * s2.y;
        }
    }
    partial[(ulong)pair * R + row] = y;
}
#define LLMS_G32D_DOWN1(NAME, NPL, CAN) \
kernel void NAME(constant ds4_metal_args_mul_mv_id & args [[buffer(0)]], device const uint64_t * addrs [[buffer(1)]], device const uint * XP [[buffer(2)]], \
        device const float2 * XS [[buffer(3)]], device float * partial [[buffer(4)]], device const char * ids [[buffer(5)]], \
        uint3 tg [[threadgroup_position_in_grid]], ushort lane [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]], \
        ushort3 ntg [[threads_per_threadgroup]]) { \
    threadgroup uint sxp[72 * NPL]; threadgroup float2 sxs[72]; \
    llms_g32d_down1_impl<NPL, CAN>(args, addrs, XP, XS, partial, ids, sxp, sxs, tg, lane, sg, ntg); }
LLMS_G32D_DOWN1(kernel_llms_g32d_down1_p5_f32, 5, false)
LLMS_G32D_DOWN1(kernel_llms_g32d_down1_p6_f32, 6, false)
LLMS_G32D_DOWN1(kernel_llms_g32d_down1_p8_f32, 8, false)
LLMS_G32D_DOWN1(kernel_llms_g32d_down1_p6_x_f32, 6, true)

/* ---- llms G32D2 (make_moe_g32d2.py): the grouped down -- each distinct expert once for its pairs ---- */
kernel void kernel_llms_g32d_group(constant ds4_metal_args_mul_mv_id & args [[buffer(0)]], device const char * ids [[buffer(1)]],
        device int * jobs [[buffer(2)]], device uint * disp [[buffer(3)]], uint tid [[thread_index_in_threadgroup]], uint nthr [[threads_per_threadgroup]]) {
    threadgroup atomic_uint cnt[384]; threadgroup atomic_uint fill[384]; threadgroup uint jst[384];
    for (uint e = tid; e < 384u; e += nthr) { atomic_store_explicit(&cnt[e], 0u, memory_order_relaxed); atomic_store_explicit(&fill[e], 0u, memory_order_relaxed); }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    const uint np = (uint)args.nei1 * (uint)args.nei0;
    for (uint p = tid; p < np; p += nthr) {
        const uint tok = p / (uint)args.nei0, slot = p - tok * (uint)args.nei0;
        const int e = ((device const int32_t *)(ids + (ulong)tok * args.nbi1))[slot];
        if (e >= 0 && e < args.ne02 && e < 384) atomic_fetch_add_explicit(&cnt[e], 1u, memory_order_relaxed);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid == 0) {
        uint j = 0;
        for (uint e = 0; e < 384u; e++) { jst[e] = j; j += (atomic_load_explicit(&cnt[e], memory_order_relaxed) + 7u) / 8u; }
        disp[0] = ((uint)args.ne01 + 127u) / 128u; disp[1] = j; disp[2] = 1u;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint e = tid; e < 384u; e += nthr) {
        const uint c = atomic_load_explicit(&cnt[e], memory_order_relaxed);
        for (uint k = 0; 8u * k < c; k++) { device int * jb = jobs + (jst[e] + k) * 10u; jb[0] = (int)e; jb[1] = (int)min(8u, c - 8u * k); }
    }
    for (uint p = tid; p < np; p += nthr) {
        const uint tok = p / (uint)args.nei0, slot = p - tok * (uint)args.nei0;
        const int e = ((device const int32_t *)(ids + (ulong)tok * args.nbi1))[slot];
        if (e < 0 || e >= args.ne02 || e >= 384) continue;
        const uint s = atomic_fetch_add_explicit(&fill[e], 1u, memory_order_relaxed);
        jobs[(jst[e] + s / 8u) * 10u + 2u + s % 8u] = (int)p;
    }
}
template <int NPL>
static inline void llms_g32d_downg_impl(constant ds4_metal_args_mul_mv_id & args, device const uint64_t * addrs, device const int * jobs, device const uint * XP,
        device const float2 * XS, device float * partial, threadgroup uint * sxp, threadgroup float2 * sxs, uint3 tg, ushort lane, ushort sg, ushort3 ntg) {
    device const int * jb = jobs + tg.y * 10u; const int expert = jb[0], K = jb[1];
    const uint tid = (uint)sg * 32u + (uint)lane, nthr = (uint)ntg.y * 32u;
    for (uint i = tid; i < (uint)K * 72u * (uint)NPL; i += nthr) { const uint k = i / (72u * (uint)NPL), r = i - k * 72u * (uint)NPL, g = r / (uint)NPL, b = r - g * (uint)NPL;
        sxp[i] = XP[((ulong)jb[2 + k] * 72u + g) * 8u + b]; }
    for (uint i = tid; i < (uint)K * 72u; i += nthr) { const uint k = i / 72u, g = i - k * 72u; sxs[i] = XS[(ulong)jb[2 + k] * 72u + g]; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (expert < 0 || expert >= args.ne02 || expert >= 384 || K < 1) return;
    const uint64_t addr = addrs[(uint)expert];
    if (addr == 0) return;
    const uint R = (uint)args.ne01;
    const uint row = (tg.x * (uint)ntg.y + (uint)sg) * 32u + (uint)lane;
    if (row >= R) return;
    device const char * base = reinterpret_cast<device const char *>(addr);
    device const uint2 * Q = (device const uint2 *)base + row;
    device const uchar * S = (device const uchar *)(base + (ulong)72u * R * 8u) + row;
    device const half2 * DD = (device const half2 *)(base + (ulong)72u * R * 9u) + row;
    float y[8] = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
    for (uint b9 = 0; b9 < 9u; b9++) {
        const float2 dd = float2(DD[b9 * R]);
        uint2 wv[8]; uint sv[8];   /* llms G32D MLP8 (make_moe_g32d2m8.py): the block's 8 loads first, then the arithmetic */
        for (uint gg = 0; gg < 8u; gg++) { wv[gg] = Q[(b9 * 8u + gg) * R]; sv[gg] = S[(b9 * 8u + gg) * R]; }
        for (int k = 0; k < 8; k++) {   /* llms KORDER: the token loop outside, y[k] touched once per (block, token) */
            if (k >= K) break;
            float yk = 0.f;
            FOR_UNROLL (uint gg = 0; gg < 8u; gg++) {
                const uint g = b9 * 8u + gg; const uint2 w = wv[gg]; const uint s = sv[gg];
                const float dsc = dd.x * float(s & 15u), dmn = dd.y * float(s >> 4);
                threadgroup const uint * x = sxp + ((uint)k * 72u + g) * (uint)NPL;
                int A = -(int)(2u * popcount(w.y & x[NPL - 1]) + popcount(w.x & x[NPL - 1]));
                for (int p = NPL - 2; p >= 0; p--) A = 2 * A + (int)(2u * popcount(w.y & x[p]) + popcount(w.x & x[p]));
                const float2 s2 = sxs[(uint)k * 72u + g];
                yk += dsc * float(A) * s2.x - dmn * s2.y;
            }
            y[k] += yk;
        }
    }
    for (int k = 0; k < 8; k++) { if (k >= K) break; partial[(ulong)jb[2 + k] * R + row] = y[k]; }
}
