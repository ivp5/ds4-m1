#ifndef QK_K
#define QK_K 256   /* the source undefines it after its own kernels */
#define LLMS_DD_QK_K
#endif
/* llms DOWN_DD (make_moe_dd.py): the routed down projection per expert entry (one or two pairs of one expert), partial outputs per pair */
kernel void kernel_llms_q2k_down_dd_f32(
        constant ds4_metal_args_mul_mv_id & args,
        device const uint64_t * addrs,
        device const char * src1,
        device       float * partial,
        device const char * ids,
        device const uint2 * entries [[buffer(5)]],
        uint3  tgpig[[threadgroup_position_in_grid]],
        ushort tiisg[[thread_index_in_simdgroup]],
        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
    const short NSG = FC_mul_mv_nsg;
    const short nr0 = 8;
    const int nb = args.ne00 / QK_K;
    const int first_row = (tgpig.x * NSG + sgitg) * nr0;
    const uint2 en = entries[tgpig.z];
    const bool two = en.y != 0xFFFFFFFFu;
    const uint tokA = en.x / (uint)args.nei0, slotA = en.x % (uint)args.nei0;
    const uint tokB = two ? en.y / (uint)args.nei0 : tokA, slotB = two ? en.y % (uint)args.nei0 : slotA;
    const int32_t expert = ((device const int32_t *)(ids + (uint64_t)tokA * args.nbi1))[slotA];
    if (expert < 0 || expert >= args.ne02 || expert >= 384) return;
    const uint64_t addr = addrs[(uint)expert];
    if (addr == 0) return;
    device const char *src0_cur = reinterpret_cast<device const char *>(addr);
    device const block_q2_K *x = (device const block_q2_K *)(src0_cur + first_row * args.nb01);

    float sumfA[nr0] = {0.f};
    float sumfB[nr0] = {0.f};

    const short ix = tiisg / 8;
    const short it = tiisg % 8;
    const short iq = it / 4;
    const short ir = it % 4;
    const short is = (8 * ir) / 16;

    device const float *yA = (device const float *)(src1 + (uint64_t)tokA * args.nb12 + (uint64_t)slotA * args.nb11);
    device const float *yB = (device const float *)(src1 + (uint64_t)tokB * args.nb12 + (uint64_t)slotB * args.nb11);
    device const float *y4A = yA + ix * QK_K + 128 * iq + 8 * ir;
    device const float *y4B = yB + ix * QK_K + 128 * iq + 8 * ir;

    for (int ib = ix; ib < nb; ib += 4) {
        float ylA[32], ylB[32];
        float4 sumyA = {0.f, 0.f, 0.f, 0.f}, sumyB = {0.f, 0.f, 0.f, 0.f};
        for (short i = 0; i < 8; ++i) {
            ylA[i +  0] = y4A[i +  0]; sumyA[0] += ylA[i +  0];
            ylA[i +  8] = y4A[i + 32]; sumyA[1] += ylA[i +  8];
            ylA[i + 16] = y4A[i + 64]; sumyA[2] += ylA[i + 16];
            ylA[i + 24] = y4A[i + 96]; sumyA[3] += ylA[i + 24];
        }
        if (two) {
            for (short i = 0; i < 8; ++i) {
                ylB[i +  0] = y4B[i +  0]; sumyB[0] += ylB[i +  0];
                ylB[i +  8] = y4B[i + 32]; sumyB[1] += ylB[i +  8];
                ylB[i + 16] = y4B[i + 64]; sumyB[2] += ylB[i + 16];
                ylB[i + 24] = y4B[i + 96]; sumyB[3] += ylB[i + 24];
            }
        }

        device const uint8_t  *sc = (device const uint8_t *)x[ib].scales + 8 * iq + is;
        device const uint16_t *qs = (device const uint16_t *)x[ib].qs + 16 * iq + 4 * ir;
        device const half     *dh = &x[ib].d;

        for (short row = 0; row < nr0; row++) {
            if (first_row + row < args.ne0) {
                float4 a1A = {0.f, 0.f, 0.f, 0.f}, a2A = {0.f, 0.f, 0.f, 0.f};
                float4 a1B = {0.f, 0.f, 0.f, 0.f}, a2B = {0.f, 0.f, 0.f, 0.f};
                for (int i = 0; i < 8; i += 2) {
                    const ushort q = qs[i / 2];
                    const float q0 = (float)(q & 0x0003), q1 = (float)(q & 0x0300), q2 = (float)(q & 0x000c), q3 = (float)(q & 0x0c00);
                    const float q4 = (float)(q & 0x0030), q5 = (float)(q & 0x3000), q6 = (float)(q & 0x00c0), q7 = (float)(q & 0xc000);
                    a1A[0] += ylA[i +  0] * q0;
                    a2A[0] += ylA[i +  1] * q1;
                    a1A[1] += ylA[i +  8] * q2;
                    a2A[1] += ylA[i +  9] * q3;
                    a1A[2] += ylA[i + 16] * q4;
                    a2A[2] += ylA[i + 17] * q5;
                    a1A[3] += ylA[i + 24] * q6;
                    a2A[3] += ylA[i + 25] * q7;
                    if (two) {
                        a1B[0] += ylB[i +  0] * q0;
                        a2B[0] += ylB[i +  1] * q1;
                        a1B[1] += ylB[i +  8] * q2;
                        a2B[1] += ylB[i +  9] * q3;
                        a1B[2] += ylB[i + 16] * q4;
                        a2B[2] += ylB[i + 17] * q5;
                        a1B[3] += ylB[i + 24] * q6;
                        a2B[3] += ylB[i + 25] * q7;
                    }
                }
                float dall = dh[0];
                float dmin = dh[1] * 1.f / 16.f;
                sumfA[row] += dall * ((a1A[0] + 1.f / 256.f * a2A[0]) * (sc[0] & 0xF) * 1.f /  1.f +
                                      (a1A[1] + 1.f / 256.f * a2A[1]) * (sc[2] & 0xF) * 1.f /  4.f +
                                      (a1A[2] + 1.f / 256.f * a2A[2]) * (sc[4] & 0xF) * 1.f / 16.f +
                                      (a1A[3] + 1.f / 256.f * a2A[3]) * (sc[6] & 0xF) * 1.f / 64.f) -
                              dmin * (sumyA[0] * (sc[0] & 0xF0) + sumyA[1] * (sc[2] & 0xF0) +
                                      sumyA[2] * (sc[4] & 0xF0) + sumyA[3] * (sc[6] & 0xF0));
                if (two) {
                    sumfB[row] += dall * ((a1B[0] + 1.f / 256.f * a2B[0]) * (sc[0] & 0xF) * 1.f /  1.f +
                                          (a1B[1] + 1.f / 256.f * a2B[1]) * (sc[2] & 0xF) * 1.f /  4.f +
                                          (a1B[2] + 1.f / 256.f * a2B[2]) * (sc[4] & 0xF) * 1.f / 16.f +
                                          (a1B[3] + 1.f / 256.f * a2B[3]) * (sc[6] & 0xF) * 1.f / 64.f) -
                                  dmin * (sumyB[0] * (sc[0] & 0xF0) + sumyB[1] * (sc[2] & 0xF0) +
                                          sumyB[2] * (sc[4] & 0xF0) + sumyB[3] * (sc[6] & 0xF0));
                }
            }
            qs += args.nb01 / 2;
            sc += args.nb01;
            dh += args.nb01 / 2;
        }
