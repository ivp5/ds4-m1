// ---- llms BS64_XPAR (apply_bs64_xpar.py): kernel_llms_bs64_xplanes with one thread per input value (bit-identical) ----
kernel void kernel_llms_bs64_xplanes_par(device const float * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
                                         constant uint4 & p [[buffer(3)]], uint gid [[thread_position_in_grid]], ushort lane [[thread_index_in_simdgroup]]) {
    /* p.x tokens, p.y token stride in floats, p.z planes (<= 8), p.w canary; a simdgroup per (sub-block, token), a lane per value */
    const uint sbk = (gid / 32u) % 160u, tok = gid / (32u * 160u);
    if (tok >= p.x) return;
    const float v = src1[(uint64_t)tok * p.y + 32u * sbk + lane];
    const float a = simd_max(fabs(v));
    const float qmax = float((1u << (p.z - 1u)) - 1u);
    const float sc = a > 0.f ? a / qmax : 1.f;
    const int q = (int)rint(v / sc);
    const int sum = simd_sum(q);
    const uint msk = (1u << p.z) - 1u, u = (uint)q & msk;
    device uint * o = XP + ((uint64_t)tok * 160u + sbk) * 8u;
    for (uint b = 0; b < 8u; b++) {
        const uint plane = b < p.z ? (uint)((uint64_t)simd_ballot(((u >> b) & 1u) != 0u)) : 0u;
        if (lane == 0) o[b] = plane;
    }
    if (lane == 0) XS[(uint64_t)tok * 160u + sbk] = float2(sc, p.w ? 0.0f : sc * (float)sum);
}

// ---- llms DOWN_T8W (apply_t8w.py) ----
// extra_t8p.metal (2026-10-18): t8w / t8h (extra_t8.metal) with the A tile's row stride padded 64 -> 72 halves
// (144 B: the 32 rows no longer fall on the same threadgroup-memory banks).
template <bool HALF, int AS>
static inline void llms_t8wp_impl(constant ds4_metal_args_mul_mv_id & args, device const uint64_t * addrs, device const char * src1, device char * parts,
                                 device const char * ids, device const uint * entries, uint3 tgpig, ushort tiisg, ushort sgitg,
                                 threadgroup half * As, threadgroup half * Bs, threadgroup float * Cs) {
    device const uint * en = entries + 8u * tgpig.z;
    const uint pn0 = en[0];
    const int32_t expert = ((device const int32_t *)(ids + (uint64_t)(pn0 / (uint)args.nei0) * args.nbi1))[pn0 % (uint)args.nei0];
    if (expert < 0 || expert >= args.ne02 || expert >= 384) return;
    const uint64_t addr = addrs[(uint)expert];
    if (addr == 0) return;
    const int first_row = tgpig.x * 32;
    const ushort tid = sgitg * 32 + tiisg;
    const int dr = tid >> 2, dq = tid & 3;               // decode: row dr (0..31), weights 8 dq .. 8 dq + 7 of each 32-block
    const int st = tid >> 4, sk = (tid & 15) * 4;        // stage: token st (0..7), k sk .. sk + 3 of the 64-block
    device const uchar * xr = reinterpret_cast<device const uchar *>(addr) + (uint64_t)(first_row + dr) * args.nb01;
    const uint pns = en[st]; const bool pad = pns == 0xFFFFFFFFu;
    device const float * ym = (device const float *)(src1 + (pad ? 0ull : (uint64_t)(pns / (uint)args.nei0) * args.nb12 + (uint64_t)(pns % (uint)args.nei0) * args.nb11));
    simdgroup_float8x8 C = make_filled_simdgroup_matrix<float, 8>(0.f);
    for (int k2 = 0; k2 < 36; k2++) {            // 2,304 / 64
        for (int hb = 0; hb < 2; hb++) {
            const int kb = 2 * k2 + hb;
            const int ib = kb >> 3, w = (kb & 7) * 32 + 8 * dq;
            device const uchar * blk = xr + ib * 84;
            const int iq = w >> 7, J = (w & 127) >> 5, l0 = w & 31;
            const uint2 qq = *(device const packed_uint2 *)(blk + 16 + 32 * iq + l0);
            const uchar sc = blk[8 * iq + 2 * J + (l0 >> 4)];
            const float d = (float)as_type<half>(*(device const ushort *)(blk + 80)), dmin = (float)as_type<half>(*(device const ushort *)(blk + 82));
            const float dl = d * (float)(sc & 15), ml = dmin * (float)(sc >> 4);
            const uint sh = 2u * (uint)J;
            half4 w0, w1;
            if (HALF) {
                const half dlh = (half)dl, mlh = (half)ml;
                const half4 c0 = half4(as_type<uchar4>((qq.x >> sh) & 0x03030303u)), c1 = half4(as_type<uchar4>((qq.y >> sh) & 0x03030303u));
                w0 = fma(c0, half4(dlh), half4(-mlh)); w1 = fma(c1, half4(dlh), half4(-mlh));
            } else {
                for (int j2 = 0; j2 < 4; j2++) { w0[j2] = (half)(dl * (float)((qq.x >> (8 * j2 + sh)) & 3u) - ml); w1[j2] = (half)(dl * (float)((qq.y >> (8 * j2 + sh)) & 3u) - ml); }
            }
            *(threadgroup half4 *)(As + dr * AS + hb * 32 + 8 * dq) = w0; *(threadgroup half4 *)(As + dr * AS + hb * 32 + 8 * dq + 4) = w1;
        }
        const float4 m4 = pad ? float4(0.f) : float4(*(device const packed_float4 *)(ym + k2 * 64 + sk));
        Bs[(sk + 0) * 8 + st] = (half)m4.x; Bs[(sk + 1) * 8 + st] = (half)m4.y; Bs[(sk + 2) * 8 + st] = (half)m4.z; Bs[(sk + 3) * 8 + st] = (half)m4.w;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (short kt = 0; kt < 8; kt++) {
            simdgroup_half8x8 A, B;
            simdgroup_load(A, As + (8 * sgitg) * AS + kt * 8, AS);
            simdgroup_load(B, Bs + kt * 64, 8);
            simdgroup_multiply_accumulate(C, A, B, C);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    simdgroup_store(C, Cs + sgitg * 64, 8);
    simdgroup_barrier(mem_flags::mem_threadgroup);
    for (short e = tiisg; e < 64; e += 32) {
        const short row = e / 8, tok = e % 8;
        const int orow = first_row + 8 * sgitg + row;
        if (orow < args.ne0 && en[tok] != 0xFFFFFFFFu) ((device float *)(parts + ((uint64_t)tgpig.z * 8u + (uint64_t)tok) * (uint64_t)args.ne0 * sizeof(float)))[orow] = Cs[sgitg * 64 + e];
    }
}
kernel void kernel_llms_q2k_down_t8wp_f32(constant ds4_metal_args_mul_mv_id & args, device const uint64_t * addrs, device const char * src1, device char * parts,
                                          device const char * ids, device const uint * entries [[buffer(5)]], uint3 tgpig[[threadgroup_position_in_grid]],
                                          ushort tiisg[[thread_index_in_simdgroup]], ushort sgitg[[simdgroup_index_in_threadgroup]]) {
    threadgroup half As[32 * 72]; threadgroup half Bs[64 * 8]; threadgroup float Cs[4 * 64];
    llms_t8wp_impl<false, 72>(args, addrs, src1, parts, ids, entries, tgpig, tiisg, sgitg, As, Bs, Cs);
}
kernel void kernel_llms_q2k_down_t8hp_f32(constant ds4_metal_args_mul_mv_id & args, device const uint64_t * addrs, device const char * src1, device char * parts,
                                          device const char * ids, device const uint * entries [[buffer(5)]], uint3 tgpig[[threadgroup_position_in_grid]],
