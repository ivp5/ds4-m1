        y4B += 4 * QK_K;
    }

    device float *pA = partial + (uint64_t)en.x * (uint64_t)args.ne0;
    device float *pB = partial + (uint64_t)(two ? en.y : en.x) * (uint64_t)args.ne0;
    for (int row = 0; row < nr0 && first_row + row < args.ne0; row++) {
        const float sa = simd_sum(sumfA[row]);
        const float sb = simd_sum(sumfB[row]);
        if (tiisg == 0) {
            pA[first_row + row] = sa;
            if (two) pB[first_row + row] = sb;
        }
    }
}

/* llms DOWN_DD: a token's routed output = the sum of its (up to) six pair partials, in slot order; the stock kernel's validity rules */
kernel void kernel_llms_sum6_partials_f32(
        constant ds4_metal_args_mul_mv_id & args,
        device const uint64_t * addrs,
        device const float * partial,
        device       char * dst,
        device const char * ids,
        uint3 gid [[thread_position_in_grid]]) {
    const uint row = gid.x, token = gid.y;
    if (row >= (uint)args.ne0 || token >= (uint)args.nei1) return;
    device const int32_t *token_ids = (device const int32_t *)(ids + (uint64_t)token * args.nbi1);
    float s = 0.f;
    for (int slot = 0; slot < args.nei0; slot++) {
        const int32_t e = token_ids[slot];
        if (e < 0 || e >= args.ne02 || e >= 384) continue;
        if (addrs[(uint)e] == 0) continue;
        s += partial[((uint64_t)token * (uint64_t)args.nei0 + (uint64_t)slot) * (uint64_t)args.ne0 + row];
    }
    ((device float *)(dst + (uint64_t)token * args.nb1))[row] = s;
}
