/* llms PREHALF (make_moe_prehalf.py): the routed call's activations converted to half once, with the clamp the gate/up kernel used */
kernel void kernel_llms_f32_to_half_clamp(device const float *x [[buffer(0)]], device half *y [[buffer(1)]], constant uint &n [[buffer(2)]],
                                          uint gid [[thread_position_in_grid]]) {
    if (gid < n) y[gid] = (half)clamp(x[gid], -65504.0f, 65504.0f);
}

