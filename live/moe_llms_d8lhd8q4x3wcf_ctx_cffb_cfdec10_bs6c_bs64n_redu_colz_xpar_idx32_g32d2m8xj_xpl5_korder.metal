        device const uint * XP [[buffer(3)]], device const float2 * XS [[buffer(4)]], device float * partial [[buffer(5)]], \
        uint3 tg [[threadgroup_position_in_grid]], ushort lane [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]], \
        ushort3 ntg [[threads_per_threadgroup]]) { \
    threadgroup uint sxp[8 * 72 * NPL]; threadgroup float2 sxs[8 * 72]; \
    llms_g32d_downg_impl<NPL>(args, addrs, jobs, XP, XS, partial, sxp, sxs, tg, lane, sg, ntg); }
