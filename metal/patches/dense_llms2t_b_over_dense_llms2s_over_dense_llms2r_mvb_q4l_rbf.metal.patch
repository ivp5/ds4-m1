+/* llms ROWS_T4 (make_dense_t4.py): kernel_mul_mv_t_t_4_impl for NTOK tokens per threadgroup, each token with its single-row bits */
+template<typename T0, typename T04, short NR0, short NTOK>
+void kernel_llms_mul_mv_t4_impl(
+        constant ds4_metal_args_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NB  = 32;
+    constexpr short NF  = 16;
+    constexpr short NF4 = NF/4;
+    const int nb = args.ne00/NB;
+    const int r0 = tgpig.x*NR0;
+    const int t0 = tgpig.y*NTOK;
+    const int im = tgpig.z;
+    const uint i12 = im%args.ne12;
+    const uint i13 = im/args.ne12;
+    device const T0  * ax [NR0];
+    device const T04 * ax4[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const uint64_t offset0 = (r0 + row)*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+        ax [row] = (device const T0  *) ((device char *) src0 + offset0);
+        ax4[row] = (device const T04 *) ((device char *) src0 + offset0);
+    }
+    float sumf[NTOK][NR0];
+    FOR_UNROLL (short t = 0; t < NTOK; ++t) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[t][row] = 0.f;
+    const short ix = tiisg/(NW/NF);
+    const short il = tiisg%(NW/NF);
+    const int ib0 = sgitg*NF + ix;
+    device const float  * y [NTOK];
+    device const float4 * yb4[NTOK];
+    FOR_UNROLL (short t = 0; t < NTOK; ++t) {
+        const uint64_t offset1 = (uint64_t)(t0 + t)*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        y[t] = (device const float *) (src1 + offset1);
+        yb4[t] = (device const float4 *) (src1 + offset1) + (ib0*NB + il*NF)/4;
+    }
+    for (int ib = ib0; ib < nb; ib += NSG*NF) {
+        float4 yl4[NTOK][NF4];
+        FOR_UNROLL (short t = 0; t < NTOK; ++t) FOR_UNROLL (short i = 0; i < NF4; ++i) yl4[t][i] = yb4[t][i];
+        for (short row = 0; row < NR0; row++) {
+            device const T04 * xb4 = ax4[row] + (ib*NB + il*NF)/4;
+            T04 w[NF4];
+            FOR_UNROLL (short i = 0; i < NF4; ++i) w[i] = xb4[i];
+            FOR_UNROLL (short t = 0; t < NTOK; ++t) {
+                float sumq = 0.f;
+                FOR_UNROLL (short i = 0; i < NF4; ++i) {
+                    sumq += dot(float4(w[i]), float4(yl4[t][i]));
+                }
+                sumf[t][row] += sumq;
+            }
+        }
+        FOR_UNROLL (short t = 0; t < NTOK; ++t) yb4[t] += NSG*NF*NW/4;
+    }
+    for (int i = nb*NB + sgitg*NW + tiisg; i < args.ne00; i += NW*NSG) {
+        for (short row = 0; row < NR0; row++) {
+            FOR_UNROLL (short t = 0; t < NTOK; ++t) sumf[t][row] += ax[row][i] * y[t][i];
+        }
+    }
+    FOR_UNROLL (short t = 0; t < NTOK; ++t) {
+        device float * dst_f32 = (device float *) dst + (uint64_t)im*args.ne0*args.ne1 + (uint64_t)(t0 + t)*args.ne0;
+        helper_mv_reduce_and_write<NR0>(dst_f32, sumf[t], r0, args.ne01, tiisg, sgitg, shmem + (uint)t*NR0*NW*sizeof(float));
+    }
+}
