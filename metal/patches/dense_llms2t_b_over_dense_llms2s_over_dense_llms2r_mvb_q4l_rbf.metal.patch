+kernel void kernel_llms_sum_slices(device const float * p [[buffer(0)]], device float * dst [[buffer(1)]], constant uint & n [[buffer(2)]],
+                                   constant uint & slices [[buffer(3)]], uint gid [[thread_position_in_grid]]) {
+    if (gid >= n) return;
+    float acc = p[gid];
+    for (uint s = 1; s < slices; s++) acc += p[s * n + gid];
+    dst[gid] = acc;
+}
