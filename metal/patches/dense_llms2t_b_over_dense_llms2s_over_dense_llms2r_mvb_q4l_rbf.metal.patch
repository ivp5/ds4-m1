+
+template<short NR0>
+static inline void llms_q4l_mv_grp_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                        threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+    const int K = args.ne00, nb = K / 32, g = (int)tgpig.z;
+    const int r0 = tgpig.x * NR0;
+    device const float * y = (device const float *) (src1 + (ulong)g * args.nb11);
+    device const char * wg = src0 + (ulong)g * args.nb02;
+    device const uint * wq[NR0]; device const half * ws[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int r = min(r0 + row, args.ne01 - 1);
+        device const char * rp = wg + (ulong)r * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[NR0] = { 0.f };
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        const float4 ya = *((device const float4 *) (y + ib * 32 + il * 8));
+        const float4 yb = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[row] += llms_q4l_dot8(wq[row][ib * 4 + il], ya, yb) * (float) ws[row][ib];
+        }
+    }
+    helper_mv_reduce_and_write<NR0>((device float *) dst + (ulong)g * args.ne01, sumf, r0, args.ne01, tiisg, sgitg, shmem);
+}
+[[host_name("kernel_llms_q4l_mv_grp")]]
+kernel void kernel_llms_q4l_mv_grp(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                   threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]],
+                                   ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    llms_q4l_mv_grp_impl<4>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg);
+}
