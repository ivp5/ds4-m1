+template<short r1ptg, short RPT, typename q_t, short chpb, void (*deq_t4)(device const q_t *, short, thread float4 &) >
+void kernel_llms_mul_mv_ext_rpt_impl(
+        constant ds4_metal_args_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG   = FC_mul_mv_nsg;
+    const short nxpsg = FC_mul_mv_nxpsg;
+    const short chpt = 4;
+    const short nypsg = (32/nxpsg);
+    const short tx = tiisg%nxpsg;
+    const short ty = tiisg/nxpsg;
+    const int i01_0 = (tgpig.x*(nypsg*NSG) + nypsg*sgitg + ty)*RPT;   // this lane's first row
+    const int i11 = tgpig.y*r1ptg;
+    const int i1m = tgpig.z;
+    const int i12 = i1m%args.ne12;
+    const int i13 = i1m/args.ne12;
+    const uint64_t offset1 = i11*args.nb11 + (i12        )*args.nb12 + (i13        )*args.nb13;
+    device const q_t * xq[RPT];
+    for (short r = 0; r < RPT; ++r) {
+        const int i01 = i01_0 + r;
+        const uint64_t offset0 = i01*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+        xq[r] = (i01 < args.ne01) ? (device const q_t *) (src0 + offset0) + tx/chpb : (device const q_t *) src0;
+    }
+    device const float4 * y4[r1ptg];
+    for (int ir1 = 0; ir1 < r1ptg; ++ir1) {
+        y4[ir1] = (i11 + ir1 < args.ne11) ? (device const float4 *) (src1 + offset1 + ir1*args.nb11) + tx : (device const float4 *) src1;
+    }
+    float sumf[RPT][r1ptg];
+    for (short r = 0; r < RPT; ++r) for (short ir1 = 0; ir1 < r1ptg; ++ir1) sumf[r][ir1] = 0.0f;
+    short cch = tx%chpb;
+    for (int ich = tx; 4*ich < args.ne00; ich += chpt*nxpsg) {
+        float4 lx[RPT][chpt];
+        short c = cch;
+        for (short r = 0; r < RPT; ++r) {
+            c = cch;
+            for (short ch = 0; ch < chpt; ++ch) {
+                deq_t4(xq[r], c, lx[r][ch]);
+                c += nxpsg;
+                if (c >= chpb) { xq[r] += c/chpb; c %= chpb; }
+            }
+        }
+        cch = c;
+        for (short ch = 0; ch < chpt; ++ch) {
+            for (short ir1 = 0; ir1 < r1ptg; ++ir1) {
+                const float4 yv = y4[ir1][ch*nxpsg];
+                for (short r = 0; r < RPT; ++r) sumf[r][ir1] += dot(lx[r][ch], yv);
+            }
+        }
+        for (short ir1 = 0; ir1 < r1ptg; ++ir1) y4[ir1] += chpt*nxpsg;
+    }
+    for (short r = 0; r < RPT; ++r) {
+        for (short ir1 = 0; ir1 < r1ptg; ++ir1) {
+            if (nxpsg >= 32) sumf[r][ir1] += simd_shuffle_down(sumf[r][ir1], 16);
+            if (nxpsg >= 16) sumf[r][ir1] += simd_shuffle_down(sumf[r][ir1],  8);
+            if (nxpsg >=  8) sumf[r][ir1] += simd_shuffle_down(sumf[r][ir1],  4);
+            if (nxpsg >=  4) sumf[r][ir1] += simd_shuffle_down(sumf[r][ir1],  2);
+            if (nxpsg >=  2) sumf[r][ir1] += simd_shuffle_down(sumf[r][ir1],  1);
+        }
+    }
+    if (tx == 0) {
+        for (short r = 0; r < RPT; ++r) {
+            const int i01 = i01_0 + r;
+            for (short ir1 = 0; ir1 < r1ptg && i11 + ir1 < args.ne11; ++ir1) {
+                device float * dst_f32 = (device float *) dst + (uint64_t)i1m*args.ne0*args.ne1 + (uint64_t)(i11 + ir1)*args.ne0;
+                if (i01 < args.ne01) dst_f32[i01] = sumf[r][ir1];
+            }
+        }
+    }
+}
