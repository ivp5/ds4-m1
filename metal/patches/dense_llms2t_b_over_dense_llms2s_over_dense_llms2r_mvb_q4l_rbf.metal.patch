+/* llms SHEXP_PAIR (make_dense_pair.py): gate and up of the shared expert in one 16-token half-tile pass, SwiGLU in the epilogue */
+struct llms_pair_args { int K; int rows; ulong row_bytes; ulong x_tok_stride; ulong dst_tok_stride; float limit; float alpha; };
+template<short NSG, short NRT>
+void kernel_llms_q8_sgmh16_pair_impl(constant llms_pair_args & args, device const char * wg, device const char * wu, device const char * src1, device char * dst,
+                                     threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    constexpr short NR = NRT * 8;
+    constexpr short LPR = 32 / NR;
+    constexpr short WPL = NR;
+    constexpr uint a_bytes = NR * 32 * 2, b_bytes = 32 * 16 * 2, per_sg = 2 * a_bytes + b_bytes;
+    const int nb = args.K / 32;
+    const int r0 = tgpig.x * NR;
+    threadgroup char * Ag = shmem + sgitg * per_sg;
+    threadgroup char * Au = Ag + a_bytes;
+    threadgroup half * Bs = (threadgroup half *)(Au + a_bytes);
+    threadgroup float * Csg = (threadgroup float *)(shmem + NSG * per_sg);
