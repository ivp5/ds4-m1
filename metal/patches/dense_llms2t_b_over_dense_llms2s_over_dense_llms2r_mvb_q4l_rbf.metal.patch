+            for (short s = 1; s < NSG; s++) { g += Csg[s * (NR * 16) + e]; u += Csu[s * (NR * 16) + e]; }
+            const short row = e / 16, tok = e % 16;
+            if (r0 + row < args.rows) {
+                float a0 = g, a1 = u;
+                if (args.limit > 1.0e-6f) { a0 = min(a0, args.limit); a1 = clamp(a1, -args.limit, args.limit); }
