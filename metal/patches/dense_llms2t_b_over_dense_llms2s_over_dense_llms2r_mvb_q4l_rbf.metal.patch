+    kernel_llms_mul_mv_q8_sgmh16_impl<NSG, NRT>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
+LLMS_SGMH16(kernel_llms_mul_mv_q8_0_f32_sgmh16_k8r2, 8, 2)
