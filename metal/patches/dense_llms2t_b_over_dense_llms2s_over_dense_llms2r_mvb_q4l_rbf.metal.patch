+/* llms T32_BF16 (make_dense_t32b.py): the t32y kernels with the bf16 rounding folded into the store */
+#define LLMS_T32YB(NAME, NSG, NRT) \
+kernel void NAME(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst, \
+                 threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { \
+    llms_t32y_impl<NSG, NRT, false, true>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
+LLMS_T32YB(kernel_llms_mul_mv_q8_0_f32_t32y_k4r2_b, 4, 2)
+LLMS_T32YB(kernel_llms_mul_mv_q8_0_f32_t32y_k4r4_b, 4, 4)
+LLMS_T32YB(kernel_llms_mul_mv_q8_0_f32_t32y_k8r4_b, 8, 4)
