+/* llms EXT_SGMH (make_dense_t4.py 17:1x; bench v8 of throughput/ds41_kbench_dq_kernels.metal): the 8-token dense Q8_0 matvec on HALF
+ * simdgroup-matrix tiles, NRT x 8 weight rows per simdgroup sharing one activation tile, the blocks split over the NSG simdgroups
+ * of a threadgroup, partial C tiles summed in a fixed order. The tile kernels are bound by the bytes through the core's load/store
+ * port (4 KB per 8 rows x 32 k x 8 tokens in the float form); half tiles and shared activation tiles move 1.2-1.5 KB. Numerics:
+ * w = q x d rounded to half, x clamped and rounded to half (the stock engine's prefill class), float accumulation: NLL-gated.
+ * Grouped form (n_groups > 1, grid z): attn_output_a's 8 groups x [rank x group_dim]. n_tok must be 8. */
+struct llms_sgmh_args { int K; int rows; int n_tok; int n_groups; ulong row_bytes; ulong group_bytes; ulong x_tok_stride; ulong x_group_stride; ulong dst_tok_stride; ulong dst_group_stride; };
+template<short NSG, short NRT>
+void kernel_llms_mul_mv_q8_sgmh_impl(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst,
+                                     threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    constexpr short NR = NRT * 8;            // rows per threadgroup
+    constexpr short LPR = 32 / NR;           // lanes per row
+    constexpr short WPL = NR;                // weights per lane per block
+    constexpr uint a_bytes = NR * 32 * 2, per_sg = a_bytes + 512;
+    const int nb = args.K / 32;
+    const int r0 = tgpig.x * NR;
+    const uint g = tgpig.z;
+    threadgroup char * As = shmem + sgitg * per_sg;                          // [NR][32] half
+    threadgroup half * Bs = (threadgroup half *)(As + a_bytes);              // [32][8] half
+    threadgroup float * Cs = (threadgroup float *)(shmem + NSG * per_sg);    // [sg][NR][8] float
+    simdgroup_float8x8 C[NRT];
+    FOR_UNROLL (short t = 0; t < NRT; t++) C[t] = make_filled_simdgroup_matrix<float, 8>(0.f);
+    const short lr = tiisg / LPR, lq = tiisg % LPR;
+    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
+    device const char * xrow = src0 + (uint64_t)g * args.group_bytes + (uint64_t)rr * args.row_bytes;
+    const short bt = tiisg / 4, bq = tiisg % 4;
+    device const float4 * yt = (device const float4 *)(src1 + (uint64_t)g * args.x_group_stride + (uint64_t)bt * args.x_tok_stride) + bq * 2;
+    threadgroup half4 * a4 = (threadgroup half4 *)(As + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
+    threadgroup half * bs = Bs + (bq * 8) * 8 + bt;
+    for (int ib = sgitg; ib < nb; ib += NSG) {
+        device const char * b = xrow + (uint64_t)ib * 34u;
+        const float d = (float)*(device const half *)b;
+        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
+        FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; a4[j] = half4(float4(q) * d); }
+        const half4 x0 = half4(clamp(yt[ib * 8], -65504.0f, 65504.0f)), x1 = half4(clamp(yt[ib * 8 + 1], -65504.0f, 65504.0f));
+        bs[0] = x0.x; bs[8] = x0.y; bs[16] = x0.z; bs[24] = x0.w; bs[32] = x1.x; bs[40] = x1.y; bs[48] = x1.z; bs[56] = x1.w;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
+            simdgroup_half8x8 B; simdgroup_load(B, Bs + kt * 64, 8);
+            FOR_UNROLL (short t = 0; t < NRT; t++) { simdgroup_half8x8 A; simdgroup_load(A, (threadgroup half *)As + t * 8 * 32 + kt * 8, 32); simdgroup_multiply_accumulate(C[t], A, B, C[t]); }
+        }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    FOR_UNROLL (short t = 0; t < NRT; t++) simdgroup_store(C[t], Cs + sgitg * (NR * 8) + t * 64, 8);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgitg == 0) {
+        for (short e = tiisg; e < NR * 8; e += 32) {
+            float acc = Cs[e];
+            for (short s = 1; s < NSG; s++) acc += Cs[s * (NR * 8) + e];
+            const short row = e / 8, tok = e % 8;
+            if (r0 + row < args.rows) ((device float *)(dst + (uint64_t)tok * args.dst_tok_stride + (uint64_t)g * args.dst_group_stride))[r0 + row] = acc;
+        }
+    }
+}
