+LLMS_T32Y(kernel_llms_mul_mv_q8_0_f32_t32y_k4r2, 4, 2, false)
+LLMS_T32Y(kernel_llms_mul_mv_q8_0_f32_t32y_k4r2_c, 4, 2, true)
