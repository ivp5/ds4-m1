+            for (short s = 1; s < NSG; s++) acc += Cs[s * 128 + e];
+            const short half_ = e / 64, row = (e % 64) / 8, tok = (e % 64) % 8 + half_ * 8;
+            if (r0 + row < args.ne01 && tok < args.ne11) ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = acc;
+        }
+    }
