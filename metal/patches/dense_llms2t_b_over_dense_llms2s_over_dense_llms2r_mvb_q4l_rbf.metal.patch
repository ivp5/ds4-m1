+/* llms SGMT32X (make_dense_t32x.py): the transposed 32-token tiles */
+/* v1: transposed tile -- activations straight from device memory as float A tiles, dequantized weights as transposed half B tiles */
+template<short NSG, short NRT, bool CAN>
+void llms_t32x_impl(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst,
+                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    constexpr short NR = NRT * 8;
+    constexpr short LPR = 32 / NR;
+    constexpr short WPL = NR;
+    constexpr uint a_bytes = NR * 32 * 2;
+    const int nb = args.K / 32;
+    const int r0 = tgpig.x * NR;
+    threadgroup char * As = shmem + sgitg * a_bytes;                         // [NR rows][32 k] half
+    threadgroup float * Cs = (threadgroup float *)shmem;                     // [sg][32 tok][NR] float, aliased after the loop
+    simdgroup_float8x8 C[4][NRT];                                            // [token tile][row tile]
+    FOR_UNROLL (short a = 0; a < 4; a++) FOR_UNROLL (short t = 0; t < NRT; t++) C[a][t] = make_filled_simdgroup_matrix<float, 8>(0.f);
+    const short lr = tiisg / LPR, lq = tiisg % LPR;
+    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
+    device const char * xrow = src0 + (uint64_t)rr * args.row_bytes;
+    threadgroup half4 * a4 = (threadgroup half4 *)(As + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
+    device const float * X = (device const float *)src1 + (CAN ? 1 : 0);
+    const ulong xs = args.x_tok_stride / 4;                                  // floats per token row
+    for (int ib = sgitg; ib < nb; ib += NSG) {
+        device const char * b = xrow + (uint64_t)ib * 34u;
+        const float d = (float)*(device const half *)b;
+        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
+        FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; a4[j] = half4(float4(q) * d); }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
+            simdgroup_float8x8 A0, A1, A2, A3;                               // X[tok 8][k 8], 4 token tiles
+            simdgroup_load(A0, X + 0 * 8 * xs + ib * 32 + kt * 8, xs);
+            simdgroup_load(A1, X + 1 * 8 * xs + ib * 32 + kt * 8, xs);
+            simdgroup_load(A2, X + 2 * 8 * xs + ib * 32 + kt * 8, xs);
+            simdgroup_load(A3, X + 3 * 8 * xs + ib * 32 + kt * 8, xs);
+            FOR_UNROLL (short t = 0; t < NRT; t++) {
+                simdgroup_half8x8 B;                                         // W^T[k 8][row 8] = transposed load of W[row][k]
+                simdgroup_load(B, (threadgroup half *)As + t * 8 * 32 + kt * 8, 32, ulong2(0, 0), true);
+                simdgroup_multiply_accumulate(C[0][t], A0, B, C[0][t]);
+                simdgroup_multiply_accumulate(C[1][t], A1, B, C[1][t]);
+                simdgroup_multiply_accumulate(C[2][t], A2, B, C[2][t]);
+                simdgroup_multiply_accumulate(C[3][t], A3, B, C[3][t]);
+            }
+        }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    FOR_UNROLL (short a = 0; a < 4; a++) FOR_UNROLL (short t = 0; t < NRT; t++)
+        simdgroup_store(C[a][t], Cs + sgitg * (32 * NR) + (a * 8) * NR + t * 8, NR);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgitg == 0) {
+        for (short e = tiisg; e < NR * 32; e += 32) {
+            float acc = Cs[e];
+            for (short s2 = 1; s2 < NSG; s2++) acc += Cs[s2 * (32 * NR) + e];
+            const short tok = e / NR, row = e % NR;
+            if (r0 + row < args.rows) ((device float *)(dst + (uint64_t)tok * args.dst_tok_stride))[r0 + row] = acc;
+        }
+    }
+}
+/* v2: v1 with a two-stage reduction -- the partials pass through HALF the area (sg NSG/2.. store, sg 0.. add; repeat), so the threadgroup
+   memory is max(A tiles, NSG/2 x 32 x NR x 4) instead of NSG x 32 x NR x 4 (k4r4: 8 KB instead of 16) -- more threadgroups per core */
+template<short NSG, short NRT, bool CAN, bool RB = false>   /* llms T32_BF16 (make_dense_t32b.py): RB rounds the outputs to bf16 */
+void llms_t32y_impl(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst,
+                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    constexpr short NR = NRT * 8;
+    constexpr short LPR = 32 / NR;
+    constexpr short WPL = NR;
+    constexpr uint a_bytes = NR * 32 * 2;
+    const int nb = args.K / 32;
+    const int r0 = tgpig.x * NR;
+    threadgroup char * As = shmem + sgitg * a_bytes;
+    threadgroup float * Cs = (threadgroup float *)shmem;
+    simdgroup_float8x8 C[4][NRT];
+    FOR_UNROLL (short a = 0; a < 4; a++) FOR_UNROLL (short t = 0; t < NRT; t++) C[a][t] = make_filled_simdgroup_matrix<float, 8>(0.f);
+    const short lr = tiisg / LPR, lq = tiisg % LPR;
+    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
+    device const char * xrow = src0 + (uint64_t)rr * args.row_bytes;
+    threadgroup half4 * a4 = (threadgroup half4 *)(As + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
+    device const float * X = (device const float *)src1 + (CAN ? 1 : 0);
+    const ulong xs = args.x_tok_stride / 4;
+    for (int ib = sgitg; ib < nb; ib += NSG) {
+        device const char * b = xrow + (uint64_t)ib * 34u;
+        const float d = (float)*(device const half *)b;
+        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
+        FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; a4[j] = half4(float4(q) * d); }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
+            simdgroup_float8x8 A0, A1, A2, A3;
+            simdgroup_load(A0, X + 0 * 8 * xs + ib * 32 + kt * 8, xs);
+            simdgroup_load(A1, X + 1 * 8 * xs + ib * 32 + kt * 8, xs);
+            simdgroup_load(A2, X + 2 * 8 * xs + ib * 32 + kt * 8, xs);
+            simdgroup_load(A3, X + 3 * 8 * xs + ib * 32 + kt * 8, xs);
+            FOR_UNROLL (short t = 0; t < NRT; t++) {
+                simdgroup_half8x8 B;
+                simdgroup_load(B, (threadgroup half *)As + t * 8 * 32 + kt * 8, 32, ulong2(0, 0), true);
+                simdgroup_multiply_accumulate(C[0][t], A0, B, C[0][t]);
+                simdgroup_multiply_accumulate(C[1][t], A1, B, C[1][t]);
+                simdgroup_multiply_accumulate(C[2][t], A2, B, C[2][t]);
+                simdgroup_multiply_accumulate(C[3][t], A3, B, C[3][t]);
+            }
+        }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    /* fixed-order tree: half the simdgroups store, the other half add (s += s + half), until one remains */
+    for (short half_n = NSG / 2; half_n >= 1; half_n /= 2) {
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sgitg >= half_n && sgitg < 2 * half_n) {
+            FOR_UNROLL (short a = 0; a < 4; a++) FOR_UNROLL (short t = 0; t < NRT; t++)
+                simdgroup_store(C[a][t], Cs + (sgitg - half_n) * (32 * NR) + (a * 8) * NR + t * 8, NR);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sgitg < half_n) {
+            FOR_UNROLL (short a = 0; a < 4; a++) FOR_UNROLL (short t = 0; t < NRT; t++) {
+                simdgroup_float8x8 P; simdgroup_load(P, Cs + sgitg * (32 * NR) + (a * 8) * NR + t * 8, NR);
+                thread auto & pe = P.thread_elements(); thread auto & ce = C[a][t].thread_elements();
+                ce[0] += pe[0]; ce[1] += pe[1];
+            }
+        }
+    }
+    if (sgitg == 0) {
+        FOR_UNROLL (short a = 0; a < 4; a++) FOR_UNROLL (short t = 0; t < NRT; t++) {
+            if (RB) { thread auto & ce = C[a][t].thread_elements();   /* kernel_dsv41_bf16_linear's rounding, element by element */
+                for (short k = 0; k < 2; k++) { uint bits = as_type<uint>((float)ce[k]); if ((bits & 0x7f800000u) != 0x7f800000u) bits += 0x7fffu + ((bits >> 16u) & 1u); ce[k] = as_type<float>(bits & 0xffff0000u); } }
+            if (r0 + t * 8 + 8 <= args.rows) simdgroup_store(C[a][t], (device float *)(dst + (uint64_t)(a * 8) * args.dst_tok_stride) + r0 + t * 8, args.dst_tok_stride / 4);
+        }
+    }
+}
