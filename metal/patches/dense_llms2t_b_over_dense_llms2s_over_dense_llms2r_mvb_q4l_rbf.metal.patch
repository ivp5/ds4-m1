+[[host_name("kernel_mul_mv_q8_0_f32_b")]]
+kernel void kernel_mul_mv_q8_0_f32_b(
+        constant ds4_metal_args_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    llms_mul_mv_q8_0_f32_b_impl<N_R0_Q8_0, constant ds4_metal_args_mul_mv &>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg);
+}
+
+
+
+// Per row of K weights: K/2 bytes of nibbles (weight t of block b at byte 16b + t/2, low nibble for even t), then K/32 f16 scales.
+static inline float llms_q4l_dot8(uint w, float4 a, float4 b) {
+    const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+    const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+    const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+    const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+    return ((float)h0.x * a.x + (float)h1.x * a.y) + ((float)h2.x * a.z + (float)h3.x * a.w)
+         + ((float)h0.y * b.x + (float)h1.y * b.y) + ((float)h2.y * b.z + (float)h3.y * b.w);
+}
+template<short NR0, bool RB>
+static inline void llms_q4l_mv_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                    threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+    const int K = args.ne00, nb = K / 32;
+    const int r0 = tgpig.x * NR0;
+    device const float * y = (device const float *) src1;
+    device const uint * wq[NR0]; device const half * ws[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int r = min(r0 + row, args.ne01 - 1);   // rows past the end read the last row; the store skips them
+        device const char * rp = src0 + (ulong)r * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[NR0] = { 0.f };
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        const float4 ya = *((device const float4 *) (y + ib * 32 + il * 8));
+        const float4 yb = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[row] += llms_q4l_dot8(wq[row][ib * 4 + il], ya, yb) * (float) ws[row][ib];
+        }
+    }
+    if (RB) llms_mv_reduce_and_write_b<NR0>((device float *) dst, sumf, r0, args.ne01, tiisg, sgitg, shmem);
+    else    helper_mv_reduce_and_write<NR0>((device float *) dst, sumf, r0, args.ne01, tiisg, sgitg, shmem);
+}
+[[host_name("kernel_llms_q4l_mv")]]
+kernel void kernel_llms_q4l_mv(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                               threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]],
+                               ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    llms_q4l_mv_impl<4, false>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg);
+}
+[[host_name("kernel_llms_q4l_mv_b")]]
+kernel void kernel_llms_q4l_mv_b(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                 threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]],
+                                 ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    llms_q4l_mv_impl<4, true>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg);
+}
