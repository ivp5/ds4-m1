+/* llms EXT_SGMH16 (make_dense_sgmh16.py): the half-tile kernel at sixteen tokens -- two activation tiles per staged weight tile */
+template<short NSG, short NRT>
+void kernel_llms_mul_mv_q8_sgmh16_impl(constant llms_sgmh_args & args, device const char * src0, device const char * src1, device char * dst,
+                                       threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    constexpr short NR = NRT * 8;
+    constexpr short LPR = 32 / NR;
+    constexpr short WPL = NR;
+    constexpr uint a_bytes = NR * 32 * 2, b_bytes = 32 * 16 * 2, per_sg = a_bytes + b_bytes;
+    const int nb = args.K / 32;
+    const int r0 = tgpig.x * NR;
+    const uint g = tgpig.z;
+    threadgroup char * As = shmem + sgitg * per_sg;                          // [NR][32] half
+    threadgroup half * Bs = (threadgroup half *)(As + a_bytes);              // [32 k][16 tok] half
+    threadgroup float * Cs = (threadgroup float *)(shmem + NSG * per_sg);    // [sg][NR][16] float
+    simdgroup_float8x8 C0[NRT], C1[NRT];
+    FOR_UNROLL (short t = 0; t < NRT; t++) { C0[t] = make_filled_simdgroup_matrix<float, 8>(0.f); C1[t] = make_filled_simdgroup_matrix<float, 8>(0.f); }
+    const short lr = tiisg / LPR, lq = tiisg % LPR;
+    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
+    device const char * xrow = src0 + (uint64_t)g * args.group_bytes + (uint64_t)rr * args.row_bytes;
+    const short bt = tiisg / 4, bq = tiisg % 4;
+    device const float4 * yt0 = (device const float4 *)(src1 + (uint64_t)g * args.x_group_stride + (uint64_t)bt * args.x_tok_stride) + bq * 2;
+    device const float4 * yt1 = (device const float4 *)(src1 + (uint64_t)g * args.x_group_stride + (uint64_t)(bt + 8) * args.x_tok_stride) + bq * 2;
+    threadgroup half4 * a4 = (threadgroup half4 *)(As + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
+    threadgroup half * bs = Bs + (bq * 8) * 16 + bt;
+    for (int ib = sgitg; ib < nb; ib += NSG) {
+        device const char * b = xrow + (uint64_t)ib * 34u;
+        const float d = (float)*(device const half *)b;
+        device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
+        FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; a4[j] = half4(float4(q) * d); }
+        const half4 x0 = half4(clamp(yt0[ib * 8], -65504.0f, 65504.0f)), x1 = half4(clamp(yt0[ib * 8 + 1], -65504.0f, 65504.0f));
+        const half4 y0 = half4(clamp(yt1[ib * 8], -65504.0f, 65504.0f)), y1 = half4(clamp(yt1[ib * 8 + 1], -65504.0f, 65504.0f));
+        bs[0] = x0.x; bs[16] = x0.y; bs[32] = x0.z; bs[48] = x0.w; bs[64] = x1.x; bs[80] = x1.y; bs[96] = x1.z; bs[112] = x1.w;
+        bs[8] = y0.x; bs[24] = y0.y; bs[40] = y0.z; bs[56] = y0.w; bs[72] = y1.x; bs[88] = y1.y; bs[104] = y1.z; bs[120] = y1.w;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
+            simdgroup_half8x8 B0, B1;
+            simdgroup_load(B0, Bs + kt * 128, 16);
+            simdgroup_load(B1, Bs + kt * 128 + 8, 16);
+            FOR_UNROLL (short t = 0; t < NRT; t++) {
+                simdgroup_half8x8 A; simdgroup_load(A, (threadgroup half *)As + t * 8 * 32 + kt * 8, 32);
+                simdgroup_multiply_accumulate(C0[t], A, B0, C0[t]);
+                simdgroup_multiply_accumulate(C1[t], A, B1, C1[t]);
+            }
+        }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    FOR_UNROLL (short t = 0; t < NRT; t++) {
+        simdgroup_store(C0[t], Cs + sgitg * (NR * 16) + t * 128, 16);
+        simdgroup_store(C1[t], Cs + sgitg * (NR * 16) + t * 128 + 8, 16);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgitg == 0) {
+        for (short e = tiisg; e < NR * 16; e += 32) {
+            float acc = Cs[e];
+            for (short s = 1; s < NSG; s++) acc += Cs[s * (NR * 16) + e];
+            const short row = e / 16, tok = e % 16;
+            if (r0 + row < args.rows) ((device float *)(dst + (uint64_t)tok * args.dst_tok_stride + (uint64_t)g * args.dst_group_stride))[r0 + row] = acc;
+        }
+    }
+}
