+                                             U0[t] = make_filled_simdgroup_matrix<float, 8>(0.f); U1[t] = make_filled_simdgroup_matrix<float, 8>(0.f); }
+    const short lr = tiisg / LPR, lq = tiisg % LPR;
+    const int rr = (r0 + lr < args.rows) ? (r0 + lr) : (args.rows - 1);
+    device const char * xg = wg + (uint64_t)rr * args.row_bytes;
+    device const char * xu = wu + (uint64_t)rr * args.row_bytes;
+    const short bt = tiisg / 4, bq = tiisg % 4;
+    device const float4 * yt0 = (device const float4 *)(src1 + (uint64_t)bt * args.x_tok_stride) + bq * 2;
+    device const float4 * yt1 = (device const float4 *)(src1 + (uint64_t)(bt + 8) * args.x_tok_stride) + bq * 2;
+    threadgroup half4 * ag4 = (threadgroup half4 *)(Ag + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
+    threadgroup half4 * au4 = (threadgroup half4 *)(Au + ((uint)lr * 32u + (uint)lq * WPL) * 2u);
+    threadgroup half * bs = Bs + (bq * 8) * 16 + bt;
+    for (int ib = sgitg; ib < nb; ib += NSG) {
+        {
+            device const char * b = xg + (uint64_t)ib * 34u;
+            const float d = (float)*(device const half *)b;
+            device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
+            FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; ag4[j] = half4(float4(q) * d); }
+        }
+        {
+            device const char * b = xu + (uint64_t)ib * 34u;
+            const float d = (float)*(device const half *)b;
+            device const packed_char4 * q4 = (device const packed_char4 *)(b + 2 + lq * WPL);
+            FOR_UNROLL (short j = 0; j < WPL / 4; j++) { const packed_char4 q = q4[j]; au4[j] = half4(float4(q) * d); }
+        }
+        const half4 x0 = half4(clamp(yt0[ib * 8], -65504.0f, 65504.0f)), x1 = half4(clamp(yt0[ib * 8 + 1], -65504.0f, 65504.0f));
+        const half4 y0 = half4(clamp(yt1[ib * 8], -65504.0f, 65504.0f)), y1 = half4(clamp(yt1[ib * 8 + 1], -65504.0f, 65504.0f));
+        bs[0] = x0.x; bs[16] = x0.y; bs[32] = x0.z; bs[48] = x0.w; bs[64] = x1.x; bs[80] = x1.y; bs[96] = x1.z; bs[112] = x1.w;
+        bs[8] = y0.x; bs[24] = y0.y; bs[40] = y0.z; bs[56] = y0.w; bs[72] = y1.x; bs[88] = y1.y; bs[104] = y1.z; bs[120] = y1.w;
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        FOR_UNROLL (short kt = 0; kt < 4; kt++) {
+            simdgroup_half8x8 B0, B1;
+            simdgroup_load(B0, Bs + kt * 128, 16);
+            simdgroup_load(B1, Bs + kt * 128 + 8, 16);
+            FOR_UNROLL (short t = 0; t < NRT; t++) {
+                simdgroup_half8x8 A; simdgroup_load(A, (threadgroup half *)Ag + t * 8 * 32 + kt * 8, 32);
+                simdgroup_multiply_accumulate(G0[t], A, B0, G0[t]);
+                simdgroup_multiply_accumulate(G1[t], A, B1, G1[t]);
+                simdgroup_half8x8 C; simdgroup_load(C, (threadgroup half *)Au + t * 8 * 32 + kt * 8, 32);
+                simdgroup_multiply_accumulate(U0[t], C, B0, U0[t]);
+                simdgroup_multiply_accumulate(U1[t], C, B1, U1[t]);
+            }
+        }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    FOR_UNROLL (short t = 0; t < NRT; t++) {
+        simdgroup_store(G0[t], Csg + sgitg * (NR * 16) + t * 128, 16);
+        simdgroup_store(G1[t], Csg + sgitg * (NR * 16) + t * 128 + 8, 16);
+        simdgroup_store(U0[t], Csu + sgitg * (NR * 16) + t * 128, 16);
+        simdgroup_store(U1[t], Csu + sgitg * (NR * 16) + t * 128 + 8, 16);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
