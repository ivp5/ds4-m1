+template<short NSG, bool KSPLIT>
+void kernel_llms_mul_mv_q8_sgm8_impl(constant ds4_metal_args_mul_mv_ext & args, device const char * src0, device const char * src1, device char * dst,
+                    threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const int nb = args.ne00 / 32;
+    const int r0 = KSPLIT ? tgpig.x * 8 : (tgpig.x * NSG + sgitg) * 8;
+    threadgroup float * As = (threadgroup float *)shmem + sgitg * 128;               // [row 8][k 16]
+    threadgroup float * Bs = (threadgroup float *)shmem + NSG * 128 + sgitg * 128;   // [k 16][tok 8]
+    threadgroup float * Cs = (threadgroup float *)shmem + 2 * NSG * 128;             // [sg][row 8][tok 8]
+    simdgroup_float8x8 C = make_filled_simdgroup_matrix<float, 8>(0.f);
+    const short lr = tiisg / 4, lq = tiisg % 4;
+    const int rr = (r0 + lr < args.ne01) ? (r0 + lr) : (args.ne01 - 1);
+    device const char * xrow = src0 + (uint64_t)rr * args.nb01;
+    device const float4 * yt = (device const float4 *)(src1 + (uint64_t)lr * args.nb11) + lq;   // token lr, quad lq
+    threadgroup float4 * as4 = (threadgroup float4 *)(As + lr * 16 + lq * 4);
+    threadgroup float * bs = Bs + (lq * 4) * 8 + lr;
+    const int ib0 = KSPLIT ? sgitg : 0, ibs = KSPLIT ? NSG : 1;
+    for (int ib = ib0; ib < nb; ib += ibs) {
+        device const char * b = xrow + (uint64_t)ib * 34u;
+        const float d = (float)*(device const half *)b;
+        FOR_UNROLL (short h = 0; h < 2; h++) {
+            const packed_char4 q = *(device const packed_char4 *)(b + 2 + h * 16 + lq * 4);
+            as4[0] = float4(q) * d;
+            const float4 x = yt[ib * 8 + h * 4];
+            bs[0] = x.x; bs[8] = x.y; bs[16] = x.z; bs[24] = x.w;
+            simdgroup_barrier(mem_flags::mem_threadgroup);
+            FOR_UNROLL (short kt = 0; kt < 2; kt++) {
+                simdgroup_float8x8 A, B;
+                simdgroup_load(A, As + kt * 8, 16);
+                simdgroup_load(B, Bs + kt * 64, 8);
+                simdgroup_multiply_accumulate(C, A, B, C);
+            }
+            simdgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+    simdgroup_store(C, Cs + sgitg * 64, 8);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (KSPLIT) {
+        if (sgitg == 0) {
+            for (short e = tiisg; e < 64; e += 32) {
+                float acc = Cs[e];
+                for (short s = 1; s < NSG; s++) acc += Cs[s * 64 + e];
+                const short row = e / 8, tok = e % 8;
+                if (r0 + row < args.ne01) ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = acc;
+            }
+        }
+    } else {
+        for (short e = tiisg; e < 64; e += 32) {
+            const short row = e / 8, tok = e % 8;
+            if (r0 + row < args.ne01) ((device float *)dst)[(uint64_t)tok * args.ne0 + r0 + row] = Cs[sgitg * 64 + e];
+        }
+    }
+}
+#define LLMS_SGM8(NAME, NSG, KSPLIT) \
