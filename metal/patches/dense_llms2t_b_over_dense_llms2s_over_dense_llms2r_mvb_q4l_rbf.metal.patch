+/* llms ROUTE_DROP (make_dense_t4.py 17:4x): a FIDELITY DIAL, measurement only -- per token the smallest of the six route weights set
+ * to zero (mode 1), or zeroed with the other five renormalized to the original sum (mode 2 = what top-5 routing would weigh). The
+ * dropped expert is still loaded and computed (its mid is multiplied by zero): this prices the NLL of top-5, not its speed. */
+kernel void kernel_llms_route_drop_min(device float * w [[buffer(0)]], constant uint & n_tok [[buffer(1)]], constant uint & mode [[buffer(2)]],
+                                       uint gid [[thread_position_in_grid]]) {
+    if (gid >= n_tok) return;
+    device float * t = w + gid * 6u;
+    if (mode >= 3000u) {   /* llms ROUTE_DROP threshold (apply_ds4_fidelity_dials.py): weights under tau x sum zeroed (never the largest), the rest renormalized */
+        const float tau = (float)(mode - 3000u) * 1e-3f;
+        uint jx = 0; float s6 = 0.0f;
+        for (uint j = 0; j < 6; j++) { s6 += t[j]; if (t[j] > t[jx]) jx = j; }
+        float kept = 0.0f;
+        for (uint j = 0; j < 6; j++) if (j == jx || t[j] >= tau * s6) kept += t[j];
+        const float rr = kept > 0.0f ? s6 / kept : 1.0f;
+        for (uint j = 0; j < 6; j++) t[j] = (j == jx || t[j] >= tau * s6) ? t[j] * rr : 0.0f;
+        return;
+    }
+    if (mode == 4u) {   /* llms ROUTE_DROP top-4 (apply_ds4_route_top4.py): the two smallest zeroed, the other four renormalized */
+        uint j1 = 0; for (uint j = 1; j < 6; j++) if (t[j] < t[j1]) j1 = j;
+        uint j2 = j1 == 0u ? 1u : 0u; for (uint j = 0; j < 6; j++) if (j != j1 && t[j] < t[j2]) j2 = j;
+        float s6 = 0.0f; for (uint j = 0; j < 6; j++) s6 += t[j];
+        const float kept = s6 - t[j1] - t[j2];
+        const float rr = kept > 0.0f ? s6 / kept : 1.0f;
+        for (uint j = 0; j < 6; j++) t[j] = (j == j1 || j == j2) ? 0.0f : t[j] * rr;
+        return;
+    }
+    uint jm = 0; float wm = t[0], sum = t[0];
+    for (uint j = 1; j < 6; j++) { sum += t[j]; if (t[j] < wm) { wm = t[j]; jm = j; } }
+    const float r = (mode == 2u && sum > wm) ? sum / (sum - wm) : 1.0f;
+    for (uint j = 0; j < 6; j++) t[j] = (j == jm) ? 0.0f : t[j] * r;
+}
