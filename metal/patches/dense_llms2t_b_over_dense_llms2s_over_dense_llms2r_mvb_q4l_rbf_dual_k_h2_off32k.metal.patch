+// weight word once (llms_q4l_dot8's exact expression per column) and accumulates every column; NR0 rows per threadgroup; per column the
+// same lane order, the same block stride and the same reduction / bf16 store as kernel_llms_q4l_mv_b: bit-identical column by column. ----
+template<short NR0, short KC, bool RB>
+static inline void llms_q4l_mv_k_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+    const int K = args.ne00, nb = K / 32;
+    const int r0 = tgpig.x * NR0;
+    device const uint * wq[NR0]; device const half * ws[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int r = min(r0 + row, args.ne01 - 1);
+        device const char * rp = src0 + (ulong)r * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[KC][NR0];
+    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        float4 ya[KC], yb[KC];
+        FOR_UNROLL (short c = 0; c < KC; ++c) {
+            device const float * y = (device const float *) (src1 + (ulong)c * args.nb11);
+            ya[c] = *((device const float4 *) (y + ib * 32 + il * 8));
+            yb[c] = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
+        }
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const uint w = wq[row][ib * 4 + il];
+            const float sc = (float) ws[row][ib];
+            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+#if LLMS_Q4L_HALF2   /* apply_half2.py: the products in half2 (kh_bench 02:41), a compile-time switch from LLMS_DS4_Q4L_HALF2 */
+            FOR_UNROLL (short c = 0; c < KC; ++c) {
+                const float4 a = ya[c], b = yb[c];
+                half2 p = h0 * half2((half)a.x, (half)b.x);
+                p = fma(h1, half2((half)a.y, (half)b.y), p);
+                p = fma(h2, half2((half)a.z, (half)b.z), p);
+                p = fma(h3, half2((half)a.w, (half)b.w), p);
+                sumf[c][row] += ((float)p.x + (float)p.y) * sc;
+            }
+#else
+            FOR_UNROLL (short c = 0; c < KC; ++c) {
+                const float4 a = ya[c], b = yb[c];
+                const float d8 = ((float)h0.x * a.x + (float)h1.x * a.y) + ((float)h2.x * a.z + (float)h3.x * a.w)
+                               + ((float)h0.y * b.x + (float)h1.y * b.y) + ((float)h2.y * b.z + (float)h3.y * b.w);
+                sumf[c][row] += d8 * sc;
+            }
+#endif
+        }
+    }
+#ifndef LLMS_Q4L_CE3
+#define LLMS_Q4L_CE3 0
+#endif
+#ifndef LLMS_Q4L_HALF2
+#define LLMS_Q4L_HALF2 0
+#endif
+#if LLMS_Q4L_CE
+
+    if (NSG == 2 && RB && ((NR0 == 4 && KC == 2) || (LLMS_Q4L_CE3 && ((NR0 == 4 && KC == 4) || (NR0 == 8 && KC == 3))))) {
+        threadgroup float *partial = (threadgroup float *)shmem;
+        device float *dst_f = (device float *)dst;
+        FOR_UNROLL (short c = 0; c < KC; ++c) {
+            if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                float v = simd_sum(sumf[c][row]);
+                if (tiisg == 0) partial[row * NSG + sgitg] = v;
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (sgitg == 0) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                float v = tiisg < NSG ? partial[row * NSG + tiisg] : 0.f;
+                float tot = simd_sum(v);
+                if (tiisg == 0 && r0 + row < args.ne01) {
+                    if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
+                    dst_f[(ulong)c * (ulong)args.ne01 + (ulong)(r0 + row)] = tot;
+                }
+            }
+        }
+        return;
+    }
+#endif
+    FOR_UNROLL (short c = 0; c < KC; ++c) {
+        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float * dc = (device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u);
+        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+    }
+}
+// ---- llms Q4L_HX (apply_hx.py): the two-row kernels on HALF x with the half2 products (kx_bench 02:56) ----
+template<short NR0, short KC, bool RB>
+static inline void llms_q4l_mv_kxh_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg & 0xFF; const bool LEAN = (FC_mul_mv_nsg & 0x100) != 0;   /* llms Q4L_LEAN2: the flag rides the NSG constant */
+    const int K = args.ne00, nb = K / 32;
+    const int r0 = tgpig.x * NR0;
+    device const uint * wq[NR0]; device const half * ws[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int r = min(r0 + row, args.ne01 - 1);
+        device const char * rp = src0 + (ulong)r * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[KC][NR0];
+    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        float4 ya[KC], yb[KC];
+        FOR_UNROLL (short c = 0; c < KC; ++c) {
+            device const half * y = (device const half *) src1 + (ulong)c * (ulong)args.ne00;   /* x as half: the f32->f16 copy's row stride = ne00 halves (apply_hx.py) */
+            ya[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8)));
+            yb[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8 + 4)));
+        }
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const uint w = wq[row][ib * 4 + il];
+            const float sc = (float) ws[row][ib];
+            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            FOR_UNROLL (short c = 0; c < KC; ++c) {
+                const float4 a = ya[c], b = yb[c];
+                half2 p = h0 * half2((half)a.x, (half)b.x);
+                p = fma(h1, half2((half)a.y, (half)b.y), p);
+                p = fma(h2, half2((half)a.z, (half)b.z), p);
+                p = fma(h3, half2((half)a.w, (half)b.w), p);
+                sumf[c][row] += ((float)p.x + (float)p.y) * sc;
+            }
+        }
+    }
+#ifndef LLMS_Q4L_LEAN2_OFF
+    if (LEAN && NSG == 2) {
+        threadgroup float * part = (threadgroup float *) shmem;
+        FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const float v = simd_sum(sumf[c][row]);
+            if (sgitg == 1 && tiisg == 0) part[c * NR0 + row] = v;
+            sumf[c][row] = v;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sgitg == 0 && tiisg == 0) FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            if (r0 + row >= args.ne01) continue;
+            float tot = (sumf[c][row] + part[c * NR0 + row]) + 0.0f;
+            if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
+            ((device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u))[r0 + row] = tot;
+        }
+        return;
+    }
+#endif
+    FOR_UNROLL (short c = 0; c < KC; ++c) {
+        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float * dc = (device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u);
+        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+    }
+}
