+// logit stored at dst[ids[i]]; every other logit keeps what the host put there (-inf, written once). The same lanes, block stride and
+// reduction as llms_q4l_mv_impl<4, false> (each row's sum is independent of its threadgroup's other rows: bit-equal logits on V'). ----
+[[host_name("kernel_llms_q4l_mv_ix")]]
+kernel void kernel_llms_q4l_mv_ix(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                  device const int * ids [[buffer(4)]], threadgroup char * shmem [[threadgroup(0)]],
+                                  uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+    constexpr short NR0 = 4;
+    const int K = args.ne00, nb = K / 32, n = args.ne01;
+    const int i0 = tgpig.x * NR0;
+    device const float * y = (device const float *) src1;
+    device const uint * wq[NR0]; device const half * ws[NR0]; int rid[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        rid[row] = ids[min(i0 + row, n - 1)];
+        device const char * rp = src0 + (ulong)rid[row] * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[NR0] = { 0.f };
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        const float4 ya = *((device const float4 *) (y + ib * 32 + il * 8));
+        const float4 yb = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[row] += llms_q4l_dot8(wq[row][ib * 4 + il], ya, yb) * (float) ws[row][ib];
+        }
+    }
+    threadgroup float * sh = (threadgroup float *) shmem;
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        if (sgitg == 0) sh[32 * row + tiisg] = 0.0f;
+        sumf[row] = simd_sum(sumf[row]);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    FOR_UNROLL (short row = 0; row < NR0; ++row) { if (tiisg == 0) sh[32 * row + sgitg] = sumf[row]; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (short row = 0; row < NR0 && i0 + row < n; ++row) {
+        const float tot = simd_sum(sh[32 * row + tiisg]);
+        if (tiisg == 0 && sgitg == 0) ((device float *) dst)[rid[row]] = tot;
+    }
+}
