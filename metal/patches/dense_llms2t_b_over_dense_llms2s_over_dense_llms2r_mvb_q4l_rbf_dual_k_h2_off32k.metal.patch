+kernel void kernel_llms_q4l_mv_kg##KCOL(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst, \
+        threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { \
+    llms_q4l_mv_kg_impl<4, KCOL>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
+LLMS_Q4KG(2)
+LLMS_Q4KG(3)
+LLMS_Q4KG(4)
+#undef LLMS_Q4KG
