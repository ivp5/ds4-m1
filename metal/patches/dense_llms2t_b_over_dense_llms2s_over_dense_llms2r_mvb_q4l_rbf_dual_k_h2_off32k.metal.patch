+    float sumf[KC][NR0];
+    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        float4 ya[KC], yb[KC];
+        FOR_UNROLL (short c = 0; c < KC; ++c) {
+            device const half * y = (device const half *) (src1 + (ulong)gz * args.nb11 + (ulong)c * args.nb12);   /* llms KGX: x as half [row][group][K] */
+            ya[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8)));
+            yb[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8 + 4)));
+        }
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const uint w = wq[row][ib * 4 + il];
+            const float sc = (float) ws[row][ib];
+            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            FOR_UNROLL (short c = 0; c < KC; ++c) {
+                const float4 a = ya[c], b = yb[c];
+                half2 p = h0 * half2((half)a.x, (half)b.x);
+                p = fma(h1, half2((half)a.y, (half)b.y), p);
+                p = fma(h2, half2((half)a.z, (half)b.z), p);
+                p = fma(h3, half2((half)a.w, (half)b.w), p);
+                sumf[c][row] += ((float)p.x + (float)p.y) * sc;
+            }
+        }
+    }
+#ifndef LLMS_Q4L_LEAN2_OFF
+    if (LEAN && NSG == 2) {
+        threadgroup float * part = (threadgroup float *) shmem;
+        FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const float v = simd_sum(sumf[c][row]);
+            if (sgitg == 1 && tiisg == 0) part[c * NR0 + row] = v;
+            sumf[c][row] = v;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sgitg == 0 && tiisg == 0) FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            if (r0 + row >= args.ne01) continue;
+            float tot = (sumf[c][row] + part[c * NR0 + row]) + 0.0f;
+            if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
+            ((device float *) (dst + (ulong)c * args.nb13) + (ulong)gz * args.ne01)[r0 + row] = tot;
+        }
+        return;
+    }
+#endif
+    FOR_UNROLL (short c = 0; c < KC; ++c) {
+        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float * dc = (device float *) (dst + (ulong)c * args.nb13) + (ulong)gz * args.ne01;
+        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+    }
+}
+[[host_name("kernel_llms_q4l_mv_kgxh2")]]
+kernel void kernel_llms_q4l_mv_kgxh2(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+    threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    llms_q4l_mv_kgxh_impl<4, 2, true>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
+[[host_name("kernel_llms_q4l_mv_kgxh3")]]
+kernel void kernel_llms_q4l_mv_kgxh3(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+    threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    llms_q4l_mv_kgxh_impl<4, 3, true>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); }
+
+
+// kernel_llms_hc_pre_fused_rows's mixer code (threadgroups 0-23) with its runtime loop structure (the flat-norm partials are written for any
+// thread count; the 8-simdgroup dot runs as virtual simdgroups vs = sgitg, sgitg + 2, ...); the last of a row's 24 writes the mix and runs
+// llms_k2s_split_row (K2SPLIT's exact split) ----
+struct llms_k2m_args { uint ga, gb, nm, rows; int iters; float eps; int n; float rms_eps; int ntg; };
+static inline void llms_k2m_mix_tg(constant llms_k2m_args & p, device const float * hin, device const half * fn, device float * mixo, device atomic_uint * scr,
+        device const float * scale, device const float * base, device float * split, threadgroup float * shm, uint t, ushort tiisg, ushort sgitg) {
+    /* v2 (make_mixdual2.py): threadgroup t = (row, output j, quarter q); simdgroup s is the HC kernel's virtual simdgroup vs = 2 q + s of its dot.
+       scr per row (256 words): [0, 192) the partials sr[j][vs], [192, 216) the outputs, [216, 240) the per-output counts, 255 the row count */
+    const uint row = t / 96u, jq = t % 96u, j = jq / 4u, q = jq % 4u;
+    const int n = p.n; const int vs = 2 * (int)q + (int)sgitg;
+    device const float4 * x4 = (device const float4 *) (hin + (ulong)row * (ulong)n);
+    device atomic_uint * sr_row = scr + 256u * row;
+    threadgroup uint * flag = (threadgroup uint *) shm;
+    const float sc = mixo[24ul * row];   /* parked by kernel_llms_hc_pre_fused_rows_xs: the flat-norm scale of this row's stream */
+    const short ix = tiisg/2, il = tiisg%2;
+    const int nb = n/32;
+    device const half4 * w4 = (device const half4 *) (fn + (ulong)j * (ulong)n);
+    float sr = 0.0f;
+    for (int ib = vs*16 + ix; ib < nb; ib += 8*16) {
+        const int b4 = (ib*32 + il*16)/4;
+        float4 yl4[4];
+        for (short i = 0; i < 4; ++i) yl4[i] = as_type<float4>(as_type<uint4>(x4[b4 + i]*sc));
+        float sumq = 0.f;
+        FOR_UNROLL (short i = 0; i < 4; ++i) sumq += dot(float4(w4[b4 + i]), float4(yl4[i]));
+        sr += sumq;
+    }
+    sr = simd_sum(sr);
+    if (tiisg == 0) atomic_store_explicit(&sr_row[8u * j + (uint)vs], as_type<uint>(sr), memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
+    if (sgitg == 0 && tiisg == 0) { const uint old = atomic_fetch_add_explicit(&sr_row[216u + j], 1u, memory_order_relaxed); flag[0] = old == 3u ? 1u : 0u; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (flag[0] == 0u || sgitg != 0) return;
+    /* the last of output j's four: the original's tot = simd_sum(red2[tiisg]) with red2 = the 8 partials and zeros */
+    const float v = tiisg < 8 ? as_type<float>(atomic_load_explicit(&sr_row[8u * j + tiisg], memory_order_relaxed)) : 0.0f;
+    const float tot = simd_sum(v);
+    if (tiisg != 0) return;
+    atomic_store_explicit(&sr_row[216u + j], 0u, memory_order_relaxed);
+    atomic_store_explicit(&sr_row[192u + j], as_type<uint>(tot), memory_order_relaxed);
+    const uint oldr = atomic_fetch_add_explicit(&sr_row[255u], 1u, memory_order_relaxed);
+    if (oldr != 23u) return;
+    atomic_store_explicit(&sr_row[255u], 0u, memory_order_relaxed);
+    device float * mrow = mixo + 24ul * row;
+    for (int k = 0; k < 24; ++k) mrow[k] = as_type<float>(atomic_load_explicit(&sr_row[192u + (uint)k], memory_order_relaxed));
+    llms_k2s_split_row(mrow, scale, base, split + 24ul * row, p.iters, p.eps);
+}
+#define LLMS_K2M(VAR, IMPL) \
+[[host_name("kernel_llms_q4l_mv_k2_r4_" #VAR "_d2m")]] \
+kernel void kernel_llms_q4l_mv_k2_r4_##VAR##_d2m(constant ds4_metal_args_mul_mv & aa [[buffer(0)]], device const char * wa [[buffer(1)]], device const char * src1 [[buffer(2)]], \
+        device char * da [[buffer(3)]], constant ds4_metal_args_mul_mv & ab [[buffer(4)]], device const char * wb [[buffer(5)]], device char * db [[buffer(6)]], \
+        constant llms_k2m_args & p [[buffer(7)]], device const float * hin [[buffer(8)]], device const half * fn [[buffer(9)]], device float * mixo [[buffer(10)]], \
+        device atomic_uint * scr [[buffer(11)]], device const float * scale [[buffer(12)]], device const float * base [[buffer(13)]], device float * split [[buffer(14)]], \
+        threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]], \
+        ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { \
+    if (tgpig.x < p.nm) { llms_k2m_mix_tg(p, hin, fn, mixo, scr, scale, base, split, (threadgroup float *) shmem, tgpig.x, tiisg, sgitg); return; } \
+    const uint t = tgpig.x - p.nm; \
+    if (t < p.ga) { IMPL<4, 2, true>(aa, wa, src1, da, shmem, uint3(t, tgpig.y, tgpig.z), tiisg, sgitg); return; } \
+    IMPL<4, 2, true>(ab, wb, src1, db, shmem, uint3(t - p.ga, tgpig.y, tgpig.z), tiisg, sgitg); }
+LLMS_K2M(bxh, llms_q4l_mv_kxh_impl)
+#undef LLMS_K2M
+
+
+template<short NR0, short KC, bool RB>
+static inline void llms_q4l_mv_kxh1_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                      threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg & 0xFF; const bool LEAN = (FC_mul_mv_nsg & 0x100) != 0;   /* llms Q4L_LEAN2: the flag rides the NSG constant */
+    const int K = args.ne00, nb = K / 32;
+    const int r0 = tgpig.x * NR0;
+    device const uint * wq[NR0]; device const half * ws[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int r = min(r0 + row, args.ne01 - 1);
+        device const char * rp = src0 + (ulong)r * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[KC][NR0];
+    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        float4 ya[KC], yb[KC];
+        FOR_UNROLL (short c = 0; c < KC; ++c) {
+            device const half * y = (device const half *) src1 + (ulong)c * (ulong)args.ne00;   /* x as half: the f32->f16 copy's row stride = ne00 halves (apply_hx.py) */
+            ya[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8)));
+            yb[c] = float4(*((device const half4 *) (y + ib * 32 + il * 8 + 4)));
+        }
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const uint w = wq[row][ib * 4 + il];
+            const float sc = (float) ws[row][ib];
+            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            FOR_UNROLL (short c = 0; c < KC; ++c) {
+                const float4 a = ya[c], b = yb[c];
+                half2 p = h0 * half2((half)a.x, (half)b.x);
+                p = fma(h1, half2((half)a.y, (half)b.y), p);
+                p = fma(h2, half2((half)a.z, (half)b.z), p);
+                p = fma(h3, half2((half)a.w, (half)b.w), p);
+                sumf[c][row] += ((float)p.x + (float)p.y) * sc;
+            }
+        }
+    }
+    if (NSG == 1 && RB) {   /* llms Q4L_N1X: one simdgroup holds the whole sum -- the direct epilogue (the generic one's second sum only adds zeros) */
+        FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const float tot = simd_sum(sumf[c][row]) + 0.0f;
+            if (tiisg == 0 && r0 + row < args.ne01) {
+                uint bits = as_type<uint>(tot);
+                if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u));
+                ((device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u))[r0 + row] = as_type<float>(bits & 0xffff0000u);
+            }
+        }
+        return;
+    }
+#ifndef LLMS_Q4L_LEAN2_OFF
+    if (LEAN && NSG == 2) {
+        threadgroup float * part = (threadgroup float *) shmem;
+        FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const float v = simd_sum(sumf[c][row]);
+            if (sgitg == 1 && tiisg == 0) part[c * NR0 + row] = v;
+            sumf[c][row] = v;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sgitg == 0 && tiisg == 0) FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            if (r0 + row >= args.ne01) continue;
+            float tot = (sumf[c][row] + part[c * NR0 + row]) + 0.0f;
+            if (RB) { uint bits = as_type<uint>(tot); if ((bits & 0x7f800000u) != 0x7f800000u) bits += LLMS_MVB16_CANARY ? 0u : (0x7fffu + ((bits >> 16u) & 1u)); tot = as_type<float>(bits & 0xffff0000u); }
+            ((device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u))[r0 + row] = tot;
+        }
+        return;
+    }
+#endif
+    FOR_UNROLL (short c = 0; c < KC; ++c) {
+        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float * dc = (device float *) (dst + (ulong)c * (ulong)args.ne01 * 4u);
+        if (RB) llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+        else    helper_mv_reduce_and_write<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+    }
+}
