+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (b + 1 < b1) { wn = wq[(b + 1) * 4 + wl]; scn = (float)ws[b + 1]; for (int j = 0; j < NT; j++) { const int i = tid + 256 * j, c = i >> 5, k = i & 31; xn[j] = c < C ? x[(ulong)c * (ulong)a.xs + (b + 1) * 32 + k] : 0.f; } }
