+// threadgroup z (weights src0 + g * nb02, input src1 + g * nb11, output dst + g * ne01 floats), row c's input at + c * nb12 bytes and its
+// output at + c * nb13 bytes; the bf16 store (the low projection is rounded before attn_output_b reads it). ----
+template<short NR0, short KC>
+static inline void llms_q4l_mv_kg_impl(constant ds4_metal_args_mul_mv & args, device const char * src0, device const char * src1, device char * dst,
+                                       threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+    const int K = args.ne00, nb = K / 32, g = (int)tgpig.z;
+    const int r0 = tgpig.x * NR0;
+    device const char * wg = src0 + (ulong)g * args.nb02;
+    device const uint * wq[NR0]; device const half * ws[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int r = min(r0 + row, args.ne01 - 1);
+        device const char * rp = wg + (ulong)r * args.nb01;
+        wq[row] = (device const uint *) rp; ws[row] = (device const half *) (rp + K / 2);
+    }
+    float sumf[KC][NR0];
+    FOR_UNROLL (short c = 0; c < KC; ++c) FOR_UNROLL (short row = 0; row < NR0; ++row) sumf[c][row] = 0.f;
+    const short ix = tiisg / 4, il = tiisg % 4;
+    for (int ib = sgitg * 8 + ix; ib < nb; ib += NSG * 8) {
+        float4 ya[KC], yb[KC];
+        FOR_UNROLL (short c = 0; c < KC; ++c) {
+            device const float * y = (device const float *) (src1 + (ulong)g * args.nb11 + (ulong)c * args.nb12);
+            ya[c] = *((device const float4 *) (y + ib * 32 + il * 8));
+            yb[c] = *((device const float4 *) (y + ib * 32 + il * 8 + 4));
+        }
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const uint w = wq[row][ib * 4 + il];
+            const float sc = (float) ws[row][ib];
+            const half2 h0 = as_type<half2>(( w        & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h1 = as_type<half2>(((w >>  4) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h2 = as_type<half2>(((w >>  8) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            const half2 h3 = as_type<half2>(((w >> 12) & 0x000F000Fu) | 0x64006400u) - half2(1032.0h);
+            FOR_UNROLL (short c = 0; c < KC; ++c) {
+                const float4 a = ya[c], b = yb[c];
+                const float d8 = ((float)h0.x * a.x + (float)h1.x * a.y) + ((float)h2.x * a.z + (float)h3.x * a.w)
+                               + ((float)h0.y * b.x + (float)h1.y * b.y) + ((float)h2.y * b.z + (float)h3.y * b.w);
+                sumf[c][row] += d8 * sc;
+            }
+        }
+    }
+    FOR_UNROLL (short c = 0; c < KC; ++c) {
+        if (c) threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float * dc = (device float *) (dst + (ulong)c * args.nb13) + (ulong)g * args.ne01;
+        llms_mv_reduce_and_write_b<NR0>(dc, sumf[c], r0, args.ne01, tiisg, sgitg, shmem);
+    }
+}
