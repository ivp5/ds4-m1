+          for (int j = 0; j < 4; j++) { o[2 * j] = (half)(((float)(int)((wn >> (8 * j)) & 15u) - 8.f) * scn); o[2 * j + 1] = (half)(((float)(int)((wn >> (8 * j + 4)) & 15u) - 8.f) * scn); } }
