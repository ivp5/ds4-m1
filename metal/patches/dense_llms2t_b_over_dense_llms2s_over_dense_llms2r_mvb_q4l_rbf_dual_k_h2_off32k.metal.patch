+        device coherent(device) float * part, device atomic_uint * cnt, threadgroup float * sh, uint3 tg, ushort tid, ushort sg) {
+    const int K = a.K, nb = K / 32, r0 = (int)tg.x * 64, C = a.C, S = a.S, s = (int)tg.y, g = (int)tg.z; const ulong rowb = (ulong)K / 2 + (ulong)nb * 2;
