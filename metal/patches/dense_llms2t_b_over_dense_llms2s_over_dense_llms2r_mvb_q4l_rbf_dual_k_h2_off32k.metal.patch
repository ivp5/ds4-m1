+kernel void kernel_llms_q4l_mv_k2_r4_bxh_d2(constant ds4_metal_args_mul_mv & aa [[buffer(0)]], device const char * wa [[buffer(1)]], device const char * src1 [[buffer(2)]],
+        device char * da [[buffer(3)]], constant ds4_metal_args_mul_mv & ab [[buffer(4)]], device const char * wb [[buffer(5)]], device char * db [[buffer(6)]],
+        constant uint * gp [[buffer(7)]], threadgroup char * shmem [[threadgroup(0)]], uint3 tgpig [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    if (tgpig.x < gp[0]) { llms_q4l_mv_kxh_impl<4, 2, true>(aa, wa, src1, da, shmem, tgpig, tiisg, sgitg); return; }
+    llms_q4l_mv_kxh_impl<4, 2, true>(ab, wb, src1, db, shmem, uint3(tgpig.x - gp[0], tgpig.y, tgpig.z), tiisg, sgitg);
