+kernel void kernel_llms_q2k_down_t8p_f32(constant ds4_metal_args_mul_mv_id & args, device const uint64_t * addrs, device const char * src1, device char * parts,
+                                         device const char * ids, device const uint * entries [[buffer(5)]], uint3 tgpig[[threadgroup_position_in_grid]],
+                                         ushort tiisg[[thread_index_in_simdgroup]], ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    threadgroup half As[32 * 32];          // [row 32][k 32]
+    threadgroup half Bs[32 * 8];           // [k 32][token 8]
+    threadgroup float Cs[4 * 64];          // [simdgroup][row 8][token 8]
+    device const uint * en = entries + 8u * tgpig.z;
+    const uint pn0 = en[0];
+    const int32_t expert = ((device const int32_t *)(ids + (uint64_t)(pn0 / (uint)args.nei0) * args.nbi1))[pn0 % (uint)args.nei0];
+    if (expert < 0 || expert >= args.ne02 || expert >= 384) return;
+    const uint64_t addr = addrs[(uint)expert];
+    if (addr == 0) return;
+    const int first_row = tgpig.x * 32;
+    const ushort tid = sgitg * 32 + tiisg;
+    const int dr = tid >> 2, dq = tid & 3;           // decode: row dr (0..31), weights 8 dq .. 8 dq + 7 of the K-block
+    const int st = tid >> 4, sk = (tid & 15) * 2;    // stage: token st (0..7), mids sk, sk + 1 of the K-block
+    device const uchar * xr = reinterpret_cast<device const uchar *>(addr) + (uint64_t)(first_row + dr) * args.nb01;
+    const uint pns = en[st]; const bool pad = pns == 0xFFFFFFFFu;   /* llms DOWN_T8 pad (make_moe_dt8b.py): an empty slot stages zeros */
+    device const float * ym = (device const float *)(src1 + (pad ? 0ull : (uint64_t)(pns / (uint)args.nei0) * args.nb12 + (uint64_t)(pns % (uint)args.nei0) * args.nb11));
+    simdgroup_float8x8 C = make_filled_simdgroup_matrix<float, 8>(0.f);
+    for (int kb = 0; kb < 72; kb++) {            // 2,304 / 32 K-blocks
+        const int ib = kb >> 3, w = (kb & 7) * 32 + 8 * dq;
+        device const uchar * blk = xr + ib * 84;
+        const int iq = w >> 7, J = (w & 127) >> 5, l0 = w & 31;
+        const uint2 qq = *(device const packed_uint2 *)(blk + 16 + 32 * iq + l0);
+        const uchar sc = blk[8 * iq + 2 * J + (l0 >> 4)];
+        const float d = (float)as_type<half>(*(device const ushort *)(blk + 80)), dmin = (float)as_type<half>(*(device const ushort *)(blk + 82));
+        const float dl = d * (float)(sc & 15), ml = dmin * (float)(sc >> 4);
+        const uint sh = 2u * (uint)J;
+        half4 w0, w1;
+        for (int j2 = 0; j2 < 4; j2++) { w0[j2] = (half)(dl * (float)((qq.x >> (8 * j2 + sh)) & 3u) - ml); w1[j2] = (half)(dl * (float)((qq.y >> (8 * j2 + sh)) & 3u) - ml); }
