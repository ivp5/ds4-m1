+#define LLMS_BS6C_ROWB 1520u
+kernel void kernel_llms_bs6c_xplanes(device const float * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
+                                     constant uint4 & p [[buffer(3)]], uint2 gid [[thread_position_in_grid]]) {
+    /* p.x = tokens, p.y = token stride in floats, p.z = planes (NPL); one thread per (sub-block gid.x < 160, token gid.y) */
+    if (gid.x >= 160u || gid.y >= p.x) return;
+    device const float * xr = src1 + (uint64_t)gid.y * p.y + 32u * gid.x;
+    float v[32]; float a = 0.f;
+    for (int i = 0; i < 32; i++) { v[i] = xr[i]; a = max(a, fabs(v[i])); }
+    const float qmax = float((1u << (p.z - 1u)) - 1u);
+    const float sc = a > 0.f ? a / qmax : 1.f;
+    uint pl[8] = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}; int sum = 0;
+    const uint msk = (1u << p.z) - 1u;
+    for (int i = 0; i < 32; i++) {
+        const int q = (int)rint(v[i] / sc); sum += q;
+        const uint u = (uint)q & msk;
+        for (uint b = 0; b < p.z; b++) pl[b] |= ((u >> b) & 1u) << (uint)i;
+    }
+    device uint * o = XP + ((uint64_t)gid.y * 160u + gid.x) * 8u;
+    for (int b = 0; b < 8; b++) o[b] = pl[b];
+    XS[(uint64_t)gid.y * 160u + gid.x] = float2(sc, sc * (float)sum);
+}
+template <int K, typename ET, int NPL, bool CANARY>
+static inline void llms_bs6c_impl(constant ds4_metal_args_mul_mv_id & args, constant ds4_metal_dsv4_moe_swiglu_weight_args & act,
+        device const uint64_t * gate_addrs, device const uint64_t * up_addrs, device char * dst_gate, device char * dst_up, device char * dst_mid,
+        device const char * ids, device const char * weights, device const ET * entries, device const uint * XP, device const float2 * XS,
+        threadgroup char * shmem, uint3 tgpig, ushort tiisg, ushort sgitg) {
