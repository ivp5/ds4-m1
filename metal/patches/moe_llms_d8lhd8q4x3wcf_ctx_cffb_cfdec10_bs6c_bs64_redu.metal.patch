+    if (gate_addr == 0 || up_addr == 0) return;
+    device const half *yhA = src1h + ((idxA % args.ne11) * args.nb11 + (uint64_t)iid1A * args.nb12) / sizeof(float);
+    device const half *yhB = src1h + ((idxB % args.ne11) * args.nb11 + (uint64_t)iid1B * args.nb12) / sizeof(float);
+    device char *dgA = dst_gate + (idxA * args.ne0 + iid1A * args.ne1 * args.ne0) * sizeof(float);
+    device char *duA = dst_up   + (idxA * args.ne0 + iid1A * args.ne1 * args.ne0) * sizeof(float);
+    device char *dgB = dst_gate + (idxB * args.ne0 + iid1B * args.ne1 * args.ne0) * sizeof(float);
+    device char *duB = dst_up   + (idxB * args.ne0 + iid1B * args.ne1 * args.ne0) * sizeof(float);
+    ds4_metal_args_mul_mv args0 = {
+        args.ne00, args.ne01, 1,
+        args.nb00, args.nb01, args.nb02, args.nb02,
+        args.ne10, 1, 1,
+        args.nb10, args.nb11, args.nb12, args.nb12,
+        args.ne0, 1, args.nr0, 1, 1,
+    };
