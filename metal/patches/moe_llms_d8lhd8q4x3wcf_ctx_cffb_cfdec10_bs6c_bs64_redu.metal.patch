+kernel void kernel_llms_bs64_xplanes(device const float * src1 [[buffer(0)]], device uint * XP [[buffer(1)]], device float2 * XS [[buffer(2)]],
+                                     constant uint4 & p [[buffer(3)]], uint2 gid [[thread_position_in_grid]]) {
+    /* p.x = tokens, p.y = token stride in floats, p.z = planes (NPL); one thread per (sub-block gid.x < 160, token gid.y) */
+    if (gid.x >= 160u || gid.y >= p.x) return;
