+                    const uint4 llms_gu = ((threadgroup const uint4 *)sgrid)[gidu] ^ (llms_keep ? ((threadgroup const uint4 *)smask)[sidu] : uint4(0u));
+                    g0 = as_type<half4>(llms_gg.xy); g1 = as_type<half4>(llms_gg.zw); u0 = as_type<half4>(llms_gu.xy); u1 = as_type<half4>(llms_gu.zw);
+                } else {
+                    g0 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidg])     ^ smask[2 * sidg]);
+                    g1 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidg + 1]) ^ smask[2 * sidg + 1]);
+                    u0 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidu])     ^ smask[2 * sidu]);
+                    u1 = as_type<half4>(as_type<ushort4>(sgrid[2 * gidu + 1]) ^ smask[2 * sidu + 1]);
+                }
+                sgA += (float)(dot(yA[2 * l], g0) + dot(yA[2 * l + 1], g1));
+                suA += (float)(dot(yA[2 * l], u0) + dot(yA[2 * l + 1], u1));
+                if (two) {
+                    sgB += (float)(dot(yB[2 * l], g0) + dot(yB[2 * l + 1], g1));
+                    suB += (float)(dot(yB[2 * l], u0) + dot(yB[2 * l + 1], u1));
+                }
+            }
+            sumgA[row] += dg * sgA; sumuA[row] += du * suA;
+            if (two) { sumgB[row] += dg * sgB; sumuB[row] += du * suB; }
+            dhg += rstride; dhu += rstride; qg += rstride; qu += rstride;
+        }
+        yA4 += 8 * 32; yB4 += 8 * 32;
+    }
+    device float * gA = (device float *) dst_gateA; device float * uA = (device float *) dst_upA;
+    device float * gB = (device float *) dst_gateB; device float * uB = (device float *) dst_upB;
+    for (int row = 0; row < nr0 && first_row + row < args.ne0; ++row) {
+        const float sga = simd_sum(sumgA[row]), sua = simd_sum(sumuA[row]);
+        float sgb = 0.f, sub = 0.f;
+        if (two) { sgb = simd_sum(sumgB[row]); sub = simd_sum(sumuB[row]); }
+        if (tiisg == 0) {
+            gA[first_row + row] = sga * 0.25f; uA[first_row + row] = sua * 0.25f;
+            if (two) { gB[first_row + row] = sgb * 0.25f; uB[first_row + row] = sub * 0.25f; }
+        }
+    }
